
let {...} = import("../dfa");

export class Lua(
  public buf: ListBuilder<String>,
) {
  public static fromTable(table: Table): String {
    let r = new Lua(new ListBuilder<String>());
    r.addTable(table);
    return r.buf.join("", fn(s: String): String { s });
  }

  public addString(string: String): Void {
    buf.add(string);
  }

  // Each row is a function from a code point to the next row's index.
  public addRow(row: Row): Void {
    let id = row.name.id.toString();
    addString("rows[${id}] = function(code)\n");
    for (var i = 0; i < row.keys.length; i++) {
      let key = row.keys[i];
      let target = row.map[key] orelse panic();
      if (i == 0) {
        addString("  if ");
      } else {
        addString("  elseif ");
      }
      addString("code == ${key} then return ${target.id}\n");
    }
    if (row.keys.length != 0) {
      addString("  end\n");
    }
    addString("  return ${row.other.id}\n");
    addString("end\n");
    if (row.ok) {
      addString("ok[${id}] = true\n");
    }
  }

  // A loop rather than calls between rows, so long matches can't overflow
  // the stack.
  public addTable(table: Table): Void {
    addString("local utf8_codepoint = utf8.codepoint\n");
    addString("local utf8_offset = utf8.offset\n");
    addString("local rows = {}\n");
    addString("local ok = {}\n");
    for (var i = 0; i < table.rows.length; i++) {
      addRow(table.rows[i]);
    }
    addString("return function(str, head)\n");
    addString("  local row = 0\n");
    addString("  while not ok[row] do\n");
    addString("    if head > #str then return -1 end\n");
    addString("    local code = utf8_codepoint(str, head)\n");
    addString("    head = utf8_offset(str, 2, head)\n");
    addString("    row = rows[row](code)\n");
    addString("  end\n");
    addString("  return head\n");
    addString("end\n");
  }
}
