
let {...} = import("../../nfa/state");
let {...} = import("../../nfa/matcher");
let {...} = import("../../nfa/engine");
let {...} = import("../../util");

export class Target(@noProperty arg: Listed<Int>) {
  public name: Listed<Int> = arg.sorted(fn(x: Int, y: Int): Int { return x - y; });
  public var id: Int = -1;

  public eq(other: Target): Boolean {
    if (other.name.length != name.length) {
      return false;
    }
    for (var i = 0; i < name.length; i++) {
      if (other.name[i] != name[i]) {
        return false;
      }
    }
    return true;
  }

  public toString(): String {
    if (name.length == 0) {
      return "<error>";
    }
    let body = name.join(",", fn(x: Int): String {
      return "v${x.toString()}";
    });
    return "{${body}}"
  }

  public has(id: Int): Boolean {
    for (var i = 0; i < name.length; i++) {
      if (name[i] == id) {
        return true;
      }
    }
    return false;
  }

  public and(other: Int): Target {
    let r = new ListBuilder<Int>();
    for (var j = 0; j < name.length; j++) {
      let exist = name[j];
      if (exist != other) {
        r.add(exist);
      }
    }
    r.add(other);
    return new Target(r);
  }

  public ands(other: Target): Target {
    var ret = new Target(this.name);
    for (var i = 0; i < other.name.length; i++) {
      ret = ret.and(other.name[i]);
    }
    return ret;
  }
}

let noTarget = new Target([]);

export class Row(
  public name: Target,
  public other: Target,
  public keys: Listed<Int>,
  public map: Mapped<Int, Target>,
  public ok: Boolean,
) {
  public toString(): String {
    let nameStr = name.toString();
    let mapStr = keys.join("", fn(key: Int) {
      let keyStr = if (32 <= key && key <= 126) {
        "#${chr(key)}"
      } else {
        key.toString()
      };
      let valueStr = (map[key] orelse panic()).toString();
      return "\n  ${keyStr} => ${valueStr}";
    });
    let elseStr = "\n  else => ${other.toString()}"
    return "${nameStr}:${mapStr}${elseStr}";
  }
}

let noRow = new Row(noTarget, noTarget, [], new Map<Int, Target>([]), false);

export class Table(
  public rows: ListBuilder<Row>,
  @noProperty targets: Listed<Target>,
) {
  public get targets(): Listed<Target> { targetsVar };
  private var targetsVar: Listed<Target> = targets;

  private update(t: Target): Void {
    if (t.name.length == 0) {
      t.id = -1;
      return;
    }
    for (var j = 0; j < targets.length; j++) {
      if (targets[j].eq(t)) {
        t.id = j;
        return;
      }
    }
    // TODO Does this actually represent an error on our part?
    panic();
  }

  public finish(): Void {
    let build = new ListBuilder<Target>();
    targetsVar = build;
    outer: for (var i = 0; i < rows.length; i++) {
      let row = rows[i];
      for (var j = 0; j < build.length; j++) {
        if (build[j].eq(row.name)) {
          row.name.id = j;
          continue outer;
        }
      }
      row.name.id = i;
      build.add(row.name);
    }
    for (var i = 0; i < rows.length; i++) {
      let row = rows[i];
      update(row.other);
      outer: for (var j = 0; j < row.keys.length; j++) {
        let key = row.keys[j];
        let cur = row.map[key] orelse panic();
        update(cur);
      }
    }
  }

  public has(name: Target): Boolean {
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].name.eq(name)) {
        return true;
      }
    }
    return false;
  }

  public add(row: Row): Void {
    if (!has(row.name)) {
      rows.add(row);
    }
  }

  public addEmpty(name: Target): Void {
    add(new Row(name, noTarget, [], new Map<Int, Target>([]), false));
  }

  public toString(): String {
    return rows.join("\n", fn(s: Row): String {
      return s.toString();
    })
  }

  /** The end of the longest match starting at `head`. */
  public foundAt(str: String, var head: StringIndex): StringIndexOption {
    var found: StringIndexOption = StringIndex.none;
    var cur = rows.getOr(0, noRow);
    while (true) {
      if (cur.ok) {
        found = head;
      }
      if (!str.hasIndex(head)) {
        break;
      }
      let next = cur.map.getOr(str[head], cur.other);
      if (next.id < 0) {
        break;
      }
      cur = rows.getOr(next.id, noRow);
      head = str.next(head);
    }
    found
  }

  /** Whether some match starts at `head`, stopping at the first accept. */
  public matchesAt(str: String, var head: StringIndex): Boolean {
    var cur = rows.getOr(0, noRow);
    while (!cur.ok) {
      if (!str.hasIndex(head)) {
        return false;
      }
      let next = cur.map.getOr(str[head], cur.other);
      if (next.id < 0) {
        return false;
      }
      cur = rows.getOr(next.id, noRow);
      head = str.next(head);
    }
    true
  }

  /** The first position at or after `head` where a match starts. */
  public firstStart(str: String, var head: StringIndex): StringIndexOption {
    while (!matchesAt(str, head)) {
      if (!str.hasIndex(head)) {
        return StringIndex.none;
      }
      head = str.next(head);
    }
    head
  }
}

class Alphabet {
  public keys: ListBuilder<Int> = new ListBuilder<Int>();
  public map: MapBuilder<Int, Boolean> = new MapBuilder<Int, Boolean>();

  public add(key: Int): Void {
    if (!map.getOr(key, false)) {
      keys.add(key);
      map[key] = true;
    }
  }

  public static fromEngine(engine: Engine): Alphabet {
    let ret = new Alphabet();
    for (var i = 0; i < engine.states.length; i++) {
      let state = engine.states[i];
      for (var j = 0; j < state.next.length; j++) {
        let {matcher} = state.next[j];
        when (matcher) {
          is ContainsMatcher -> do {
            for (var k = 0; k < matcher.options.length; k++) {
              ret.add(matcher.options[k]);
            }
          }
          is SingleMatcher -> do {
            ret.add(matcher.char);
          }
          else -> do {}
        }
      }
    }
    return ret;
  }
}

let noTable = new Table(new ListBuilder<Row>(), []);

// Group markers don't consume anything, and a DFA has no groups to track, so
// they're as empty as epsilon here.
let isEmptyEdge(matcher: Matcher): Boolean {
  matcher is EpsilonMatcher || matcher is StartGroupMatcher || matcher is EndGroupMatcher
}

/** `target` plus `state` and every state reachable from it by empty edges. */
let epsilonClosure(state: State, target: Target): Target {
  if (target.has(state.id)) {
    return target;
  }
  var ret = target.and(state.id);
  for (var j = 0; j < state.next.length; j++) {
    let { toState, matcher } = state.next[j];
    if (isEmptyEdge(matcher)) {
      ret = epsilonClosure(toState, ret);
    }
  }
  ret
}

export class DFA(
  public table: Table,
) {
  public static none(): DFA {
    return new DFA(noTable);
  }

  public static fromEngine(engine: Engine): DFA? {
    let alphabet = Alphabet.fromEngine(engine);

    let states = new MapBuilder<Int, State>();
    for (var i = 0; i < engine.states.length; i++) {
      let state = engine.states[i];
      states[state.id] = state;
    }

    let newTable: Table = new Table(new ListBuilder<Row>(), []);
    newTable.addEmpty(epsilonClosure(engine.startState, noTarget));

    var ok = true;

    for (var i = 0; i < newTable.rows.length; i++) {
      let row = newTable.rows[i];

      var other = new Target([]);
      let keys = new ListBuilder<Int>();
      let map = new MapBuilder<Int, Target>();

      let done = new MapBuilder<Int, Boolean>();

      // Both add toState and its empty-edge closure, stopping at states
      // already added so cycles end.
      let addOther(toState: State): Void {
        if (other.has(toState.id)) {
          return;
        }
        other = other.and(toState.id);
        for (var j = 0; j < toState.next.length; j++) {
          let {toState as dest, matcher} = toState.next[j];
          if (isEmptyEdge(matcher)) {
            addOther(dest);
          } else if (matcher is WordBoundaryMatcher || matcher is BeginMatcher || matcher is EndMatcher) {
            ok = false;
          }
        }
      }

      let add(char: Int, toState: State): Void {
        let existing = map.getOr(char, noTarget);
        if (existing.has(toState.id)) {
          return;
        }
        if (!map.has(char)) {
          keys.add(char);
        }
        map[char] = existing.and(toState.id);
        for (var j = 0; j < toState.next.length; j++) {
          let {toState as dest, matcher} = toState.next[j];
          if (isEmptyEdge(matcher)) {
            add(char, dest);
          } else if (matcher is WordBoundaryMatcher || matcher is BeginMatcher || matcher is EndMatcher) {
            ok = false;
          }
        }
      }

      let onState(state: State): Void {
        if (done.getOr(state.id, false)) {
          return;
        }
        done[state.id] = true;
        for (var j = 0; j < state.next.length; j++) {
          let {toState, matcher} = state.next[j];
          when (matcher) {
            // actual chars
            is ContainsMatcher -> do {
              if (matcher.want) {
                for (var k = 0; k < matcher.options.length; k++) {
                  add(matcher.options[k], toState);
                }
              } else {
                for (var k = 0; k < alphabet.keys.length; k++) {
                  let chr = alphabet.keys[k];
                  if (!matcher.bitset[chr]) {
                    add(chr, toState);
                  } else {
                    if (!map.has(chr)) {
                      map[chr] = new Target([]);
                      keys.add(chr);
                    }
                  }
                }
                addOther(toState);
              }
            }
            is SingleMatcher -> do {
              add(matcher.char, toState);
            }
            // bad for DFA things
            is WordBoundaryMatcher, is BeginMatcher, is EndMatcher -> do {
              ok = false;
            }
            // epsilon & group markers
            else -> do {
              onState(toState);
            }
          }
        }
        done[state.id] = false;
      }

      for (var j = 0; j < row.name.name.length; j++) {
        onState(states[row.name.name[j]] orelse panic());
      }

      if (other.name.length != 0) {
        newTable.addEmpty(other);
      }

      for (var i = 0; i < keys.length; i++) {
        let key = keys[i];
        let val = map[key] orelse panic();
        newTable.addEmpty(val);
      }

      newTable.rows[i] = new Row(
        row.name,
        other,
        keys,
        map,
        row.name.name.getOr(0, -1) == 1
        || row.name.name.getOr(1, -1) == 1
      );
    }

    newTable.finish();

    if (!ok) {
      return null
    } else {
      return new DFA(newTable);
    }
  }

  public found(s: String, start: StringIndex): StringIndexOption {
    return table.foundAt(s, start);
  }
}
