
let {...} = import("./dfa.temper");

export class Javascript {
  public buf: ListBuilder<String>;

  public static fromTable(table: Table): String {
    let r = new Javascript(new ListBuilder<String>());
    r.addTable(table);
    return r.buf.join("", fn(s: String): String { s });
  }

  public addString(string: String): Void {
    buf.add(string);
  }

  public addTarget(target: Target): Void {
    if (target.id < 0) {
      bubble();
    } else {
      addString("q");
      addString(target.id.toString());
    }
  }

  public addRow(row: Row): Void {
    addString("const ");
    addTarget(row.name);
    addString(" = ");
    addString("(str, head) => {\n");
    if (row.ok) {
      addString("  return head;\n")
    } else {
      if (row.keys.length != 0) {
        addString("  switch (str.codePointAt(head)) {\n");
        for (var i = 0; i < row.keys.length; i++) {
          let key = row.keys[i];
          addString("  case ");
          addString(key.toString());
          addString(":\n");
          if (row.map[key].id < 0) {
            addString("    return -1;\n");
          } else {
            addString("    return ");
            addTarget(row.map[key]);
            addString("(str, head + 1);\n");
          }
        }
        addString("  default:\n")
        if (row.other.id < 0) {
          addString("    return -1;\n");
        } else {
          addString("    return ");
          addTarget(row.other);
          addString("(str, head + 1);\n");
        }
        addString("  }\n")
      } else {
        if (row.other.id < 0) {
          addString("  return -1;\n");
        } else {
          addString("  return ");
          addTarget(row.other);
          addString("(str, head + 1);\n");
        }
      }
    }
    addString("};\n");
  }

  public addTable(table: Table): Void {
    for (var i = 0; i < table.rows.length; i++) {
      if (table.rows[i].name.id >= 0) {
        addRow(table.rows[i]);
      }
    }
    addString("module.ret = (str, start) => {\n");
    addString("  const len = str.length;\n");
    addString("  for (let i = start; i < len; i++) {\n");
    addString("    const start = q0(str, i);\n");
    addString("    if (start !== -1) {\n");
    addString("      return start;\n");
    addString("    }\n");
    addString("  }\n");
    addString("  return -1;\n");
    addString("};\n");
  };
}
