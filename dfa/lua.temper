
let {...} = import("./dfa.temper");

export class Lua {
  public buf: ListBuilder<String>;

  public static fromTable(table: Table): String {
    let r = new Lua(new ListBuilder<String>());
    r.addTable(table);
    return r.buf.join("", fn(s: String): String { s });
  }

  public addString(string: String): Void {
    buf.add(string);
  }

  public addTarget(target: Target): Void {
    if (target.id < 0) {
      bubble();
    } else {
      addString("q");
      addString(target.id.toString());
    }
  }

  public addRow(row: Row): Void {
    addTarget(row.name);
    addString(" = function");
    addString("(str, head)\n");
    if (row.ok) {
      addString("  return true\n");
    } else {
      addString("  local char = str:byte(head)\n");
      for (var i = 0; i < row.keys.length; i++) {
        let key = row.keys[i];
        if (i == 0) {
          addString("  if ")
        } else {
          addString("  elseif ")
        }
        addString("char == ");
        addString(key.toString());
        addString(" then\n");
        if (row.map[key].id < 0) {
          addString("    return false\n");
        } else {
          addString("    return ");
          addTarget(row.map[key]);
          addString("(str, head + 1)\n");
        }
      }
      if (row.keys.length != 0) {
        addString("  else\n")
        if (row.other.id < 0) {
          addString("    return false\n");
        } else {
          addString("    return ");
          addTarget(row.other);
          addString("(str, head + 1)\n");
        }
        addString("  end\n")
      } else {
        if (row.other.id < 0) {
          addString("  return false\n");
        } else {
          addString("  return ");
          addTarget(row.other);
          addString("(str, head + 1)\n");
        }
      }
    }
    addString("end\n");
  }

  public addTable(table: Table): Void {
    for (var i = 0; i < table.rows.length; i++) {
      addString("local ")
      addTarget(table.rows[i].name);
      addString("\n")
    }
    for (var i = 0; i < table.rows.length; i++) {
      addRow(table.rows[i]);
    }
    addString("return function(str)\n");
    addString("  for i=1, #str do\n");
    addString("    if q1(str, i) then\n");
    addString("      return true\n");
    addString("    end\n");
    addString("  end\n");
    addString("  return false\n");
    addString("end\n");
  }
}
