
let {...} = import("../nfa/state.temper");
let {...} = import("../nfa/matcher.temper");
let {...} = import("../nfa/engine.temper");

export class Target {
  public name: Listed<Int>;
  public var id: Int;

  public constructor(arg: Listed<Int>): Void {
    name = arg.sorted(fn(x: Int, y: Int): Int { return x - y; });
    id = -1;
  }

  public eq(other: Target): Boolean {
    if (other.name.length != name.length) {
      return false;
    }
    for (var i = 0; i < name.length; i++) {
      if (other.name[i] != name[i]) {
        return false;
      }
    }
    return true;
  }

  public toString(): String {
    if (name.length == 0) {
      return "<error>";
    }
    let pre = if (id < 0) {
      ""
    } else {
      "[${id.toString()}]";
    }
    let body = name.join(",", fn(x: Int): String {
      return "v${x.toString()}";
    });
    return "{${body}}"
  }

  public and(other: Int): Target {
    let r = new ListBuilder<Int>();
    for (var j = 0; j < name.length; j++) {
      let exist = name[j];
      if (exist != other) {
        r.add(exist);
      }
    }
    r.add(other);
    return new Target(r);
  }
}

let noTarget = new Target([]);

export class Row {
  public name: Target;
  public other: Target;
  public keys: Listed<Int>;
  public map: Mapped<Int, Target>;
  public ok: Boolean;

  public toString(): String {
    let nameStr = name.toString();
    let mapStr = keys.join("", fn(key: Int) {
      let keyStr = if (32 <= key && key <= 126) {
        "#${String.fromCodePoint(key)}"
      } else {
        key.toString()
      };
      let valueStr = map[key].toString();
      return "\n  ${keyStr} => ${valueStr}";
    });
    let elseStr = "\n  else => ${other.toString()}"
    return "${nameStr}:${mapStr}${elseStr}";
  }
}

let noRow = new Row(noTarget, noTarget, [], new Map<Int, Target>([]), false);

export class Table {
  public rows: ListBuilder<Row>;

  public targets: Listed<Target> = [];

  let update(t: Target): Void {
    if (t.name.length == 0) {
      t.id = -1;
      return;
    }
    for (var j = 0; j < targets.length; j++) {
      if (targets[j].eq(t)) {
        t.id = j;
        return;
      }
    }
    bubble();
  }

  public finish(): Void {
    let build = new ListBuilder<Target>();
    targets = build;
    outer: for (var i = 0; i < rows.length; i++) {
      let row = rows[i];
      for (var j = 0; j < build.length; j++) {
        if (build[j].eq(row.name)) {
          row.name.id = j;
          continue outer;
        }
      }
      row.name.id = i;
      build.add(row.name);
    }
    for (var i = 0; i < rows.length; i++) {
      let row = rows[i];
      update(row.other);
      outer: for (var j = 0; j < row.keys.length; j++) {
        let key = row.keys[j];
        let cur = row.map[key];
        update(cur);
      }
    }
  }

  public has(name: Target): Boolean {
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].name.eq(name)) {
        return true;
      }
    }
    return false;
  }

  public add(row: Row): Void {
    if (!has(row.name)) {
      rows.add(row);
    }
  }

  public addEmpty(name: Target): Void {
    add(new Row(name, noTarget, [], new Map<Int, Target>([]), false));
  }

  public toString(): String {
    return rows.join("\n", fn(s: Row): String {
      return s.toString();
    })
  }

  public find(name: Target): Row {
    for (var i = 0; i < rows.length; i++) {
      let row = rows[i];
      if (row.name.eq(name)) {
        return row;
      }
    }
    bubble();
  }

  public foundAt(str: String, start: StringIndex): StringIndexOption {
    let stop = str.end;
    var head = start;
    var target = 0;
    inner: while (true) {
      var cur = rows.getOr(target, noRow);
      if (cur.ok) {
        return head;
      }
      var char = str.codeAt(head);
      while (true) {
        let c = if (char >= 128) { 128 } else { 0 };
        let next = cur.map.getOr((char & 127) + c, cur.other);
        if (next.id < 0 || head == stop) {
          break inner;
        }
        target = next.id;
        head = str.next(head);
        if (c == 0) {
          break;
        }
        char = char / 128;
        cur = rows.getOr(target, noRow);
        if (cur.ok) {
          return head;
        }
      }
    }
    return StringIndex.none;
  }

  public found(str: String, start: StringIndex): StringIndexOption {
    let stop = str.end;
    while (start != stop) {
      var head = start;
      var target = 0;
      inner: while (true) {
        var cur = rows.getOr(target, noRow);
        if (cur.ok) {
          return head;
        }
        var char = str.codeAt(head);
        while (true) {
          let c = if (char >= 128) { 128 } else { 0 };
          let next = cur.map.getOr((char & 127) + c, cur.other);
          if (next.id < 0 || head == stop) {
            break inner;
          }
          target = next.id;
          head = str.next(head);
          if (c == 0) {
            break;
          }
          char = char / 128;
          cur = rows.getOr(target, noRow);
          if (cur.ok) {
            return head;
          }
        }
      }
      start = str.next(start);
    }
    return StringIndex.none;
  }
}

let noTable = new Table(new ListBuilder<Row>(), []);

export class DFA {
  public table: Table;

  public static none(): DFA {
    return new DFA(noTable);
  }

  public static fromEngine(engine: Engine): DFA | Null {
    let states = new MapBuilder<Int, State>();
    for (var i = 0; i < engine.states.length; i++) {
      let state = engine.states[i];
      states[state.id] = state;
    }
    
    let table = new Table(new ListBuilder<Row>(), []);
    table.addEmpty(new Target([0]));

    var ok = true;
    
    for (var i = 0; i < table.rows.length; i++) {
      let row = table.rows[i];

      var other = new Target([]);
      let keys = new ListBuilder<Int>();
      let map = new MapBuilder<Int, Target>();

      let done = new MapBuilder<Int, Boolean>();

      let addOther(toState: State): Void {
        for (var j = 0; j < toState.next.length; j++) {
          let {toState, matcher} = toState.next[j];
          match (matcher) {
            is EpsilonMatcher -> do {
              addOther(toState);
            }
            is StartGroupMatcher,
            is EndGroupMatcher,
            is WordBoundaryMatcher,
            is BeginMatcher,
            is EndMatcher -> do {
              ok = false;
            }
            else -> do {}
          }
        }
        other = other.and(toState.id);
      }

      let add(char: Int, toState: State): Void {
        for (var j = 0; j < toState.next.length; j++) {
          let {toState, matcher} = toState.next[j];
          match (matcher) {
            is EpsilonMatcher -> do {
              add(char, toState);
            }
            is StartGroupMatcher,
            is EndGroupMatcher,
            is WordBoundaryMatcher,
            is BeginMatcher,
            is EndMatcher -> do {
              ok = false;
            }
            else -> do {}
          }
        }
        if (!map.has(char)) {
          keys.add(char);
          map[char] = new Target([toState.id]);
        } else {
          map[char] = map[char].and(toState.id);
        }
      }

      let onState(state: State): Void {
        if (done.getOr(state.id, false)) {
          return;
        }
        done[state.id] = true;
        for (var j = 0; j < state.next.length; j++) {
          let {toState, matcher} = state.next[j];
          match (matcher) {
            // actual chars
            is ContainsMatcher -> do {
              for (var k = 0; k < 256; k++) {
                if (matcher.bitset[k] == matcher.want) {
                  add(k, toState);
                }
              }
            }
            is SingleMatcher -> do {
              add(matcher.char, toState);
            }
            // epsilon & named epsilon
            is EpsilonMatcher -> do {
              onState(toState);
            }
            // bad for DFA things
            else -> do {
              ok = false;
            }
          }
        }
        done[state.id] = false;
      }

      for (var j = 0; j < row.name.name.length; j++) {
        onState(states[row.name.name[j]]);
      }

      if (other.name.length != 0) {
        table.addEmpty(other);
      }

      for (var i = 0; i < keys.length; i++) {
        let key = keys[i];
        let val = map[key];
        table.addEmpty(val);
      }

      table.rows[i] = new Row(
        row.name,
        other,
        keys,
        map,
        row.name.name.getOr(0, -1) == 1
        || row.name.name.getOr(1, -1) == 1
      );
    }

    table.finish();

    if (!ok) {
      return null
    } else {
      return new DFA(table);
    }
  }

  public found(s: String, start: StringIndex): StringIndexOption {
    return table.foundAt(s, start);
  } 
}
