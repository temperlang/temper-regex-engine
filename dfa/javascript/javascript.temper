
let {...} = import("../dfa");

export class Javascript(
  public buf: ListBuilder<String>,
) {
  public static fromTable(table: Table): String {
    let r = new Javascript(new ListBuilder<String>());
    r.addTable(table);
    return r.buf.join("", fn(s: String): String { s });
  }

  public addString(string: String): Void {
    buf.add(string);
  }

  // Each row is a function from a code point to the next row's index.
  public addRow(row: Row): Void {
    let id = row.name.id.toString();
    addString("rows[${id}] = (code) => {\n");
    if (row.keys.length != 0) {
      addString("  switch (code) {\n");
      for (var i = 0; i < row.keys.length; i++) {
        let key = row.keys[i];
        let target = row.map[key] orelse panic();
        addString("  case ${key}: return ${target.id};\n");
      }
      addString("  }\n");
    }
    addString("  return ${row.other.id};\n");
    addString("};\n");
    if (row.ok) {
      addString("ok[${id}] = true;\n");
    }
  }

  // A loop rather than calls between rows, so long matches can't overflow
  // the stack.
  public addTable(table: Table): Void {
    addString("const rows = [];\n");
    addString("const ok = [];\n");
    for (var i = 0; i < table.rows.length; i++) {
      addRow(table.rows[i]);
    }
    addString("module.ret = (str, head) => {\n");
    addString("  let row = 0;\n");
    addString("  while (!ok[row]) {\n");
    addString("    if (head >= str.length) return -1;\n");
    addString("    const code = str.codePointAt(head);\n");
    // Code points above U+FFFF take two UTF-16 units.
    addString("    head += code > 0xffff ? 2 : 1;\n");
    addString("    row = rows[row](code);\n");
    addString("  }\n");
    addString("  return head;\n");
    addString("};\n");
  }
}
