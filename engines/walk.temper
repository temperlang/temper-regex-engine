
let { ... } = import("std/regex");
let { TemperRegex } = import("../regex.temper");
let { chr } = import("../util.temper");
let { wordChars } = import("../ctype.temper");

export class Matcher {
  public str: String;
  public head: StringIndex;
  public depth: Int;
  public var groups: MapBuilder<String, Group>;

  constructor(src: String): Void {
    str = src;
    head = String.start;
    depth = 0;
    groups = new MapBuilder<String, Group>();
  }

  public advance(): Void {
    head = str.next(head);
  }

  public setHead(val: StringIndex): Void {
    head = val;
  }

  public matchCapture(regex: Capture): Boolean {
    var begin = head;
    if (matchRegex(regex.item)) {
      var end = head;
      var list = new ListBuilder<Int>();
      for (var i = begin; i < end; i = str.next(i)) {
        list.add(str.codeAt(i));
      }
      var text = String.fromCodePoints(list);
      groups[regex.name] = new Group(regex.name, text, begin);
      return true;
    } else {
      setHead(begin);
      return false;
    }
  }

  public matchCodePoints(regex: CodePoints): Boolean {
    if (depth == 0) {
      let value = regex.value;
      let init = head;
      var sHead = String.start;
      while (true) {
        let c = value.codeAt(sHead);
        if (c == 0) {
          return true;
        }
        if (str.codeAt(head) != c) {
          setHead(init);
          return false;
        }
        head = str.next(head);
        sHead = value.next(sHead);
      }
    } else {
      let value = regex.value;
      var sHead = String.start;
      while (true) {
        let c = value.codeAt(sHead);
        if (c == 0) {
          head = str.next(head);
          return true;
        }
        if (str.codeAt(head) != c) {
          return false;
        }
        sHead = value.next(sHead);
      }
    }
  }

  public matchDot(): Boolean {
    return if (str.hasIndex(head)) {
      advance();
      true
    } else {
      false
    }
  }

  public matchDigit(): Boolean {
    if (str.hasIndex(head)) {
      return false;
    }
    var code = str.codeAt(head);
    return if (char'0' <= code && code <= char'9') {
      advance();
      true
    } else {
      false
    }
  }

  public matchWord(): Boolean {
    if (wordChars[str.codeAt(head)]) {
      advance();
      return true;
    } else {
      return false;
    }
  }

  public matchWordBoundary(): Boolean {
    let last = str.prev(head);
    return wordChars[str.codeAt(last)]
        != wordChars[str.codeAt(head)];
  }

  public matchSpecial(regex: Special): Boolean {
    if (regex == Begin) {
      return head.compareTo(String.start) == 0;
    } else if (regex == Dot) { 
      return matchDot();
    } else if (regex == End) {
      if (str.hasIndex(head)) {
        return false;
      } else {
        return true;
      }
    } else if (regex == WordBoundary) { 
      return matchWordBoundary();
    } else if (regex == Digit) {
      return matchDigit();
    } else if(regex == Space) {
      let c = str.codeAt(head);
      return c == char' '
          || c == char'\t'
          || c == char'\r'
          || c == char'\n';
    } else if (regex == Word) {
      return matchWord();
    } else {
      return false;
    }
  }

  public matchCodeRange(regex: CodeRange): Boolean {
    var n = str.codeAt(head);
    if (n == 0) {
      return false;
    }
    if (regex.min <= n && n <= regex.max) {
      advance();
      return true;
    } else {
      return false;
    }
  }

  public matchCodeSet(regex: CodeSet): Boolean {
    var begin = head;
    if (regex.negated) {
      for (var i = 0; i < regex.items.length; i++) {
        depth += 1;
        var res = matchRegex(regex.items[i]);
        depth -= 1;
        if (res) {
          return false
        }
        setHead(begin);
      }
      advance();
      return true;
    } else {
      for (var i = 0; i < regex.items.length; i++) {
        depth += 1;
        var res = matchRegex(regex.items[i]);
        depth -= 1;
        if (res) {
          return true;
        }
        setHead(begin);
      }
      return false;
    }
  }

  public matchOr(regex: Or): Boolean {
    var start = head;
    for (var i = 0; i < regex.items.length; i++) {
      if (matchRegex(regex.items[i])) {
        return true;
      }
    }
    setHead(start);
    return false;
  }

  public matchRepeat(regex: Repeat): Boolean {
    var start = head;
    for (var i = 0; i < regex.min; i++) {
      if (!matchRegex(regex.item)) {
        setHead(start);
        return false;
      }
    }
    if (regex.max == null) {
      while (true) {
        var mid = head;
        if (!matchRegex(regex.item)) {
          setHead(mid);
          return true;
        }
      }
    } else {
      var maxNoNull = regex.max.as<Int>();
      for (var i = regex.min; i < maxNoNull; i++) {
        var mid = head;
        if (!matchRegex(regex.item)) {
          setHead(mid);
          return true;
        }
      }
      return true;
    }
  }

  public matchSequence(regex: Sequence): Boolean {
    var start = head;
    for (var i = 0; i < regex.items.length; i++) {
      if (!matchRegex(regex.items[i])) {
        setHead(start);
        return false;
      }
    }
    return true;
  }

  public matchRegex(regex: RegexNode): Boolean {
    match (regex) {
      is Capture -> matchCapture(regex);
      is CodePoints -> matchCodePoints(regex);
      is CodeRange -> matchCodeRange(regex);
      is CodeSet -> matchCodeSet(regex);
      is Or -> matchOr(regex);
      is Repeat -> matchRepeat(regex);
      is Sequence -> matchSequence(regex);
      is Special -> matchSpecial(regex);
      else -> false;
    }
  }

  public resetGroups(regex: RegexNode): Void {
    groups = new MapBuilder<String, Group>();
  }
}

export class TemperRegexWalker extends TemperRegex {
  public data: RegexNode;

  public constructor(re: RegexNode) {
    data = re;
  }

  public split(text: String): Listed<String> {
    var cur = new ListBuilder<Int>();
    let ret = new ListBuilder<String>();
    var i = String.start;
    while (text.hasIndex(i)) {
      var m = new Matcher(text);
      m.setHead(i);
      if (m.matchRegex(data)) {
        i = m.head;
        ret.add(cur.join("", chr));
        cur = new ListBuilder<Int>();
      } else {
        cur.add(text.codeAt(i));
        i = text.next(i);
      }
    }
    ret.add(cur.join("", chr));
    return ret.toList();
  }

  public found(text: String): Boolean {
    for (var i = String.start; text.hasIndex(i); i = text.next(i)) {
      var m = new Matcher(text);
      m.setHead(i);
      m.resetGroups(data);
      if (m.matchRegex(data)) {
        return true;
      }
    }
    return false;
  }
  
  public find(text: String): Mapped<String, Group> {
    for (var i = String.start; text.hasIndex(i); i = text.next(i)) {
      var m = new Matcher(text);
      m.setHead(i);
      m.resetGroups(data);
      if (m.matchRegex(data)) {
        if (!m.groups.has("full")) {
          let full = new ListBuilder<Int>();
          while (i.compareTo(m.head) != 0) {
            full.add(text.codeAt(i));
            i = text.next(i);
          }
          m.groups["full"] = new Group("full", full.join("", chr), i);
        }
        return m.groups;
      }
    }
    return new Map<String, Group>([]);
  }
}
