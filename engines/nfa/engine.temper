
let { ... } = import("std/regex");
let { State, Next } = import("./state.temper");
let { Stack, StackStart, StackSlot } = import("./stack.temper");
let { ord, chr, idString, slice } = import("../../util.temper");
let { ... } = import("./matcher.temper");

let group(str: String, name: String, value: String, start: StringIndex): Group {
  return new Group(name, value, start);
}

let skip(s: String, c: StringIndex, i: Int): StringIndex {
  while (i > 0) {
    c = s.next(c);
    i -= 1;
  }
  return c;
}

export class Engine {
  public states: ListBuilder<State>;
  public startState: State;
  public endState: State;
  public epsilon: EpsilonMatcher;
  // public baseGroups: MapBuilder<String, Group>;

  public constructor() {
    states = new ListBuilder<State>();
    startState = newState();
    endState = newState();
    epsilon = new EpsilonMatcher();
    // baseGroups = new MapBuilder<String, Group>();
  }

  public opt(): Engine {
    var cur = this;
    // cur = cur.optEpsilonEllison();
    // cur = cur.optDeadCode();
    return cur;
  }

  public optDeadCode(): Engine {
    var unopt = this;
    var opt = new Engine();
    // opt.baseGroups = unopt.baseGroups;
    var map = new MapBuilder<Int, Int>();

    let visit(state: State): State {
      var optId = map[state.id] orelse -1;
      if (optId >= 0) {
        return opt.states[optId];
      }
      var outState: State = if (state == unopt.startState) {
        opt.startState
      } else if (state == unopt.endState) {
        opt.endState
      } else {
        opt.newState()
      };

      map[state.id] = outState.id;

      for (var i = 0; i < state.next.length; i++) {
        var next = state.next[i];
        outState.addNext(next.matcher, visit(next.toState));
      }
      return outState;
    }

    visit(startState);

    return opt;
  }

  public optEpsilonEllison(): Engine {
    var unopt = this;
    var opt = new Engine();
    // opt.baseGroups = unopt.baseGroups;
    var map = new MapBuilder<Int, Int>();

    let visit(state: State): State {
      var optId = map[state.id] orelse -1;
      if (optId >= 0) {
        return opt.states[optId];
      }
      var outState: State = if (state == unopt.startState) {
        opt.startState
      } else if (state == unopt.endState) {
        opt.endState
      } else {
        opt.newState()
      };

      map[state.id] = outState.id;

      var added = new DenseBitVector(0);
      var count = 0;

      var isFinal = false;

      let add(matcher: Matcher, toState: State): Void {
        if (matcher == unopt.epsilon) {
          if (added[toState.id]) {
            return;
          }
          added[toState.id] = true;
          if (toState.id == 1) {
            isFinal = true;
            return;
          }
          for (var i = 0; i < toState.next.length; i++) {
            var next = toState.next[i];
            add(next.matcher, next.toState);
          }
        } else {
          count += 1;
          outState.addNext(matcher, visit(toState));
        }
      }

      for (var i = 0; i < state.next.length; i++) {
        var next = state.next[i];
        add(next.matcher, next.toState);
      }

      map.remove(state.id);

      if (count == 0 || isFinal) {
        return opt.endState;
      }

      return outState;
    }

    visit(startState);

    return opt;
  }

  public newState(): State {
    var ret = new State(states.length);
    states.add(ret);
    // console.log("new ${ret.id.toString()}");
    return ret;
  }

  public replace(str: String, replace: fn(Mapped<String, Group>): String): String {
    let pairs = new MapBuilder<String, Pair<StringIndex, StringIndex>>();
    let pending = new MapBuilder<String, StringIndex>();
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    var last = String.start;
    let ret = new ListBuilder<String>();
    for (var i = String.start; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart, []);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        var sgroups = stack.groups;
        stack = stack.next;
        if (state.id == endState.id) {
          let cur = new ListBuilder<Int>();
          for (var j = last; j.compareTo(i) < 0; j = str.next(j)) {
            cur.add(str.codeAt(i));
          }
          ret.add(cur.join("", chr));
          
          // let groups = baseGroups.toMapBuilder();
          let groups = new MapBuilder<String, Group>();
          if (!groups.has("full")) {
            let full = new ListBuilder<Int>();
            for (var j = i; j.compareTo(index) < 0; j = str.next(j)) {
              full.add(str.codeAt(j));
            }
            groups["full"] = group(str, "full", full.join("", chr), i);
          }
          let keys = pairs.keys;
          for (var i = 0; i < keys.length; i++) {
            let key = keys[i];
            let val = pairs[key];
            let res = new ListBuilder<Int>();
            for (var j = val.key; j.compareTo(val.value) < 0; j = str.next(j)) {
              res.add(str.codeAt(j));
            }
            for (var s = 0; s < sgroups.length; s++) {
              if (key == sgroups.getOr(s, "")) {
                groups[key] = group(str, key, res.join("", chr), val.key);
              }
            }
          }
          ret.add(replace(groups));

          i = str.prev(index);
          last = index;
          break;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.length != 0) {
            match (matcher) {
              is StartGroupMatcher -> do {
                pending[matcher.name] = index;
                stack = new StackSlot(skip.getOr(0, index), toState, stack, sgroups);
              }
              is EndGroupMatcher -> do {
                pairs[matcher.name] = new Pair(pending[matcher.name], index);
                let next = new ListBuilder<String>();
                next.add(matcher.name);
                next.addAll(sgroups);
                stack = new StackSlot(skip.getOr(0, index), toState, stack, next);
              }
              else -> do {
                stack = new StackSlot(skip.getOr(0, index), toState, stack, sgroups);
              }
            }
          }
        }
      }
    }
    let cur = new ListBuilder<Int>();
    for (var j = last; str.hasIndex(j); j = str.next(j)) {
      // cur.add(codePoints.getOr(j, 0));
      cur.add(str.codeAt(j));
    }
    ret.add(cur.join("", chr));
    return ret.join("", idString);
  }

  public split(str: String): Listed<String> {
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    var last = String.start;
    let ret = new ListBuilder<String>();
    for (var i = String.start; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          let cur = new ListBuilder<Int>();
          for (var j = last; j.compareTo(i) < 0; j = str.next(j)) {
            cur.add(str.codeAt(j));
          }
          i = str.prev(index);
          last = index;
          ret.add(cur.join("", chr));
          break;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.length != 0) {
            stack = new StackSlot(skip.getOr(0, index), toState, stack);
          }
        }
      }
    }
    let cur = new ListBuilder<Int>();
    for (var j = last; str.hasIndex(j); j = str.next(j)) {
      cur.add(str.codeAt(j));
    }
    ret.add(cur.join("", chr));
    return ret;
  }

  public found(str: String, start: StringIndex): StringIndexOption {
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = String.start; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          return index;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.length != 0) {
            stack = new StackSlot(skip.getOr(0, index), toState, stack);
          }
        }
      }
    }
    return StringIndex.none;
  }

  public find(str: String): Mapped<String, Group> {
    let pairs = new MapBuilder<String, Pair<StringIndex, StringIndex>>();
    let pending = new MapBuilder<String, StringIndex>();
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = String.start; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        var sgroups = stack.groups;
        stack = stack.next;
        if (state.id == endState.id) {
          let groups = new MapBuilder<String, Group>();
          let keys = pairs.keys;
          for (var i = 0; i < keys.length; i++) {
            let key = keys[i];
            let val = pairs[key];
            let res = new ListBuilder<Int>();
            for (var j = val.key; j.compareTo(val.value) < 0; j = str.next(j)) {
              res.add(str.codeAt(j));
            }
            for (var i = 0; i < sgroups.length; i++) {
              if (sgroups.getOr(i, "") == key) {
                groups[key] = group(str, key, res.join("", chr), val.key);
              }
            }
          }
          if (!groups.has("full")) {
            let full = new ListBuilder<Int>();
            for (var j = i; j.compareTo(i) < 0; j = str.next(j)) {
              full.add(str.codeAt(j));
            }
            groups["full"] = group(str, "full", full.join("", chr), i);
          }
          return groups;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.length != 0) {
            match (matcher) {
              is StartGroupMatcher -> do {
                pending[matcher.name] = index;
                stack = new StackSlot(index, toState, stack, sgroups);
              }
              is EndGroupMatcher -> do {
                pairs[matcher.name] = new Pair(pending[matcher.name], index);
                let next = new ListBuilder<String>();
                next.add(matcher.name);
                next.addAll(sgroups);
                stack = new StackSlot(index, toState, stack, next);
              }
              else -> do {
                stack = new StackSlot(skip.getOr(0, index), toState, stack, sgroups);
              }
            }
          }
        }
      }
    }
    return new Map<String, Group>([]);
  }

  public toString(): String {
    var count = 0;
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        return "\n  ${name} -> q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    })
    return "digraph {\n  rankdir=\"LR\";${inner}\n}";
  }

  public toDotSub(gname: String, color: String): String {
    var count = 0;
    var used = new MapBuilder<Int, Boolean>();
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      used[state.id] = true;
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        used[next.toState.id] = true;
        return "\n    ${gname}_${name} -> ${gname}_q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    });
    var decls = states.join("", fn(state: State): String {
      if (used[state.id] orelse false) {
        var name = "q${state.id.toString()}";
        var label = if (state.id == 0) {
          "start"
        } else if (state.id == 1) {
          "end"
        } else {
          name
        };
        var shape = "ellipse";
        return "\n    ${gname}_${name} [shape=\"${shape}\"] [label=\"${label}\"];";
      } else {
        return "";
      }
    });
    return "subgraph ${gname} {\n    node [style=filled color=\"${color}\"];\n    color=\"#E7E7E7\";\n    label=\"NFA\";\n    rankdir=\"LR\";${decls}${inner}\n  }";
  }
}