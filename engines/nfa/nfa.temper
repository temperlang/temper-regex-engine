
let {...} = import("std/regex");
let { TemperRegex } = import("../../regex.temper");
let { regexToString } = import("../../util.temper");
let { wordCharsList, spaceCharsList } = import("../../ctype.temper");
let { Engine } = import("./engine.temper");
let { State } = import("./state.temper");
let { ... } = import("./matcher.temper");

export class TemperRegexNFA extends TemperRegex {
  public var engine: Engine;
  public fastMatcher: fn(RegexNode): Matcher | Null | Bubble;
  
  public static fromRegex(regex: RegexNode, fastMatcher: fn(RegexNode): Matcher | Null | Bubble): TemperRegexNFA {
    let nfa = new TemperRegexNFA(new Engine(), fastMatcher);
    nfa.buildRegex(regex, nfa.engine.startState, nfa.engine.endState);
    nfa.engine = nfa.engine.optEpsilonEllison();
    return nfa;
  }

  public buildRegex(regex: RegexNode, input: State, output: State): Void | Bubble {
    do {
      let next = fastMatcher(regex);
      match (next) {
        is Matcher -> do {
          input.addNext(next, output);
          // console.log("${next.toString()}");
        }
        null -> do {
          buildRegexBase(regex, input, output);
        }
        else -> bubble();
      }
    } orelse do {
      buildRegexBase(regex, input, output);
    }
  }

  public buildRegexBase(regex: RegexNode, input: State, output: State): Void | Bubble {
    match (regex) {
      is Capture -> do {
        var mid1 = engine.newState();
        var mid2 = engine.newState();
        // engine.baseGroups[regex.name] = new Group(regex.name, "", -1);
        input.addNext(new StartGroupMatcher(regex.name), mid1);
        buildRegex(regex.item, mid1, mid2);
        mid2.addNext(new EndGroupMatcher(regex.name), output);
      }
      is CodePoints -> do {
        var lastState = input;
        var index = String.start;
        while (true) {
          let chr = regex.value.codeAt(index);
          index = regex.value.next(index);
          if (!regex.value.hasIndex(index)) {
            lastState.addNext(charCodeMatcher(chr), output);
            break;
          } else {
            var curState = engine.newState();
            lastState.addNext(charCodeMatcher(chr), curState);
            lastState = curState;
          }
        }
      }
      is CodeSet -> do {
        let ls = new ListBuilder<Int>();
        for (var j = 0; j < regex.items.length; j++) {
          var subRegex = regex.items[j];
          match (subRegex) {
            is CodeRange -> do {
              for (var i = subRegex.min; i <= subRegex.max; i++) {
                ls.add(i);
              }
            }
            is CodePoints -> do {
              var split = subRegex.value.split("");
              for (var i = 0; i < split.length ; i++) {
                ls.add(split[i].codeAt(String.start));
              }
            }
          }
        }
        input.addNext(fromChars(ls, !regex.negated), output);
      }
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          buildRegex(regex.items[i], input, output)
        }
      }
      is Repeat -> do {
        var lastState = input;
        for (var i = 0; i < regex.min; i++) {
          var curState = engine.newState();
          buildRegex(regex.item, lastState, curState);
          lastState = curState;
        }
        if (regex.max != null) {
          var max = regex.max.as<Int>();
          for (var i = regex.min; i < max; i++) {
            var curState = engine.newState();
            if (regex.reluctant) {
              buildRegex(regex.item, lastState, curState);
              lastState.addNext(engine.epsilon, output);
            } else {
              lastState.addNext(engine.epsilon, output);
              buildRegex(regex.item, lastState, curState);
            }
            lastState = curState;
          }
          lastState.addNext(engine.epsilon, output);
        } else {
          if (regex.reluctant) {
            buildRegex(regex.item, lastState, lastState);
            lastState.addNext(engine.epsilon, output);
          } else {
            lastState.addNext(engine.epsilon, output);
            buildRegex(regex.item, lastState, lastState);
          }
        }
      }
      is Sequence -> do {
        var nextState = output; 
        for (var j = regex.items.length - 1; j >= 0; j--) {
          var curState = if (j == 0) {
            input
          } else {
            engine.newState()
          };
          buildRegex(regex.items[j], curState, nextState);
          nextState = curState;
        }
        if (regex.items.length == 0) {
          input.addNext(engine.epsilon, nextState);
        }
      }
      is Special -> do {
        if (regex == Begin) {
          input.addNext(new BeginMatcher(), output);
        } else if (regex == Dot) { 
          input.addNext(fromChars([0], false), output);
        } else if (regex == End) {
          input.addNext(new EndMatcher(), output);
        } else if (regex == WordBoundary) { 
          input.addNext(new WordBoundaryMatcher(), output);
        } else if (regex == Digit) {
          let ls = new ListBuilder<Int>();
          for (var i = char'0'; i <= char'9'; i++) {
            ls.add(i);
          }
          input.addNext(fromChars(ls, true), output);
        } else if(regex == Space) {
          input.addNext(fromChars(spaceCharsList, true), output);
        } else if (regex == Word) {
          input.addNext(fromChars(wordCharsList, true), output);
        } else {
          bubble();
        }
      }
    }
  }

  public replace(text: String, format: fn(Mapped<String, Group>): String): String {
    return engine.replace(text, format);
  }

  public split(text: String): Listed<String> {
    return engine.split(text);
  }

  public found(text: String): Boolean {
    return engine.found(text, String.start) != StringIndex.none;
  }

  public find(text: String): Mapped<String, Group> {
    return engine.find(text);
  }

  public toString(): String {
    return engine.toString();
  }
}
