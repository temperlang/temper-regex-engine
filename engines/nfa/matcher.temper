
let { ord } = import("../../util.temper");

let isCodePointWordChar(code: Int): Boolean {
  return (char'0' <= code && code <= char'9')
    || (char'A' <= code && code <= char'Z') 
    || (char'a' <= code && code <= char'z')
    || code == char'_';
}

export interface Matcher {
  public matches(str: List<Int>, index: Int): Boolean;

  public toString(): String;

  public width(): Int {
    return 1;
  }
}

export class BeginMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    return index == 0;
  }

  public toString(): String {
    return "^";
  }

  public width(): Int {
    return 0;
  }
}

export class EndMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    return index == str.length;
  }

  public toString(): String {
    return "$";
  }

  public width(): Int {
    return 0;
  }
}

export class WordBoundaryMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    let code1 = str.getOr(index-1, -1);
    let code2 = str.getOr(index, -1);
    return isCodePointWordChar(code1) != isCodePointWordChar(code2);
  }
  
  public toString(): String {
    return "\\b";
  }

  public width(): Int {
    return 0;
  }
}

export class WordClassMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return isCodePointWordChar(code);
  }

  public toString(): String {
    return "\\w";
  }
}

export class SpaceClassMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return code == 9 || code == 10 || code == 11 || code == 13 || code == 32;
  }

  public toString(): String {
    return "\\s";
  }
}

export class AnyMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    return index != str.length;
  }

  public toString(): String {
    return ".";
  }
}

export class BitSetMatcher extends Matcher {
  public bitset: DenseBitVector;
  public want: Boolean;

  public matches(str: List<Int>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return bitset[c] == want;
  }

  public toString(): String {
    if (want) {
      return "[^...]";
    } else {
      return "[...]";
    }
  }
}

export class CharCodeMatcher extends Matcher {
  public code: Int;

  public constructor(point: Int): Void {
    code = point;
  }

  public matches(str: List<Int>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return c == code;
  }

  public toString(): String {
    return "#${code.toString()}";
  }
}

export class StartGroupMatcher extends Matcher {
  public name: String;

  public constructor(str: String): Void {
    name = str;
  }

  public matches(str: List<Int>, index: Int): Boolean {
    return true;
  }

  public toString(): String {
    return "<${name}>";
  }

  public width(): Int {
    return 0;
  }
}

export class EndGroupMatcher extends Matcher {
  public name: String;

  public constructor(str: String): Void {
    name = str;
  }

  public matches(str: List<Int>, index: Int): Boolean {
    return true;
  }

  public toString(): String {
    return "</${name}>";
  }

  public width(): Int {
    return 0;
  }
}

export class CharMatcher extends Matcher {
  public char: String;
  public code: Int;
  
  public constructor(str: String): Void {
    char = str;
    code = ord(str);
  }

  public matches(str: List<Int>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return c == code;
  }

  public toString(): String {
    return char;
  }
}

export class EpsilonMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Boolean {
    return true;
  }

  public toString(): String {
    return "ε";
  }

  public width(): Int {
    return 0;
  }
}