
let {...} = import("std/regex");
let {...} = import("../../util/regex");
let {regexToString} = import("../../util/tostring");
let {...} = import("./vec");
let {...} = import("./engine");
let {TransitionTable} = import("./table");
let {TransitionTableEntry} = import("./tableentry");
let {TemperRegexNFA} = import("./nfa");
let {fromVec} = import("./vec");

let isValidFor(next: Matcher, sym: Int): Boolean {
  return validFor(next)[sym];
}

let validFor(next: Matcher): DenseBitVector {
  var valid = new DenseBitVector(0);

  let validPoint(c: Int): Void {
    valid[c] = true;
  }

  let validRange(min: Int, max: Int): Void {
    for (var i = min; i <= max; i++) {
      validPoint(i);
    }
  }

  match (next) {
    is WordClassMatcher -> do {
      validRange(48, 57);
      validRange(65, 90);
      validRange(97, 122);
    }
    is SpaceClassMatcher -> do {
      validPoint(9);
      validPoint(10);
      validPoint(11);
      validPoint(13);
      validPoint(32);
    }
    is RangeMatcher -> do {
      validRange(next.low, next.high);
    }
    is CharMatcher -> do {
      validPoint(next.code);
    }
    is CharCodeMatcher -> do {
      validPoint(next.code);
    }
    is AnyMatcher -> do {}
    is EpsilonMatcher -> do {}
    is WordBoundaryMatcher -> do {
      console.log("WordBoundaryMatcher");
      bubble();
    }
    is EndMatcher -> do {
      console.log("EndMatcher");
      bubble();
    }
    is BeginMatcher -> do {
      console.log("BeginMatcher");
      bubble();
    }
  }
  return valid;
}

let mapToList<T>(map: Map<Int, T>, defaultValue: T): List<T> {
  var ls = map.toList();
  var max = 0;
  for (var i = 0; i < ls.length; i++) {
    var key = ls[i].key;
    if (key > max) {
      max = key;
    }
  }
  var ret = new ListBuilder<T>();
  for (var i = 0; i <= max; i++) {
    ret.add(map[i] orelse defaultValue);
  }
  return ret.toList();
}

var emptyList = [];

export class TemperRegexDFA extends TemperRegex {
  public nsyms: Int;
  public symbols: MapBuilder<Int, Int>;
  public table: TransitionTable;
  public map: List<List<Int>>;
  public rawNfa: Engine;
  public nfa: Engine;

  public get nstates(): Int {
    return nfa.states.length;
  }

  public constructor(regex: Regex): Void {
    nsyms = 0;
    symbols = new MapBuilder<Int, Int>();
    rawNfa = new TemperRegexNFA(regex).engine;
    nfa = rawNfa.opt();
    table = new TransitionTable(nstates);

    for (var i = 0; i < nstates; i++) {
      var state = nfa.states[i];
      for (var j = 0; j < state.next.length; j++) {
        addSymbolsFrom(state.next[j].matcher);
      }
    }

    var pairs = symbols.toList();

    for (var i = 0; i < nstates; i++) {
      var state = nfa.states[i];
      var val = new ListBuilder<DenseBitVector>();
      for (var j = 0; j < nsyms; j++) {
        var cur = new ListBuilder<Int>();
        for (var k = 0; k < state.next.length; k++) {
          var next = state.next[k];
          if (isValidFor(next.matcher, pairs[j].key)) {
            cur.add(next.toState.id);
          }
        }
        val.add(toVec(cur.toList(), nstates));
      }
      var ent = new TransitionTableEntry(toVec([state.id], nstates), val.toList());
      table.table.add(ent);
    }

    for (var i = 0; i < nstates; i++) {
      buildTable(table.table[i], nstates);
    }

    var index = new MapBuilder<String, Int>();
    index[""] = 0;
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var name = nameFor(tent.key);
      if (name == "") {
        continue;
      }
      index[nameFor(tent.key)] = i + 1;
    }

    var mapBuilder = new MapBuilder<Int, List<Int>>();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var subBuilder = new MapBuilder<Int, Int>();
      for (var j = 0; j < nsyms; j++) {
        var value = index[nameFor(tent.val[j])];
        subBuilder[pairs[j].key] = value;
      }
      var ci = index[nameFor(tent.key)];
      mapBuilder[ci] = mapToList(subBuilder.toMap(), 0);
    }
    map = mapToList(mapBuilder.toMap(), []);
  }

  public addCodePoint(c: Int): Void {
    symbols[c] orelse do {
      var newSym = nsyms;
      nsyms += 1;
      symbols[c] = newSym;
    };
  }

  public addCodePointRange(min: Int, max: Int): Void {
    for (var i = min; i <= max; i++) {
      addCodePoint(i);
    }
  }

  public nameFor(vec: DenseBitVector): String {
    return fromVec(vec, nstates).join("|", fn(s: Int): String {
      return s.toString();
    })
  }

  public buildEngine(): Engine {
    var nstates = nfa.states.length;

    var index = new MapBuilder<String, Int>();
    index[""] = -1;
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var name = nameFor(tent.key);
      if (name == "") {
        continue;
      }
      index[nameFor(tent.key)] = i;
    }

    var dfa = new Engine();
    var dfaStates = new ListBuilder<State>();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      if (i == 0) {
        dfaStates.add(dfa.startState);
      } else if (tent.key[1]) {
        dfaStates.add(dfa.endState);
      } else {
        dfaStates.add(dfa.newState());
      }
    }

    var pairs = symbols.toList();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var state = dfaStates[i];
      for (var j = 0; j < nsyms; j++) {
        var value = index[nameFor(tent.val[j])];
        if (value != -1) {
          state.addNext(new CharCodeMatcher(pairs[j].key), dfaStates[value]);
        }
      }
    }
    return dfa.opt();
  }

  let buildTable(tent: TransitionTableEntry, nstates: Int): Void {
    for (var i = 0; i < nsyms; i++) {
      var newKey = tent.val[i];
      if (fromVec(newKey, nstates).length >= 1 && !table.has(newKey)) {
        var allVals = new ListBuilder<DenseBitVector>();
        for (var j = 0; j < nsyms; j++) {
          var newVal = new DenseBitVector(0);
          for (var k = 0; k < nstates; k++) {
            if (newKey[k]) {
              var ent = table[toVec([k], nstates)];
              var bv = table[toVec([k], nstates)].val[j];
              for (var l = 0; l < nstates; l++) {
                if (bv[l]) {
                  newVal[l] = true;
                }
              }
            }
          }
          allVals.add(newVal);
        }
        var ent = new TransitionTableEntry(newKey, allVals.toList());
        table.table.add(ent);
        buildTable(ent, nstates);
      }
    }
  }

  public addSymbolsFrom(next: Matcher): Void {
    match (next) {
      is WordClassMatcher -> do {
        addCodePointRange(48, 57);
        addCodePointRange(65, 90);
        addCodePointRange(97, 122);
      }
      is SpaceClassMatcher -> do {
        addCodePoint(9);
        addCodePoint(10);
        addCodePoint(11);
        addCodePoint(13);
        addCodePoint(32);
      }
      is RangeMatcher -> do {
        addCodePointRange(next.low, next.high);
      }
      is CharCodeMatcher -> do {
        addCodePoint(next.code);
      }
      is CharMatcher -> do {
        addCodePoint(next.code);
      }
      is AnyMatcher -> do {
        addCodePoint(9);
        addCodePoint(10);
        addCodePoint(11);
        addCodePoint(13);
        addCodePoint(32);
        addCodePointRange(32, 126);
      }
      is EpsilonMatcher -> do {}
      is WordBoundaryMatcher -> do {
        console.log("WordBoundaryMatcher");
        bubble();
      }
      is EndMatcher -> do {
        console.log("EndMatcher");
        bubble();
      }
      is BeginMatcher -> do {
        console.log("BeginMatcher");
        bubble();
      }
    }
  }

  public foundAfter(slice: CodePointStringSlice): Boolean {
    var state = 1;
    while (true) {
      if (state == 0) {
        return false
      }
      if (state == 2) {
        return true;
      }
      if (slice.isEmpty) {
        return false;
      }
      state = map.getOr(state, emptyList).getOr(slice.read(), 0);
      slice = slice.advance(1);
    }
  }

  public found(str: String): Boolean {
    var slice = str.codePoints;
    while (true) {
      if (foundAfter(slice)) {
        return true;
      }
      if (slice.isEmpty) {
        return false;
      }
      slice = slice.advance(1);
    }
  }

  public toMarkdownTable(): String {
    return table.toMarkdownWith(symbols);
  }

  public toDot(): String {
    var nfaDot1 = rawNfa.toDotSub("nfa2", "#FFE0FF");
    var nfaDot2 = nfa.toDotSub("nfa1", "#E0E0FF");
    var tableDot = table.toDotWith(symbols, "#E0FFFF");
    var dfaDot = buildEngine().toDotSub("dfa", "#E0FFE0");
    return "digraph {\n  ${nfaDot1}\n  ${nfaDot2}\n  table[shape=none label=<${tableDot}>];\n  ${dfaDot}\n}\n";
  }

  public toLua(chr: fn(Int): String, isMatch: fn(String, String): Boolean): TemperRegexLua {
    let regexToStringChr(r: Regex): String {
      return regexToString(r, chr);
    }
    return new TemperRegexLua(toRegexList(chr).map(regexToStringChr), isMatch);
  }

  public toRegex(chr: fn(Int): String): Regex {
    return new Or(toRegexList(chr));
  }

  public toRegexList(chr: fn(Int): String): List<Regex> {
    var builder = new RegexBuilder();
    var syms = symbols.toList();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var kname = nameFor(tent.key);
      if (kname == "") {
        continue;
      }
      var tmap = new MapBuilder<String, ListBuilder<Int>>();
      for (var j = 0; j < nsyms; j++) {
        var val = nameFor(tent.val[j]);
        var got = tmap[val] orelse new ListBuilder<Int>();
        if (val != "") {
          got.add(syms[j].key);
          tmap[val] = got;
        }
      }
      var ls = tmap.toList();
      if (i == 0) {
        builder.add("#begin", kname, new Sequence([]));
      }
      if (i == 1) {
        builder.add(kname, "#end", new Sequence([]));
      }
      for (var j = 0; j < ls.length; j++) {
        var vals = ls[j].value;
        if (vals.length == 1) {
          var points = new CodePoints(ls[j].value.join("", chr));
          builder.add(kname, ls[j].key, points);
        } else {
          var parts = new ListBuilder<CodePart>();
          var bits = new DenseBitVector(0);
          var max = 0;
          for (var k = 0; k < vals.length; k++) {
            var chr = vals[k];
            if (chr > max) {
              max = chr;
            }
            bits[chr] = true;
          }
          var start = -1;
          for (var k = 0; k <= max; k++) {
            if (bits[k]) {
              var s = k;
              while (bits[k]) {
                k += 1;
              }
              if (k-s <= 2) {
                for (var l = s; l < k; l++) {
                  parts.add(new CodePoints(chr(l)));
                }
              } else {
                parts.add(new CodeRange(s, k-1));
              }
            }
          }
          builder.add(kname, ls[j].key, new CodeSet(parts.toList()));
        }
      }
    }
    return builder.toRegexList();
  } 

  public toRegexString(chr: fn(Int): String): String {
    return regexToString(toRegex(chr), chr);
  }
}

class TemperRegexLua extends TemperRegex {
  public tries: List<String>;
  public check: fn(String, String): Boolean;

  public constructor(strs: List<String>, isMatch: fn(String, String): Boolean): Void {
    tries = strs;
    check = isMatch;
  }

  public found(str: String): Boolean {
    for (var i = 0; i < tries.length; i++) {
      if (check(str, tries[i])) {
        return true;
      }
    }
    return false;
  }
}


let charU(i: Int): String {
  return "\\u{${i.toString()}}";
}

class RegexBuilderEdge {
  public from: String;
  public to: String;
  public regex: Regex;
}

class RegexBuilder {
  public list: ListBuilder<RegexBuilderEdge>;

  constructor(): Void {
    list = new ListBuilder<RegexBuilderEdge>();
  }

  public has(from: String, to: String): Boolean {
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.to == to && edge.from == from) {
        return true;
      }
    }
    return false;
  }

  public find(from: String, to: String): Regex | Bubble {
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.to == to && edge.from == from) {
        return edge.regex;
      }
    }
    return bubble();
  }

  public forEachWentFrom(to: String, cb: fn(RegexBuilderEdge): Void): Void {
    var ls = new ListBuilder<RegexBuilderEdge>();
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.to == to && edge.from != to) {
        ls.add(edge);
      }
    }
    for (var i = 0; i < ls.length; i++) {
      cb(ls[i]);
    }
  }

  public forEachGoesTo(from: String, cb: fn(RegexBuilderEdge): Void): Void {
    var ls = new ListBuilder<RegexBuilderEdge>();
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.from == from && edge.to != from) {
        ls.add(edge);
      }
    }
    for (var i = 0; i < ls.length; i++) {
      cb(ls[i]);
    }
  }

  public simplify(node: String): Void {
    var me = this;
    if (has(node, node)) {
      var self = find(node, node);
      // var r1 = regexToString(self, charU);
      me.forEachWentFrom(node, fn(wentFrom: RegexBuilderEdge): Void {
        // var r0 = regexToString(wentFrom.regex, charU);
        me.forEachGoesTo(node, fn(goesTo: RegexBuilderEdge): Void {
          // var r2 = regexToString(goesTo.regex, charU);
          // if (r1 == r0) {
          //   if (r1 == r2) {
          //     me.add(wentFrom.from, goesTo.to, new Sequence([wentFrom.regex, new Repeat(self, 1, null, false)]));
          //   } else {
          //     me.add(wentFrom.from, goesTo.to, new Sequence([new Repeat(self, 1, null, false), goesTo.regex]));
          //   }
          // } else {
          //   if (r1 == r2) {
          //     me.add(wentFrom.from, goesTo.to, new Sequence([wentFrom.regex, new Repeat(self, 1, null, false)]));
          //   } else {
          me.add(wentFrom.from, goesTo.to, new Sequence([wentFrom.regex, new Repeat(self, 0, null, false), goesTo.regex]));
          //   }
          // }
        });
      });
    } else {
      me.forEachWentFrom(node, fn(wentFrom: RegexBuilderEdge): Void {
        me.forEachGoesTo(node, fn(goesTo: RegexBuilderEdge): Void {
          me.add(wentFrom.from, goesTo.to, new Sequence([wentFrom.regex, goesTo.regex]));
        });
      });
    }
  }

  public add(from: String, to: String, regex: Regex): Void {
    list.add(new RegexBuilderEdge(from, to, regex));
  }

  public dumpInternal(chr: fn(Int): String): String {
    return list.join("\n", fn(cur: RegexBuilderEdge): String {
      return "${cur.from} -> /${regexToString(cur.regex, chr)}/ -> ${cur.to}";
    });
  }

  public toRegexList(): List<Regex> {
    var done = new MapBuilder<String, Boolean>();
    done["#begin"] = true;
    for (var j = 0; j < list.length; j++) {
      var cur = list[j];
      if (!(done[cur.from] orelse false)) {
        done[cur.from] = true;
        simplify(cur.from);
      }
    }
    var ret = new ListBuilder<Regex>();
    for (var j = 0; j < list.length; j++) {
      var cur = list[j];
      if (cur.from == "#begin" && cur.to == "#end") {
        ret.add(cur.regex);
      }
    }
    return ret.toList();
  }
}
