
let { ... } = import("./state.temper");

let noGroups: Listed<String> = [];

export interface Stack {
  public index: StringIndex;
  public state: State;
  public groups: Listed<String> = noGroups;

  public get next(): Stack;
}

export class StackStart extends Stack {
  public index: StringIndex;
  public state: State;
  public groups: Listed<String> = noGroups;

  public constructor(): Void {}
  
  public get next(): Stack {
    return this;
  }
}

export class StackSlot extends Stack {
  public index: StringIndex;
  public state: State;
  public slot: Stack;
  public groups: Listed<String> = noGroups;

  public get next(): Stack {
    return slot;
  }
}
