
let { ... } = import("./state.temper");

export let noGroups: Listed<String> = [];

export interface Stack {
  public index: StringIndex;
  public state: State;
  public groups: Listed<String>;

  public get next(): Stack;
}

export class StackStart(
  public index: StringIndex = String.begin,
  public state: State = new State(0),
  public groups: Listed<String> = [],
) extends Stack {
  public get next(): Stack {
    return this;
  }
}

export class StackSlot(
  public index: StringIndex,
  public state: State,
  public slot: Stack,
  public groups: Listed<String>,
) extends Stack {
  public get next(): Stack {
    return slot;
  }
}
