
let { ... } = import("../state");

/**
 * A capture group on one backtracking path, most recent first. `end` is null
 * while the group is open.
 */
export class Span(
  public name: String,
  public begin: StringIndex,
  public end: StringIndex?,
  public rest: Span?,
) {}

/**
 * One pending path in the backtracking search. `pos` counts code points from
 * where the search started.
 */
export class StackSlot(
  public index: StringIndex,
  public pos: Int,
  public state: State,
  public spans: Span?,
) {}
