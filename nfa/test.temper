
let { ... } = import("std/regex");
let { TemperRegexNFA } = import("./nfa");

test("charset member after charset") {
  // Check out a standard Temper regex.
  let standard = /[12]+1/;
  // The [12]+ part can match until the end, but it shouldn't.
  assert(standard.found("121"));
  // And one specifically from this library.
  let here = TemperRegexNFA.fromRegex(standard.data);
  assert(here.found("121"));
}

test("replace start") {
  let regex = TemperRegexNFA.fromRegex(/^/.data);
  let replaced = regex.replace("a") { (match);; "b" };
  assert(replaced == "ba");
  let commaRegex = /(^|,)\s*/;
  let bulletizeList(text: String): String {
    let replaced = commaRegex.replace(text) { (match);; "\n- " };
    replaced.slice(replaced.next(String.begin), replaced.end)
  }
  let commaRegexNfa = TemperRegexNFA.fromRegex(commaRegex.data);
  let bulletizeListNfa(text: String): String {
    let replaced = commaRegexNfa.replace(text) { (match);; "\n- " };
    replaced.slice(replaced.next(String.begin), replaced.end)
  }
  let expected = """
      - apples
      - bananas
      - cherries
      """;
  assert(bulletizeList("apples, bananas, cherries") == expected);
  assert(bulletizeListNfa("apples, bananas, cherries") == expected);
}

test("word boundary at edge") {
  // Find word boundary alone, including at string edges.
  let regex = TemperRegexNFA.fromRegex(/\b/.data);
  assert(!regex.found(""));
  assert(!regex.found("!"));
  assert(regex.found("!a!"));
  assert(regex.found("a"));
  // Make sure we also can find trailing edges.
  let r2 = TemperRegexNFA.fromRegex(/.\b/.data);
  assert(r2.found("a"));
}
