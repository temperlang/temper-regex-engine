  // }
}

let buildMatch(
  str: String,
  begin: StringIndex,
  end: StringIndex,
  pairs: Mapped<String, Pair<StringIndex, StringIndex>>,
  stackGroups: Listed<String>,
): Match {
  let groups = new MapBuilder<String, Group>();
  let keys = pairs.keys;
  for (var i = 0; i < keys.length; i++) {
    let key = keys[i];
    let val = pairs[key];
    let res = str.slice(val.key, val.value);
    for (var s = 0; s < stackGroups.length; s++) {
      if (key == stackGroups.getOr(s, "")) {
        groups[key] = group(str, key, res, val.key, val.value);
      }
    }
  }
  let full = group(str, "full", str.slice(begin, end), begin, end);
  new Match(full, groups.toMap())
}
