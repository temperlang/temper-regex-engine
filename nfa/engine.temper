
let { ... } = import("std/regex");
let { ... } = import("./state.temper");
let { ... } = import("./stack.temper");
let { ... } = import("./matcher.temper");
let { ... } = import("../util.temper");

let group(str: String, name: String, value: String, start: StringIndex): Group {
  return new Group(name, value, start);
}

let skip(s: String, c: StringIndex, i: Int): StringIndex {
  while (i > 0) {
    c = s.next(c);
    i -= 1;
  }
  return c;
}

export class Engine {
  public states: ListBuilder<State>;
  public startState: State;
  public endState: State;
  public epsilon: EpsilonMatcher;

  public constructor() {
    states = new ListBuilder<State>();
    startState = newState();
    endState = newState();
    epsilon = new EpsilonMatcher();
  }
  
  public newState(): State {
    var ret = new State(states.length);
    states.add(ret);
    return ret;
  }

  public replace(str: String, replacer: fn(Mapped<String, Group>): String): String {
    let pairs = new MapBuilder<String, Pair<StringIndex, StringIndex>>();
    let pending = new MapBuilder<String, StringIndex>();
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    var last = String.begin;
    let ret = new ListBuilder<String>();
    for (var i = String.begin; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart, []);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        var sgroups = stack.groups;
        stack = stack.next;
        if (state.id == endState.id) {
          let cur = new ListBuilder<Int>();
          for (var j = last; j.compareTo(i) < 0; j = str.next(j)) {
            cur.add(str[j]);
          }
          ret.add(cur.join("", chr));
          
          let groups = new MapBuilder<String, Group>();
          let keys = pairs.keys;
          for (var i = 0; i < keys.length; i++) {
            let key = keys[i];
            let val = pairs[key];
            let res = new ListBuilder<Int>();
            for (var j = val.key; j.compareTo(val.value) < 0; j = str.next(j)) {
              res.add(str[j]);
            }
            for (var s = 0; s < sgroups.length; s++) {
              if (key == sgroups.getOr(s, "")) {
                groups[key] = group(str, key, res.join("", chr), val.key);
              }
            }
          }
          if (!groups.has("full")) {
            let full = new ListBuilder<Int>();
            for (var j = i; j.compareTo(index) < 0; j = str.next(j)) {
              full.add(str[j]);
            }
            groups["full"] = group(str, "full", full.join("", chr), i);
          }
          ret.add(replacer(groups));

          i = str.prev(index);
          last = index;
          break;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.is<StringIndex>()) {
            match (matcher) {
              is StartGroupMatcher -> do {
                pending[matcher.name] = index;
                stack = new StackSlot(skip.as<StringIndex>(), toState, stack, sgroups);
              }
              is EndGroupMatcher -> do {
                pairs[matcher.name] = new Pair(pending[matcher.name], index);
                let next = new ListBuilder<String>();
                next.add(matcher.name);
                next.addAll(sgroups);
                stack = new StackSlot(skip.as<StringIndex>(), toState, stack, next);
              }
              else -> do {
                stack = new StackSlot(skip.as<StringIndex>(), toState, stack, sgroups);
              }
            }
          }
        }
      }
    }
    let cur = new ListBuilder<Int>();
    for (var j = last; str.hasIndex(j); j = str.next(j)) {
      cur.add(str[j]);
    }
    ret.add(cur.join("", chr));
    return ret.join("", idString);
  }

  public split(str: String): Listed<String> {
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    var last = String.begin;
    let ret = new ListBuilder<String>();
    for (var i = String.begin; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          let cur = new ListBuilder<Int>();
          for (var j = last; j.compareTo(i) < 0; j = str.next(j)) {
            cur.add(str[j]);
          }
          i = str.prev(index);
          last = index;
          ret.add(cur.join("", chr));
          break;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.is<StringIndex>()) {
            stack = new StackSlot(skip.as<StringIndex>(), toState, stack);
          }
        }
      }
    }
    let cur = new ListBuilder<Int>();
    for (var j = last; str.hasIndex(j); j = str.next(j)) {
      cur.add(str[j]);
    }
    ret.add(cur.join("", chr));
    return ret;
  }

  public found(str: String, start: StringIndex): StringIndexOption {
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = String.begin; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          return index;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.is<StringIndex>()) {
            stack = new StackSlot(skip.as<StringIndex>(), toState, stack);
          }
        }
      }
    }
    return StringIndex.none;
  }

  public find(str: String): Mapped<String, Group> {
    let pairs = new MapBuilder<String, Pair<StringIndex, StringIndex>>();
    let pending = new MapBuilder<String, StringIndex>();
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = String.begin; str.hasIndex(i); i = str.next(i)) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        var sgroups = stack.groups;
        stack = stack.next;
        if (state.id == endState.id) {
          let groups = new MapBuilder<String, Group>();
          let keys = pairs.keys;
          for (var i = 0; i < keys.length; i++) {
            let key = keys[i];
            let val = pairs[key];
            let res = new ListBuilder<Int>();
            for (var j = val.key; j.compareTo(val.value) < 0; j = str.next(j)) {
              res.add(str[j]);
            }
            for (var i = 0; i < sgroups.length; i++) {
              if (sgroups.getOr(i, "") == key) {
                groups[key] = group(str, key, res.join("", chr), val.key);
              }
            }
          }
          if (!groups.has("full")) {
            let full = new ListBuilder<Int>();
            for (var j = i; j.compareTo(index) < 0; j = str.next(j)) {
              full.add(str[j]);
            }
            groups["full"] = group(str, "full", full.join("", chr), i);
          }
          return groups;
        }
        var next = state.next;
        var len =  next.length;
        for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          let skip = matcher.matches(str, index);
          if (skip.is<StringIndex>()) {
            match (matcher) {
              is StartGroupMatcher -> do {
                pending[matcher.name] = index;
                stack = new StackSlot(index, toState, stack, sgroups);
              }
              is EndGroupMatcher -> do {
                pairs[matcher.name] = new Pair(pending[matcher.name], index);
                let next = new ListBuilder<String>();
                next.add(matcher.name);
                next.addAll(sgroups);
                stack = new StackSlot(index, toState, stack, next);
              }
              else -> do {
                stack = new StackSlot(skip.as<StringIndex>(), toState, stack, sgroups);
              }
            }
          }
        }
      }
    }
    return new Map<String, Group>([]);
  }

