
let { ... } = import("std/regex");
let { ... } = import("../state");
let { ... } = import("../stack");
let { ... } = import("../matcher");
let { ... } = import("../../util");

class Hit(
  public begin: StringIndex,
  public end: StringIndex,
  public spans: Span?,
) {}

/** The end of the earliest match starting at or after `from`, or none. */
@fun export interface Scan(str: String, from: StringIndex): StringIndexOption;

export class Engine {
  public states: ListBuilder<State> = new ListBuilder<State>();
  public startState: State = Engine.newStateIn(states);
  public endState: State = Engine.newStateIn(states);
  public epsilon: EpsilonMatcher = new EpsilonMatcher();
  /** Capture group names in the order the pattern first names them. */
  public groupNames: ListBuilder<String> = new ListBuilder<String>();
  /**
   * A faster scanner, like a DFA, that answers `found` alone and lets the
   * other searches give up early when nothing matches. It can't tell which
   * match has priority, so the backtracking search still picks it.
   */
  public var scan: Scan? = null;

  private static newStateIn(states: ListBuilder<State>): State {
    var ret = new State(states.length);
    states.add(ret);
    return ret;
  }

  public newState(): State {
    Engine.newStateIn(states)
  }

  public addGroupName(name: String): Void {
    for (var i = 0; i < groupNames.length; i++) {
      if (groupNames[i] == name) {
        return;
      }
    }
    groupNames.add(name);
  }

  /** The leftmost match starting at or after `from`. */
  private search(str: String, from: StringIndex): Hit? {
    // No early return, which Python translates to a costly exception.
    let scanner = scan;
    if (scanner == null || scanner(str, from) != StringIndex.none) {
      searchFrom(str, from)
    } else {
      null
    }
  }

  /**
   * Backtracks from each start position in turn, trying each state's edges
   * in the order they were added. What can match after a state at a position
   * doesn't depend on the path that got there, and the first path to get
   * there has priority, so each (state, position) pair is explored once.
   * Only states with several incoming edges are marked, since others are
   * revisited only through their one predecessor, or never, for the start.
   */
  private searchFrom(str: String, from: StringIndex): Hit? {
    let marks = new Marks(states.length);
    let stack = new ListBuilder<StackSlot>();
    var begin = from;
    var beginPos = 0;
    while (true) {
      stack.add(new StackSlot(begin, beginPos, startState, null));
      while (!stack.isEmpty) {
        let top = stack.removeLast();
        if (top.state.incoming < 2 || marks.mark(top.state, top.pos)) {
          if (top.state.id == endState.id) {
            return new Hit(begin, top.index, top.spans);
          }
          let index = top.index;
          let next = top.state.next;
          for (var c = next.length - 1; c >= 0; c -= 1) {
            let { matcher, toState } = next[c];
            let skip = matcher.matches(str, index);
            if (skip is StringIndex) {
              let pos = if (skip == index) { top.pos } else { top.pos + 1 };
              if (!marks.has(toState, pos)) {
                let spans = when (matcher) {
                  is StartGroupMatcher -> new Span(matcher.name, index, null, top.spans);
                  is EndGroupMatcher -> closeSpan(top.spans, matcher.name, index);
                  else -> top.spans;
                };
                stack.add(new StackSlot(skip, pos, toState, spans));
              }
            }
          }
        }
      }
      if (!str.hasIndex(begin)) {
        break;
      }
      begin = str.next(begin);
      beginPos += 1;
    }
    null
  }

  public replace(str: String, replacer: fn(Match): String): String {
    let ret = new StringBuilder();
    var last = String.begin;
    var from = String.begin;
    while (true) {
      let hit = search(str, from);
      if (hit != null) {
        ret.appendBetween(str, last, hit.begin);
        ret.append(replacer(buildMatch(str, hit, groupNames)));
        last = hit.end;
        if (hit.end != hit.begin) {
          from = hit.end;
        } else if (str.hasIndex(hit.end)) {
          // Step past an empty match so it isn't found again.
          from = str.next(hit.end);
        } else {
          break;
        }
      } else {
        break;
      }
    }
    ret.appendBetween(str, last, str.end);
    ret.toString()
  }

  // Like JavaScript, this never splits at the very end or by an empty match
  // where the current piece starts.
  public split(str: String): Listed<String> {
    let ret = new ListBuilder<String>();
    var last = String.begin;
    var from = String.begin;
    while (true) {
      let hit = search(str, from);
      if (hit != null) {
        if (!str.hasIndex(hit.begin)) {
          break;
        }
        if (hit.end == last) {
          from = str.next(hit.begin);
        } else {
          ret.add(str.slice(last, hit.begin));
          last = hit.end;
          from = if (hit.end == hit.begin) { str.next(hit.end) } else { hit.end };
        }
      } else {
        break;
      }
    }
    ret.add(str.slice(last, str.end));
    ret
  }

  public found(str: String, start: StringIndex): Boolean {
    let scanner = scan;
    if (scanner != null) {
      scanner(str, start) != StringIndex.none
    } else {
      searchFrom(str, start) != null
    }
  }

  public find(str: String, begin: StringIndex = String.begin): Match {
    let hit = search(str, begin);
    if (hit != null) {
      buildMatch(str, hit, groupNames)
    } else {
      bogusMatch()
    }
  }

  // public toString(): String {
  //   var count = 0;
  //   var inner = states.join("", fn(state: State): String {
  //     var name = "q${state.id.toString()}";
  //     return state.next.join("", fn(next: Next): String {
  //       var line = count.toString();
  //       count++;
  //       var nexts = next.toState.id.toString();
  //       return "\n  ${name} -> q${nexts} [label=\"${next.matcher.toString()}\"];";
  //     });
  //   })
  //   return "digraph {\n  rankdir=\"LR\";${inner}\n}";
  // }

  // public toDotSub(gname: String, color: String): String {
  //   var count = 0;
  //   var used = new MapBuilder<Int, Boolean>();
  //   var inner = states.join("", fn(state: State): String {
  //     var name = "q${state.id.toString()}";
  //     used[state.id] = true;
  //     return state.next.join("", fn(next: Next): String {
  //       var line = count.toString();
  //       count++;
  //       var nexts = next.toState.id.toString();
  //       used[next.toState.id] = true;
  //       return "\n    ${gname}_${name} -> ${gname}_q${nexts} [label=\"${next.matcher.toString()}\"];";
  //     });
  //   });
  //   var decls = states.join("", fn(state: State): String {
  //     if (used[state.id] orelse false) {
  //       var name = "q${state.id.toString()}";
  //       var label = if (state.id == 0) {
  //         "start"
  //       } else if (state.id == 1) {
  //         "end"
  //       } else {
  //         name
  //       };
  //       var shape = "ellipse";
  //       return "\n    ${gname}_${name} [shape=\"${shape}\"] [label=\"${label}\"];";
  //     } else {
  //       return "";
  //     }
  //   });
  //   return "subgraph ${gname} {\n    node [style=filled color=\"${color}\"];\n    color=\"#E7E7E7\";\n    label=\"NFA\";\n    rankdir=\"LR\";${decls}${inner}\n  }";
  // }
}

/**
 * The (state, position) pairs a search has explored. There's one vector per
 * state, indexed by position, so keys can't overflow, and they're made on the
 * first mark, since many searches never need one.
 */
class Marks(
  private stateCount: Int,
) {
  private byState: ListBuilder<DenseBitVector> = new ListBuilder<DenseBitVector>();

  /** Marks the pair, and says whether it was unmarked before. */
  public mark(state: State, pos: Int): Boolean {
    if (byState.isEmpty) {
      for (var i = 0; i < stateCount; i++) {
        byState.add(new DenseBitVector(0));
      }
    }
    let bits = byState[state.id];
    let fresh = !bits[pos];
    bits[pos] = true;
    fresh
  }

  public has(state: State, pos: Int): Boolean {
    !byState.isEmpty && byState[state.id][pos]
  }
}

/** Closes the innermost open span named `name`. */
let closeSpan(spans: Span?, name: String, end: StringIndex): Span {
  var rest = spans;
  while (true) {
    let span = rest;
    if (span != null) {
      if (span.end == null && span.name == name) {
        return new Span(name, span.begin, end, spans);
      }
      rest = span.rest;
    } else {
      break;
    }
  }
  // Group edges come in pairs, so every end has an open start.
  panic()
}

/** Each group's last iteration, in the order of `names`. */
let buildMatch(str: String, hit: Hit, names: Listed<String>): Match {
  let latest = new MapBuilder<String, Group>();
  var rest = hit.spans;
  while (true) {
    let span = rest;
    if (span != null) {
      let end = span.end;
      if (end != null) {
        if (!latest.has(span.name)) {
          latest[span.name] = new Group(span.name, str.slice(span.begin, end), span.begin, end);
        }
      }
      rest = span.rest;
    } else {
      break;
    }
  }
  let groups = new MapBuilder<String, Group>();
  for (var i = 0; i < names.length; i++) {
    let name = names[i];
    if (latest.has(name)) {
      groups[name] = latest[name] orelse panic();
    }
  }
  let full = new Group("full", str.slice(hit.begin, hit.end), hit.begin, hit.end);
  new Match(full, groups.toMap())
}
