  // }
}

let isMarked(visited: DenseBitVector?, key: Int): Boolean {
  if (visited != null) {
    visited[key]
  } else {
    false
  }
}

/** Closes the innermost open span named `name`. */
let closeSpan(spans: Span?, name: String, end: StringIndex): Span {
  var rest = spans;
  while (true) {
    let span = rest;
    if (span != null) {
      if (span.end == null && span.name == name) {
        return new Span(name, span.begin, end, spans);
      }
      rest = span.rest;
    } else {
      break;
    }
  }
  // Group edges come in pairs, so every end has an open start.
  panic()
}

/** Each group's last iteration, ordered by where it begins, outer first. */
let buildMatch(str: String, hit: Hit): Match {
  let latest = new MapBuilder<String, Group>();
  var rest = hit.spans;
  while (true) {
    let span = rest;
    if (span != null) {
      let end = span.end;
      if (end != null) {
        if (!latest.has(span.name)) {
          latest[span.name] = new Group(span.name, str.slice(span.begin, end), span.begin, end);
        }
      }
      rest = span.rest;
    } else {
      break;
    }
  }
  let ordered = latest.values().sorted { a, b =>
    if (a.begin != b.begin) {
      a.begin <=> b.begin
    } else {
      b.end <=> a.end
    }
  };
  let groups = new MapBuilder<String, Group>();
  for (let group of ordered) {
    groups[group.name] = group;
  }
  let full = new Group("full", str.slice(hit.begin, hit.end), hit.begin, hit.end);
  new Match(full, groups.toMap())
}
