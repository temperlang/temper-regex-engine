
let { ... } = import("std/regex");
let { ... } = import("./state");
let { ... } = import("./matcher");
let { ... } = import("./engine");
let { ... } = import("../util");
let { ... } = import("../regex");
let { ... } = import("../dfa/lua");
let { ... } = import("../dfa/javascript");
let { ... } = import("../dfa/dfa");
let { ... } = import("../ctype");
import("./test");

let noTest(str: String): Boolean {
  bubble();
}

let noThen(regex: RegexNode): Matcher | Null {
  return null;
}

let noRunFound(str: String): StringIndexOption {
  return StringIndex.none;
}

let oneToMany(foundAt: fn(str: String, index: StringIndex): StringIndexOption): fn(str: String): StringIndexOption {
  return fn(str: String): StringIndexOption {
    var head = String.begin;
    let stop = str.end;
    while (head != stop) {
      let got = foundAt(str, head);
      if (got != StringIndex.none) {
        return got;
      }
      head = str.next(head);
    }
    return StringIndex.none;
  };
}

class DFAMatcher(
  public table: Table,
  public source: RegexNode,
) extends Matcher {
  public matches(str: String, index: StringIndex): StringIndexOption {
    return table.foundAt(str, index);
  }

  public toString(): String {
    return "/${regexToString(source)}/";
  }
}

class EvalMatcher(
  public matcher: fn(str: String, index: StringIndex): StringIndexOption,
  public source: RegexNode,
) extends Matcher {
  public matches(str: String, index: StringIndex): StringIndexOption {
    return matcher(str, index);
  }

  public toString(): String {
    return "/${regexToString(source)}/";
  }
}

export class TemperRegexNFA(
  public var engine: Engine,
  public var runFound: fn(String): StringIndexOption,
  public var subRegex: fn(RegexNode): Matcher | Null,
) extends TemperRegex {
  public static fromRegex(regex: RegexNode, subRegex: fn(RegexNode): Matcher | Null = noThen): TemperRegexNFA {
    let nfa = new TemperRegexNFA(new Engine(), noRunFound, subRegex);
    nfa.buildRegex(regex, nfa.engine.startState, nfa.engine.endState);
    nfa.runFound = fn(str: String): StringIndexOption {
      return nfa.engine.found(str, String.begin);
    };
    return nfa;
  }
  
  public static fromRegexDFA(regex: RegexNode): TemperRegexNFA {
    let dfa = DFA.fromEngine(TemperRegexNFA.fromRegex(regex).engine);
    let nfa = TemperRegexNFA.fromRegex(regex, fn(subRegex: RegexNode): Matcher | Null {
      let sub = TemperRegexNFA.fromRegex(subRegex);
      let dfa = DFA.fromEngine(sub.engine);
      when (dfa) {
        is DFA -> do {
          return new DFAMatcher(dfa.table, subRegex);
        }
        else -> do {
          return null;
        }
      }
    });
    when (dfa) {
      is DFA -> do {
        let table = dfa.table;
        nfa.runFound = fn(str: String): StringIndexOption {
          return table.foundAfter(str, String.begin);
        };
        return nfa;
      }
      else -> do {
        return nfa;
      }
    }
  }

  public static fromRegexLua(regex: RegexNode, load: fn(String): fn(String, StringIndex): StringIndexOption): TemperRegexNFA {
    let dfa = DFA.fromEngine(TemperRegexNFA.fromRegex(regex).engine);
    let nfa = TemperRegexNFA.fromRegex(regex, fn(subRegex: RegexNode): Matcher | Null {
      let sub = TemperRegexNFA.fromRegex(subRegex);
      let dfa = DFA.fromEngine(sub.engine);
      when (dfa) {
        is DFA -> do {
          let lua = Lua.fromTable(dfa.table);
          return new EvalMatcher(load(lua), subRegex);
        }
        else -> do {
          return null;
        }
      }
    });
    when (dfa) {
      is DFA -> do {
        let lua = Lua.fromTable(dfa.table);
        nfa.runFound = oneToMany(load(lua));
        return nfa;
      }
      else -> do {
        return nfa;
      }
    }
  }

  public static fromRegexJavascript(regex: RegexNode, load: fn(String): fn(String, StringIndex): StringIndexOption): TemperRegexNFA {
    let dfa = DFA.fromEngine(TemperRegexNFA.fromRegex(regex).engine);
    let nfa = TemperRegexNFA.fromRegex(regex, fn(subRegex: RegexNode): Matcher | Null {
      let sub = TemperRegexNFA.fromRegex(subRegex);
      let dfa = DFA.fromEngine(sub.engine);
      when (dfa) {
        is DFA -> do {
          let javascript = Javascript.fromTable(dfa.table);
          return new EvalMatcher(load(javascript), subRegex);
        }
        else -> do {
          return null;
        }
      }
    });
    when (dfa) {
      is DFA -> do {
        let javascript = Javascript.fromTable(dfa.table);
        nfa.runFound = oneToMany(load(javascript));
        return nfa;
      }
      else -> do {
        return nfa;
      }
    }
  }

  public buildRegex(regex: RegexNode, input: State, output: State): Void | Bubble {
    let subMatcher = subRegex(regex);
    when (subMatcher) {
      is Matcher -> do {
        input.addNext(subMatcher, output);
        return;
      }
      else -> do {}
    }
    when (regex) {
      is Capture -> do {
        var mid1 = engine.newState();
        var mid2 = engine.newState();
        input.addNext(new StartGroupMatcher(regex.name), mid1);
        buildRegex(regex.item, mid1, mid2);
        mid2.addNext(new EndGroupMatcher(regex.name), output);
      }
      is CodePoints -> do {
        var lastState = input;
        var index = String.begin;
        while (regex.value.hasIndex(index)) {
          let chr = regex.value[index];
          index = regex.value.next(index);
          var curState = if (regex.value.hasIndex(index)) {
            engine.newState()
          } else {
            output
          };
          lastState.addNext(charCodeMatcher(chr), curState);
          lastState = curState;
        }
      }
      is CodeSet -> do {
        let ls = new ListBuilder<Int>();
        for (var j = 0; j < regex.items.length; j++) {
          var subRegex = regex.items[j];
          when (subRegex) {
            is CodeRange -> do {
              for (var i = subRegex.min; i <= subRegex.max; i++) {
                ls.add(i);
              }
            }
            is CodePoints -> do {
              var split = subRegex.value.split("");
              for (var i = 0; i < split.length ; i++) {
                ls.add(split[i][String.begin]);
              }
            }
          }
        }
        let make(i: Int): RegexNode {
          return new CodePoints(String.fromCodePoint(i));
        }
        input.addNext(fromChars(ls, !regex.negated), output);
      }
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          buildRegex(regex.items[i], input, output);
        }
      }
      is Repeat -> do {
        var lastState = input;
        for (var i = 0; i < regex.min; i++) {
          var curState = engine.newState();
          buildRegex(regex.item, lastState, curState);
          lastState = curState;
        }
        if (regex.max != null) {
          var max = regex.max.as<Int>();
          for (var i = regex.min; i < max; i++) {
            var curState = engine.newState();
            if (!regex.reluctant) {
              lastState.addNext(engine.epsilon, output);
              buildRegex(regex.item, lastState, curState);
            } else {
              buildRegex(regex.item, lastState, curState);
              lastState.addNext(engine.epsilon, output);
            }
            lastState = curState;
          }
          lastState.addNext(engine.epsilon, output);
        } else {
          if (!regex.reluctant) {
            lastState.addNext(engine.epsilon, output);
            buildRegex(regex.item, lastState, lastState);
          } else {
            buildRegex(regex.item, lastState, lastState);
            lastState.addNext(engine.epsilon, output);
          }
        }
      }
      is Sequence -> do {
        when (regex.items.length) {
          0 -> input.addNext(engine.epsilon, output);
          1 -> buildRegex(regex.items[0], input, output);
          else -> do {
            let seqs = new ListBuilder<Listed<RegexNode>>();
            var last = new ListBuilder<RegexNode>();
            let addAll(items: Listed<RegexNode>): Void {
              for (var i = 0; i < items.length; i++) {
                let item = items[i];
                when (item) {
                  Begin, End, WordBoundary, Dot, is Group -> do {
                    if (last.length != 0) {
                      seqs.add(last);
                    }
                    last = new ListBuilder<RegexNode>();
                    last.add(item);
                  }
                  is Sequence -> do {
                    addAll(item.items);
                  }
                  else -> do {
                    last.add(item);
                  }
                }
              }
            }
            addAll(regex.items);
            if (last.length != 0) {
              seqs.add(last);
            }
            if (seqs.length == 0) {
              input.addNext(engine.epsilon, output);
            } else {
              var v1 = input;
              for (var i = 0; i < seqs.length; i++) {
                let items = seqs[i];
                for (var j = 0; j < items.length; j++) {
                  var v2 = if (j + 1 != items.length || i + 1 != seqs.length) {
                    engine.newState()
                  } else {
                    output
                  };

                  buildRegex(items[j], v1, v2);
                  v1 = v2;
                }
              };
            }
          }
        }
      }
      is Special -> do {
        if (regex == Begin) {
          input.addNext(new BeginMatcher(), output);
        } else if (regex == Dot) {
          input.addNext(fromChars([0], false), output);
        } else if (regex == End) {
          input.addNext(new EndMatcher(), output);
        } else if (regex == WordBoundary) { 
          input.addNext(new WordBoundaryMatcher(), output);
        } else if (regex == Digit) {
          let ls = new ListBuilder<Int>();
          for (var i = char'0'; i <= char'9'; i++) {
            ls.add(i);
          }
          input.addNext(fromChars(ls, true), output);
        } else if(regex == Space) {
          input.addNext(fromChars(spaceCharsList, true), output);
        } else if (regex == Word) {
          input.addNext(fromChars(wordCharsList, true), output);
        } else {
          bubble();
        }
      }
    }
  }

  public replace(text: String, format: fn(Match): String): String {
    return engine.replace(text, format);
  }

  public split(text: String): Listed<String> {
    return engine.split(text);
  }

  public found(text: String): Boolean {
    return runFound(text) != StringIndex.none;
  }

  public find(text: String, begin: StringIndex = String.begin): Match {
    return engine.find(text, begin);
  }
}
