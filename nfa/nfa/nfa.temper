
let { ... } = import("std/regex");
let { ... } = import("../state");
let { ... } = import("../matcher");
let { ... } = import("../engine");
let { ... } = import("../../util");
let { ... } = import("../../regex");
let { ... } = import("../../dfa/lua");
let { ... } = import("../../dfa/javascript");
let { ... } = import("../../dfa/dfa");
let { ... } = import("../../ctype");
import("../test");

/** An NFA for `regex`, scanning with `makeScan` of its DFA if it has one. */
let withScan(
  regex: RegexNode,
  makeScan: fn(Table): fn(String, StringIndex): StringIndexOption,
): TemperRegexNFA {
  let nfa = TemperRegexNFA.fromRegex(regex);
  let dfa = DFA.fromEngine(nfa.engine);
  if (dfa != null) {
    let scan = makeScan(dfa.table);
    nfa.engine.scan = fn(str: String, from: StringIndex): StringIndexOption {
      scan(str, from)
    };
  }
  nfa
}

let setChars(special: SpecialSet): Listed<Int> {
  when (special) {
    is DigitSpecial -> digitCharsList;
    is SpaceSpecial -> spaceCharsList;
    else -> wordCharsList;
  }
}

/**
 * Matches with a backtracking NFA. When the regex has no anchors, a DFA scan
 * answers `found` alone and lets the others give up early when nothing
 * matches. Only the NFA knows the priorities of alternatives and repeats,
 * though, so it still picks the match.
 */
export class TemperRegexNFA(
  public engine: Engine,
) extends TemperRegex {
  public static fromRegex(regex: RegexNode): TemperRegexNFA {
    let nfa = new TemperRegexNFA(new Engine());
    nfa.buildRegex(regex, nfa.engine.startState, nfa.engine.endState);
    return nfa;
  }

  public static fromRegexDFA(regex: RegexNode): TemperRegexNFA {
    withScan(regex) { table =>
      fn(str: String, from: StringIndex): StringIndexOption { table.scan(str, from) }
    }
  }

  public static fromRegexLua(regex: RegexNode, load: fn(String): fn(String, StringIndex): StringIndexOption): TemperRegexNFA {
    withScan(regex) { table => load(Lua.fromTable(table)) }
  }

  public static fromRegexJavascript(regex: RegexNode, load: fn(String): fn(String, StringIndex): StringIndexOption): TemperRegexNFA {
    withScan(regex) { table => load(Javascript.fromTable(table)) }
  }

  // Edges are tried in the order they're added, so add preferred paths first.
  public buildRegex(regex: RegexNode, input: State, output: State): Void {
    when (regex) {
      is Capture -> do {
        engine.addGroupName(regex.name);
        var mid1 = engine.newState();
        var mid2 = engine.newState();
        input.addNext(new StartGroupMatcher(regex.name), mid1);
        buildRegex(regex.item, mid1, mid2);
        mid2.addNext(new EndGroupMatcher(regex.name), output);
      }
      is CodePoints -> do {
        if (regex.value.isEmpty) {
          input.addNext(engine.epsilon, output);
        }
        var lastState = input;
        var index = String.begin;
        while (regex.value.hasIndex(index)) {
          let chr = regex.value[index];
          index = regex.value.next(index);
          var curState = if (regex.value.hasIndex(index)) {
            engine.newState()
          } else {
            output
          };
          lastState.addNext(charCodeMatcher(chr), curState);
          lastState = curState;
        }
      }
      is CodeSet -> do {
        let ls = new ListBuilder<Int>();
        for (var j = 0; j < regex.items.length; j++) {
          let subRegex = regex.items[j];
          when (subRegex) {
            is CodeRange -> do {
              for (var i = subRegex.min; i <= subRegex.max; i++) {
                ls.add(i);
              }
            }
            is CodePoints -> do {
              let split = subRegex.value.split("");
              for (var i = 0; i < split.length ; i++) {
                ls.add(split[i][String.begin]);
              }
            }
            is SpecialSet -> ls.addAll(setChars(subRegex));
          }
        }
        input.addNext(fromChars(ls, !regex.negated), output);
      }
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          buildRegex(regex.items[i], input, output);
        }
      }
      is Repeat -> do {
        var lastState = input;
        for (var i = 0; i < regex.min; i++) {
          var curState = engine.newState();
          buildRegex(regex.item, lastState, curState);
          lastState = curState;
        }
        let max = regex.max;
        if (max != null) {
          for (var i = regex.min; i < max; i++) {
            let curState = engine.newState();
            if (regex.reluctant) {
              lastState.addNext(engine.epsilon, output);
              buildRegex(regex.item, lastState, curState);
            } else {
              buildRegex(regex.item, lastState, curState);
              lastState.addNext(engine.epsilon, output);
            }
            lastState = curState;
          }
          lastState.addNext(engine.epsilon, output);
        } else {
          // Loop on a fresh state, since lastState may be the input that
          // sibling alternatives also leave from.
          let loop = engine.newState();
          lastState.addNext(engine.epsilon, loop);
          if (regex.reluctant) {
            loop.addNext(engine.epsilon, output);
            buildRegex(regex.item, loop, loop);
          } else {
            buildRegex(regex.item, loop, loop);
            loop.addNext(engine.epsilon, output);
          }
        }
      }
      is Sequence -> do {
        let items = regex.items;
        if (items.isEmpty) {
          input.addNext(engine.epsilon, output);
        } else {
          var v1 = input;
          for (var i = 0; i < items.length; i++) {
            let v2 = if (i + 1 < items.length) {
              engine.newState()
            } else {
              output
            };
            buildRegex(items[i], v1, v2);
            v1 = v2;
          }
        }
      }
      is BeginSpecial -> input.addNext(new BeginMatcher(), output);
      is EndSpecial -> input.addNext(new EndMatcher(), output);
      is WordBoundarySpecial -> input.addNext(new WordBoundaryMatcher(), output);
      is DotSpecial -> input.addNext(fromChars([char'\n'], false), output);
      is SpecialSet -> input.addNext(fromChars(setChars(regex), true), output);
    }
  }

  public replace(text: String, format: fn(Match): String): String {
    return engine.replace(text, format);
  }

  public split(text: String): Listed<String> {
    return engine.split(text);
  }

  public found(text: String): Boolean {
    return engine.found(text, String.begin);
  }

  public find(text: String, begin: StringIndex = String.begin): Match {
    return engine.find(text, begin);
  }
}
