
let {...} = import("std/regex");
let {TemperRegexNFA} = import("./engines/nfa/nfa.temper");

let catcher = /a+(?intro=b+)c((?option1=d)|(?alphaOption2=e))+/.data;

// let replaced = catcher.replace<Result>("🌍aaabbceef") { (result);; ... }
let replaced = new TemperRegexNFA(catcher).replace("🌍aaabbcee🌎abcd🌏") { (groups);;
  // Can we compile-time convert callbacks to simple template as applicable?
  let begin = groups["full"].codePointsBegin.toString();
  "-${groups["option1"].value orelse ""}${groups["alphaOption2"].value orelse ""}${begin}-"
};
console.log("replaced: ${replaced}");
// Also check a no-match case.
let notReplaced = catcher.replace("nope") { (groups);; "hi" };
console.log("not replaced: ${notReplaced}");
