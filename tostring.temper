
let {...} = import("std/regex");

export let regexToString(base: RegexNode, chr: fn(Int): String): String {
  match (base) {
    is Capture -> do {
      var regex = base.as<Capture>();
      return "(?${regex.name}=${regexToString(regex.item, chr)})";
    }
    is CodePoints -> do {
      var regex = base.as<CodePoints>();
      return regex.value;
    }
    is CodeSet -> do {
      var regex = base.as<CodeSet>();
      var ret = new ListBuilder<String>();
      for (var j = 0; j < regex.items.length; j++) {
        var subBase = regex.items[j];
        match (subBase) {
          is CodeRange -> do {
            var subRegex = subBase.as<CodeRange>();
            ret.add("${chr(subRegex.min)}-${chr(subRegex.max)}");
          }
          is CodePoints -> do {
            var subRegex = subBase.as<CodePoints>();
            ret.add(subRegex.value);
          }
        }
      }
      return "[${ret.join("", fn(s: String): String{s})}]";
    }
    is Or -> do {
      var regex = base.as<Or>();
      var ret = new MapBuilder<String, Boolean>();
      let add(ent: RegexNode): Void {
        match (ent) {
          is Or -> do {
            for (var i = 0; i < ent.items.length; i++) {
              add(ent.items[i]);
            }
          }
          else -> do {
            ret[regexToString(ent, chr)] = true;
          }
        }
      }
      for (var i = 0; i < regex.items.length; i++) {
        add(regex.items[i]);
      }
      return ret.toList().join("|", fn(p: Pair<String, Boolean>): String {
        return p.key;
      });
    }
    is Repeat -> do {
      var regex = base.as<Repeat>();
      var mod = if (regex.min == 0 && regex.max == 1) {
        "?"
      } else if (regex.min == 0 && regex.max == null) {
        "*"
      } else if (regex.min == 1 && regex.max == null) {
        "+"
      } else if (regex.min == regex.max) {
        "{${regex.min.toString()}}"
      } else if (regex.max == null) {
        "{${regex.min.toString()},}"
      } else {
        "{${regex.min.toString()},${regex.max.as<Int>().toString()}}"
      };
      var q = if (regex.reluctant) {
        "?"
      } else {
        ""
      };
      var str = regexToString(regex.item, chr);
      var pat = "%";
      match (regex.item) {
        is CodeSet -> do {
          pat = str;
        }
        is CodePoints -> do {
          var points = regex.item.as<CodePoints>();
          if (points.value.split("").length == 1) {
            pat = str;
          } else {
            pat = "(${str})";
          }
        }
        else -> do {
          pat = "(${str})";
        }
      }
      return "${pat}${mod}${q}";
    }
    is Sequence -> do {
      var regex = base.as<Sequence>();
      if (regex.items.length == 0) {
        return "";
      } else if (regex.items.length == 1) {
        return regexToString(regex.items[0], chr);
      } else {
        let rec(r: RegexNode): String {
          return regexToString(r, chr);
        }
        var inner = regex.items.join("", rec);
        for (var i = 0; i < regex.items.length; i++) {
          match (regex.items[i]) {
            is Or -> return "(${inner})";
          }
        }
        return inner;
      }
    }
    is Special -> do {
      var regex = base.as<Special>();
      if (regex == Begin) {
        return "^";
      } else if (regex == Dot) { 
        return ".";
      } else if (regex == End) {
        return "$";
      } else if (regex == WordBoundary) { 
        return "\\b";
      } else if (regex == Digit) {
        return "\\d";
      } else if(regex == Space) {
        return "\\s";
      } else if (regex == Word) {
        return "\\w";
      } else {
        return bubble();
      }
    }
    else -> return bubble();
  }
}
