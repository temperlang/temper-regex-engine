let { ... } = import("std/regex");

let { ... } = import("./regex.temper");
let { ... } = import("./util.temper");

let { ... } = import("./nfa/nfa.temper");
let { ... } = import("./native.temper");

class Engine(
  public name: String,
  public cons: fn(RegexNode): TemperRegex,
) {
  public invoke(re: RegexNode): TemperRegex {
    return cons(re);
  }
}

export class SingleResult(
  public engine: String,
  public str: String,
  public regex: String,
  public found: Boolean,
  public score: Float64,
) {
  public toString(): String {
    return "${engine} score: ${score.toString()} (found: ${found.toString()}) (str: ${str}) (regex: ${regex})";
  }
}

class EngineResult(
  public engine: String,
  public score: Float64,
  public passed: Listed<Pair<RegexNode, String>>,
) {
  public toString(): String {
    return "${engine}: ${((score * 100.0).toInt().toFloat64() / 100.0 orelse 0.0).toString()}";
  }
}

let find(tcre: TemperRegex, str: String): Boolean {
  return !tcre.find(str, String.begin).full.name.isEmpty;
}

export class RegexBench(
  private time: fn(): Float64,
) {
  private engines: ListBuilder<Engine> = new ListBuilder<Engine>();
  private checks: ListBuilder<String> = new ListBuilder<String>();
  private regex: ListBuilder<RegexNode> = new ListBuilder<RegexNode>();
  private onSingleResultCallback: fn(SingleResult): Void =
    fn(r: SingleResult): Void {};
  private onEngineResultCallback: fn(EngineResult): Void =
    fn(r: EngineResult): Void {};
  private timePerRunInternal: Float64 = 1000.0;
  private isFound: fn(TemperRegex, String): Boolean = find;

  public useFind(): Void {
    isFound = find;
  }

  public useReplace(): Void {
    let replace(g: Match): String {
      return "@";
    }
    isFound = fn(tcre: TemperRegex, str: String): Boolean {
      return tcre.replace(str, replace) != str;
    };
  }

  public useSplit(): Void {
    isFound = fn(tcre: TemperRegex, str: String): Boolean {
      return tcre.split(str).length != 1;
    };
  }

  public useFound(): Void {
    isFound = fn(tcre: TemperRegex, str: String): Boolean {
      return tcre.found(str);
    };
  }

  public onSingleResult(v: fn(SingleResult): Void): Void {
    onSingleResultCallback = v;
  }

  public onEngineResult(v: fn(EngineResult): Void): Void {
    onEngineResultCallback = v;
  }

  public addRegexDefaults(): Void {
    addRegex(/h(i|[eu]l+o)/.data);
    addRegex(/(a+a)+a/.data);
    addRegex(/([Hh][eu]l+l)/.data);
    addRegex(/[^h]i/.data);
    addRegex(/a+(?b=b+)c((?d=d)|(?e=e))+/.data);
    addRegex(/.*[el].*[le].*/.data);
  }

  public addCheckDefaults(): Void {
    checks.add("hi");
    checks.add("helo");
    checks.add("hullo");
    checks.add("hulo");
    checks.add("i am going to say hello");
    checks.add("abcdefghijklmnopqrstuvwxyz");
    checks.add("test");
    checks.add("Hell, MI");
    checks.add("hydrogen helium carbon nitrognen");
    var many_a = "aaaaaaaaaaaaaaaaaaa";
    var many_h = "hullhullhullhullhullhullhullhull";
    checks.add(many_a);
    checks.add(many_h);
    checks.add("🌍aaabbceef");
    checks.add("let x = 1 + 2 * 3 + 4;");
    let len = checks.length;
    if (false) {
      for (var i = 0; i < len; i++) {
        let ls = new ListBuilder<String>();
        for (var j = 0; j < 100; j++) {
          ls.add(" ");
        }
        ls.add(checks[i]);
        checks.add(ls.join("", fn(s: String): String { s }));
      }
    }
    if (false) {
      for (var i = 0; i < len; i++) {
        for (var j = 0; j < len; j++) {
          checks.add("${checks[i]}${checks[j]}");
          for (var k = 0; j < len; j++) {
            checks.add("${checks[i]}${checks[j]}${checks[k]}");
          }
        }
      }
    }
  }

  public addEngineDefaults(): Void {
    addEngineTemper();
    addEngineNFA();
  }

  public addEngine(name: String, cb: fn(RegexNode): TemperRegex): Void {
    engines.add(new Engine(name, cb));
  }

  public addRegex(re: RegexNode): Void {
    regex.add(re);
  }

  public addEngineTemper(): Void {
    addEngine(
      "Temper",
      fn(regex: RegexNode): TemperRegex {
        return new TemperRegexNative(regex);
      }
    );
  }

  public addEngineNFA(): Void {
    addEngine(
      "NFA",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegex(regex);
      }
    );
  }

  public addEngineDFA(): Void {
    addEngine(
      "DFA",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegexDFA(regex);
      }
    );
  }

  public addEngineLua(load: fn(String): fn(String, StringIndex): StringIndexOption): Void {
    addEngine(
      "Opt",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegexLua(regex, load);
      }
    );
  }

  public addEngineJavascript(eval: fn(String): fn(String, StringIndex): StringIndexOption): Void {
    addEngine(
      "Opt",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegexJavascript(regex, eval);
      }
    );
  }

  public run(): Void {
    useFound();
    console.log("::found");
    once();
    useFind();
    console.log("\n::find");
    once();
    useReplace();
    console.log("\n::replace");
    once();
    useSplit();
    console.log("\n::split");
    once();
  }

  public once(): Void {
    var runs = new ListBuilder<SingleResult>();

    let timePerRun = timePerRunInternal / (checks.length * regex.length).toFloat64();

    for (var i = 0; i < engines.length; i++) {
      var engine = engines[i];
      var count = 0.0;
      var total = 0.0;
      var ls = new ListBuilder<Pair<RegexNode, String>>();
      for (var j = 0; j < regex.length; j++) {
        var re = regex[j];
        var tcre = engine.invoke(re);
        for (var k = 0; k < checks.length; k++) {
          var check = checks[k];
          var iters = 1;
          var found = isFound(tcre, check);
          if (found) {
            ls.add(new Pair(re, check));
          }
          var beginTime = time();
          do {
            for (var l = 0; l < iters; l++) {
              found = isFound(tcre, check);
            }
            iters += iters;
          } while (time() - beginTime < timePerRun);
          var endTime = time();
          var ms = endTime - beginTime;
          var score = iters.toFloat64() / ms orelse 0.0;
          count += 1.0;
          total += score;
          var thisRun = new SingleResult(engine.name, check, regexToString(re), found, score);
          onSingleResultCallback(thisRun);
          runs.add(thisRun);
        }
      }
      onEngineResultCallback(new EngineResult(engine.name, total / count orelse 0.0, ls));
    }

    return runs.toList();
  }
}
