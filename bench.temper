let { Regex } = import('std/regex');
let { TemperRegex } = import('./regex');
let { TemperRegexNFA, TemperRegexDFA } = import('./graph');
let { TemperRegexWalker } = import('./walk');
let { TemperRegexNative } = import('./native');
let { sub } = import('./parser');

var regex: Regex = sub("h(?:[eu]l+o|i)");

class Check {
  public want: Boolean;
  public str: String;
}

class Engine {
  public name: String;
  public cons: fn(Regex): TemperRegex;

  public invoke(re: Regex): TemperRegex {
    return cons(re);
  }
}

var engines = new ListBuilder<Engine>();
engines.add(
  new Engine(
    "walker",
    fn(regex: Regex): TemperRegex {
      return new TemperRegexWalker(regex);
    }
  )
);
// engines.add(
//   new Engine(
//     "dfa",
//     fn(regex: Regex): TemperRegex {
//       return new TemperRegexDFA(regex);
//     }
//   )
// );
engines.add(
  new Engine(
    "nfa",
    fn(regex: Regex): TemperRegex {
      return new TemperRegexNFA(regex);
    }
  )
);
engines.add(
  new Engine(
    "native",
    fn(regex: Regex): TemperRegex {
      return new TemperRegexNative(regex);
    }
  )
);

export class Result {
  public name: String;
  public score: Float64;

  public toString(): String {
    return "${name}'s score = ${score.toInt().toString()}";
  }
}

export let bench(time: fn(): Float64): List<Result> {
  var many_a = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  var many_h = "";

  var checks = [
    new Check(true, 'hello'),
    new Check(true, 'hi'),
    new Check(true, 'helo'),
    new Check(true, 'hullo'),
    new Check(true, 'hulo'),
    new Check(true, 'i am going to say hello'),
    new Check(true, 'abcdefghijklmnopqrstuvwxyz'),
    new Check(false, 'test'),
    new Check(false, 'Hell, MI'),
    new Check(false, 'hydrogen helium carbon nitrognen'),
    new Check(false, many_a),
    new Check(false, many_h),
  ];

  var res = new ListBuilder<Result>();
  for (var j = 0; j < engines.length; j++) {
    var engine = engines[j];
    var sum = 0.0;
    for (var i = 0; i < checks.length; i++) {
      let {str, want} = checks[i];
      var re = engine.invoke(regex);
      var iters = 1;
      var res = re.found(str);
      var beginTime = time();
      do {
          for (var k = 0; k < iters; k++) {
            res = re.found(str);
          }
          iters += iters;
      } while (time() - beginTime < 100.0);
      var endTime = time();
      var ms = endTime - beginTime;
      if (res == want) {
        sum += iters.toFloat64() / (ms / 1000.0);
      } else {
        bubble();
      }
    }
    res.add(new Result(engine.name, sum / checks.length.toFloat64()));
  }

  return res.toList();
}
