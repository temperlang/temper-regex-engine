let { ... } = import("std/regex");

// let { parse } = import("./temper-regex-parser");

let { TemperRegex } = import("./regex.temper");
let { regexToString } = import("./util.temper");

let { TemperRegexNFA, noFastMatcher } = import("./engines/nfa/nfa.temper");
let { TemperRegexDFA, fastMatcher, patternMatcher } = import("./engines/dfa/dfa.temper");
let { TemperRegexWalker } = import("./engines/walk.temper");
let { TemperRegexNative } = import("./engines/native.temper");

class Engine {
  public name: String;
  public cons: fn(RegexNode): TemperRegex;

  public invoke(re: RegexNode): TemperRegex {
    return cons(re);
  }
}

var engines = new ListBuilder<Engine>();

export class SingleResult {
  public engine: String;
  public str: String;
  public regex: String;
  public found: Boolean;
  public score: Float64;

  public toString(): String {
    return "${engine} score: ${score.toString()} (found: ${found.toString()}) (str: ${str}) (regex: ${regex})";
  }
}

class EngineResult {
  public engine: String;
  public score: Float64;
  public passed: Listed<Pair<RegexNode, String>>;

  public toString(): String {
    return "${engine}: ${((score * 100.0).toInt().toFloat64() / 100.0 orelse 0.0).toString()}";
  }
}

export class RegexBench {
  private time: fn(): Float64;
  private engines: ListBuilder<Engine>;
  private checks: ListBuilder<String>;
  private regex: ListBuilder<RegexNode>;
  private onSingleResultCallback: fn(SingleResult): Void;
  private onEngineResultCallback: fn(EngineResult): Void;
  private timePerRunInternal: Float64;

  public constructor(getTime: fn(): Float64): Void {
    time = getTime;
    engines = new ListBuilder<Engine>();
    checks = new ListBuilder<String>();
    regex = new ListBuilder<RegexNode>();
    onSingleResultCallback = fn(r: SingleResult): Void {};
    onEngineResultCallback = fn(r: EngineResult): Void {};
    timePerRunInternal = 1000.0;
    // timePerRunInternal = -1.0;
  }

  public onSingleResult(v: fn(SingleResult): Void): Void {
    onSingleResultCallback = v;
  }

  public onEngineResult(v: fn(EngineResult): Void): Void {
    onEngineResultCallback = v;
  }

  public addRegexDefaults(): Void {
    addRegex(/h(i|[eu]l+o)/.data);
    addRegex(/(a+a)+a/.data);
    addRegex(/([Hh][eu]l+l)/.data);
    addRegex(/a+(?intro=b+)c((?option1=d)|(?alphaOption2=e))+/.data);

    // addRegex(
    //   new Sequence([
    //     new CodePoints("a"),
    //     new Or([
    //       new CodePoints("i"),
    //       new Sequence([
    //         new CodeSet([
    //           new CodePoints("eu"),
    //         ]),
    //         new CodePoints("l"),
    //         new Repeat(
    //           new CodePoints("l"),
    //           1, null, false,
    //         ),
    //       ]),
    //     ]),
    //   ]),
    // );
    // addRegex(
    //   new Sequence([
    //     new Repeat(
    //       new Sequence([
    //         new Repeat(
    //           new CodePoints("a"),
    //           1, null, false,
    //         ),
    //         new CodePoints("a"),
    //       ]),
    //       1, null, false,
    //     ),
    //     new CodePoints("a"),
    //   ]),
    // )
    // addRegex(
    //   new Sequence([
    //     new Or([
    //       new CodePoints("H"),
    //       new CodePoints("h"),
    //     ]),
    //     new Or([
    //       new CodePoints("e"),
    //       new CodePoints("u"),
    //     ]),
    //     new Repeat(
    //       new CodePoints("l"),
    //       1, null, false,
    //     ),
    //     new CodePoints("l"),
    //   ])
    // )
  }

  public addCheckDefaults(): Void {
    checks.add("hi");
    checks.add("helo");
    checks.add("hullo");
    checks.add("hulo");
    checks.add("i am going to say hello");
    checks.add("abcdefghijklmnopqrstuvwxyz");
    checks.add("test");
    checks.add("Hell, MI");
    checks.add("hydrogen helium carbon nitrognen");
    var many_a = "aaaaaaaaaaaaaaaaaaa";
    var many_h = "hullhullhullhullhullhullhullhull";
    checks.add(many_a);
    checks.add(many_h);
    checks.add("🌍aaabbceef");
  }

  public addEngineDefaults(): Void {
    addEngineTemper();
    addEngineDFA();
    addEngineNFA();
    addEngineWalker();
  }

  public addEngine(name: String, cb: fn(RegexNode): TemperRegex): Void {
    engines.add(new Engine(name, cb));
  }

  public addRegex(re: RegexNode): Void {
    regex.add(re);
  }

  public addEngineTemper(): Void {
    addEngine(
      "Temper",
      fn(regex: RegexNode): TemperRegex {
        return new TemperRegexNative(regex);
      }
    );
  }

  public addEngineDFA(): Void {
    addEngine(
      "DFA",
      fn(regex: RegexNode): TemperRegex {
        return new TemperRegexDFA(regex);
      }
    );
  }

  public addEngineCombo(): Void {
    addEngine(
      "NFA+DFA",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegex(regex, fastMatcher);
      }
    );
  }

  public addEnginePattern(indexAfter: fn(String): fn(String, StringIndex): List<StringIndex>): Void {
    addEngine(
      "Pattern",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegex(regex, patternMatcher(indexAfter));
      }
    );
  }

  public addEngineNFA(): Void {
    addEngine(
      "NFA",
      fn(regex: RegexNode): TemperRegex {
        return TemperRegexNFA.fromRegex(regex, noFastMatcher);
      }
    );
  }

  public addEngineWalker(): Void {
    addEngine(
      "Walker",
      fn(regex: RegexNode): TemperRegex {
        return new TemperRegexWalker(regex);
      }
    );
  }

  public isFound(tcre: TemperRegex, check: String): Boolean {
    // return tcre.find(check).has("full");
    return tcre.found(check);
  }

  public run(): Void {
    var runs = new ListBuilder<SingleResult>();

    let timePerRun = timePerRunInternal / (checks.length * regex.length).toFloat64();

    for (var i = 0; i < engines.length; i++) {
      var engine = engines[i];
      var count = 0.0;
      var total = 0.0;
      var ls = new ListBuilder<Pair<RegexNode, String>>();
      for (var j = 0; j < regex.length; j++) {
        var re = regex[j];
        var tcre = engine.invoke(re);
        for (var k = 0; k < checks.length; k++) {
          var check = checks[k];
          var iters = 1;
          var found = isFound(tcre, check);
          if (found) {
            ls.add(new Pair(re, check));
          }
          var beginTime = time();
          do {
            for (var l = 0; l < iters; l++) {
              found = isFound(tcre, check);
            }
            iters += iters;
          } while (time() - beginTime < timePerRun);
          var endTime = time();
          var ms = endTime - beginTime;
          var score = iters.toFloat64() / ms orelse 0.0;
          count += 1.0;
          total += score;
          var thisRun = new SingleResult(engine.name, check, regexToString(re), found, score);
          onSingleResultCallback(thisRun);
          runs.add(thisRun);
        }
      }
      onEngineResultCallback(new EngineResult(engine.name, total / count orelse 0.0, ls));
    }

    return runs.toList();
  }
}
