
let {...} = import("../util/regex");
let {...} = import("./engine");

export class TemperRegexNFA extends TemperRegexEngine {
  public finalEngine: Engine;
  public engineMap: MapBuilder<String, Engine>;
  
  public constructor(regex: TemperRegex): Void {
    finalEngine = new Engine();
    engineMap = new MapBuilder<String, Engine>();
    engineMap["\\R"] = finalEngine;
    buildTemperRegex(finalEngine, regex, finalEngine.startState, finalEngine.endState);
  }

  public buildRegexNamed(name: String, regex: TemperRegex): Engine {
    return engineMap[name] orelse do {
      var nextEngine = new Engine();
      engineMap[name] = nextEngine;
      buildTemperRegex(nextEngine, regex, nextEngine.startState, nextEngine.endState);
      nextEngine
    }
  }

  public buildTemperRegex(engine: Engine, regex: TemperRegex, input: State, output: State): Void | Bubble {
    match (regex) {
      is TemperCapture -> do {
        var postInput = engine.newState();
        input.addNext(new CaptureBeginMatcher(regex.name), postInput);
        var preOutput = engine.newState();
        preOutput.addNext(new CaptureEndMatcher(regex.name), output);
        buildTemperRegex(engine, regex.item, postInput, preOutput);
      }
      is TemperCodePoints -> do {
        var split = regex.value.split("");
        var lastState = input;
        for (var i = 0; i < split.length ; i++) {
          if (i == split.length - 1) {
            lastState.addNext(new CharCodeMatcher(split[i].codePoints.read()), output);
          } else {
            var curState = engine.newState();
            lastState.addNext(new CharCodeMatcher(split[i].codePoints.read()), curState);
            lastState = curState;
          }
        }
      }
      is TemperBackReference -> do {
        input.addNext(new BackReferenceMatcher(regex.name), output);
      }
      is TemperRegexPromise -> do {
        input.addNext(new PromiseMatcher(regex.name, buildRegexNamed(regex.name, regex.item)), output);
      }
      is TemperLookAhead -> do {
        var nextEngine = new Engine();
        buildTemperRegex(nextEngine, regex, nextEngine.startState, nextEngine.endState);
        input.addNext(new LookAheadMatcher(regex.negated, nextEngine), output);
      }
      is TemperCodeSet -> do {
        if (regex.negated) {
          var head = input;
          for (var j = 0; j < regex.items.length; j++) {
            var subTemperRegex = regex.items[j];
            match (subTemperRegex) {
              is TemperCodeRange -> do {
                var cur = engine.newState();
                head.addNext(new NotRangeMatcher(subTemperRegex.min, subTemperRegex.max), cur);
                head = cur;
              }
              is TemperCodePoints -> do {
                var cur = engine.newState();
                var split = subTemperRegex.value.split("");
                for (var i = 0; i < split.length ; i++) {
                  head.addNext(new NotCharCodeMatcher(split[i].codePoints.read()), cur);
                }
                head = cur;
              }
            }
          }
          head.addNext(new AnyMatcher(), output);
        } else {
          for (var j = 0; j < regex.items.length; j++) {
            var subTemperRegex = regex.items[j];
            match (subTemperRegex) {
              is TemperCodeRange -> do {
                input.addNext(new RangeMatcher(subTemperRegex.min, subTemperRegex.max), output);
              }
              is TemperCodePoints -> do {
                var split = subTemperRegex.value.split("");
                for (var i = 0; i < split.length ; i++) {
                  input.addNext(new CharCodeMatcher(split[i].codePoints.read()), output);
                }
              }
            }
          }
        }
      }
      is TemperOr -> do {
        for (var i = 0; i < regex.items.length; i++) {
          buildTemperRegex(engine, regex.items[i], input, output)
        }
      }
      is TemperRepeat -> do {
        var lastState = input;
        for (var i = 0; i < regex.min; i++) {
          var curState = engine.newState();
          buildTemperRegex(engine, regex.item, lastState, curState);
          lastState = curState;
        }
        if (regex.max != null) {
          var max = regex.max.as<Int>();
          for (var i = regex.min; i < max; i++) {
            var curState = engine.newState();
            if (!regex.reluctant) {
              lastState.addNext(engine.epsilon, output);
            }
            buildTemperRegex(engine, regex.item, lastState, curState);
            if (regex.reluctant) {
              lastState.addNext(engine.epsilon, output);
            }
            lastState = curState;
          }
          lastState.addNext(engine.epsilon, output);
        } else {
          if (!regex.reluctant) {
            lastState.addNext(engine.epsilon, output);
          }
          buildTemperRegex(engine, regex.item, lastState, lastState);
          if (regex.reluctant) {
            lastState.addNext(engine.epsilon, output);
          }
        }
      }
      is TemperSequence -> do {
        var nextState = output; 
        for (var j = regex.items.length - 1; j >= 0; j--) {
          var curState = if (j == 0) {
            input
          } else {
            engine.newState()
          };
          buildTemperRegex(engine, regex.items[j], curState, nextState);
          nextState = curState;
        }
        if (regex.items.length == 0) {
          input.addNext(engine.epsilon, nextState);
        }
      }
      is TemperSpecial -> do {
        if (regex == TemperBegin) {
          input.addNext(new BeginMatcher(), output);
        } else if (regex == TemperDot) { 
          input.addNext(new AnyMatcher(), output);
        } else if (regex == TemperEnd) {
          input.addNext(new EndMatcher(), output);
        } else if (regex == TemperRecurse) { 
          input.addNext(new RecurseMatcher(), output);
        } else if (regex == TemperWordBoundary) { 
          input.addNext(new WordBoundaryMatcher(), output);
        } else if (regex == TemperWordBoundaryBegin) { 
          input.addNext(new WordBoundaryBeginMatcher(), output);
        } else if (regex == TemperWordBoundaryEnd) { 
          input.addNext(new WordBoundaryEndMatcher(), output);
        } else if (regex == TemperDigit) {
          input.addNext(new RangeMatcher(48, 57), output);
        } else if(regex == TemperSpace) {
          input.addNext(new SpaceClassMatcher(), output);
        } else if (regex == TemperWord) {
          input.addNext(new WordClassMatcher(), output);
        } else {
          bubble();
        }
      }
      else -> do {
        bubble();
      }
    }
  }

  public find(str: String): Map<String, TemperGroup> | Bubble {
    return finalEngine.find(str);
  }

  public found(str: String): Boolean {
    return finalEngine.found(str);
  }

  public toString(): String {
    return finalEngine.toString();
  }
}

let idString(s: String): String {
  return s;
}
