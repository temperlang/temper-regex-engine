
let {TemperGroup} = import("../util/regex");

let ord(s: String): Int {
  return s.codePoints.read();
}

export class Next {
  public toState: State;
  public matcher: Matcher;
}

export class State {
  public id: Int;
  public next: ListBuilder<Next>;

  public constructor(identify: Int): Void {
    id = identify; 
    next = new ListBuilder<Next>();
  }

  public addNext(matcher: Matcher, toState: State): Void {
    next.add(new Next(toState, matcher));
  }

  public addNextFirst(matcher: Matcher, toState: State): Void {
    var oldNext = next;
    next = new ListBuilder<Next>();
    next.add(new Next(toState, matcher));
    for (var i = 0; i < oldNext.length; i++) {
      next.add(oldNext[i]);
    }
  }
}

export interface Matcher {
  public matches(str: List<Int>, index: Int): Int;

  public toString(): String;
  
  public name(): String;
}

export class PromiseMatcher extends Matcher {
  public text: String;
  public engine: Engine;

  public matches(str: List<Int>, index: Int): Int {
    return -2;
  }

  public toString(): String {
    return "Promise(...)";
  }
  
  public name(): String {
    return "Promise";
  }
}

export class BackReferenceMatcher extends Matcher {
  public group: String;

  public matches(str: List<Int>, index: Int): Int {
    return -2;
  }

  public toString(): String {
    return "\\k<${group}>";
  }
  
  public name(): String {
    return "BackReference";
  }
}

export class LookAheadMatcher extends Matcher {
  public positive: Boolean;
  public engine: Engine;

  public matches(str: List<Int>, index: Int): Int {
    return -2;
  }

  public toString(): String {
    var c = if (positive) {"="} else {"!"};
    return "(?${c}...)";
  }
  
  public name(): String {
    return "LookAhead";
  }
}

export class RecurseMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    return -2;
  }

  public toString(): String {
    return "\\R"
  }
  
  public name(): String {
    return "Recurse";
  }
}

export class CaptureBeginMatcher extends Matcher {
  public group: String;

  public matches(str: List<Int>, index: Int): Int {
    return -2;
  }

  public toString(): String {
    return "<${group}>";
  }

  public name(): String {
    return "CaptureBegin";
  }
}

export class CaptureEndMatcher extends Matcher {
  public group: String;

  public matches(str: List<Int>, index: Int): Int {
    return -2;
  }

  public toString(): String {
    return "</${group}>";
  }

  public name(): String {
    return "CaptureEnd";
  }
}

export class BeginMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    if (index == 0) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return "^";
  }

  public name(): String {
    return "Begin";
  }
}

export class WordBoundaryMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    var code1 = str.getOr(index-1, -1);
    var code2 = str.getOr(index, -1);
    var isWord1 = (48 <= code1 && code1 <= 57) || (65 <= code1 && code1 <= 90) || (97 <= code1 && code1 <= 122);
    var isWord2 = (48 <= code2 && code2 <= 57) || (65 <= code2 && code2 <= 90) || (97 <= code2 && code2 <= 122);
    if (isWord1 != isWord2) {
      return 0;
    } else {
      return -1;
    }
  }

  public name(): String {
    return "WordBoundary";
  }
}

export class WordBoundaryBeginMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    var code1 = str.getOr(index-1, -1);
    var code2 = str.getOr(index, -1);
    var isWord1 = (48 <= code1 && code1 <= 57) || (65 <= code1 && code1 <= 90) || (97 <= code1 && code1 <= 122);
    var isWord2 = (48 <= code2 && code2 <= 57) || (65 <= code2 && code2 <= 90) || (97 <= code2 && code2 <= 122);
    if (!isWord1 && isWord2) {
      return 0;
    } else {
      return -1;
    }
  }

  public name(): String {
    return "WordBoundary";
  }
}

export class WordBoundaryEndMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    var code1 = str.getOr(index-1, -1);
    var code2 = str.getOr(index, -1);
    var isWord1 = (48 <= code1 && code1 <= 57) || (65 <= code1 && code1 <= 90) || (97 <= code1 && code1 <= 122);
    var isWord2 = (48 <= code2 && code2 <= 57) || (65 <= code2 && code2 <= 90) || (97 <= code2 && code2 <= 122);
    if (isWord1 && !isWord2) {
      return 0;
    } else {
      return -1;
    };
  }

  public name(): String {
    return "WordBoundary";
  }
}

export class WordClassMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    var code = str.getOr(index, -1);
    if ((48 <= code && code <= 57) // this range is 0 to 9, like above
      || (65 <= code && code <= 90)   // this range is A to Z (uppercase)
      || (97 <= code && code <= 122)  // this range is a to z (lowercase)
    ) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return "\\w";
  }

  public name(): String {
    return "WordClass";
  }
}

export class SpaceClassMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    var code = str.getOr(index, -1);
    if (code == 9 || code == 10 || code == 11 || code == 13 || code == 32) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return "\\s";
  }

  public name(): String {
    return "SpaceClass";
  }
}

export class EndMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    if (index == str.length) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return "$";
  }

  public name(): String {
    return "EndClass";
  }
}

export class AnyMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    if (index != str.length) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return ".";
  }

  public name(): String {
    return "Any";
  }
}

export class RangeMatcher extends Matcher {
  public low: Int;
  public high: Int;

  public matches(str: List<Int>, index: Int): Int {
    var c = str.getOr(index, -1);
    if (low <= c && c <= high) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return "[\\x${low.toString()}-\\x${high.toString()}]";
  }

  public name(): String {
    return "Range";
  }
}

export class NotRangeMatcher extends Matcher {
  public low: Int;
  public high: Int;

  public matches(str: List<Int>, index: Int): Int {
    var c = str.getOr(index, -1);
    if (low <= c && c <= high) {
      return -1;
    } else {
      return 0;
    }
  }

  public toString(): String {
    return "! [\\x${low.toString()}-\\x${high.toString()}]";
  }

  public name(): String {
    return "Range";
  }
}

export class CharCodeMatcher extends Matcher {
  public code: Int;

  public constructor(point: Int): Void {
    code = point;
  }

  public matches(str: List<Int>, index: Int): Int {
    var c = str.getOr(index, -1);
    if (c == code) {
      return 1;
    } else {
      return -1;
    }
  }

  public toString(): String {
    return "#${code.toString()}";
  }

  public name(): String {
    return "CharCode";
  }
}

export class NotCharCodeMatcher extends Matcher {
  public code: Int;

  public constructor(point: Int): Void {
    code = point;
  }

  public matches(str: List<Int>, index: Int): Int {
    var c = str.getOr(index, -1);
    if (c == code) {
      return -1;
    } else {
      return 0;
    }
  }

  public toString(): String {
    return "! #${code.toString()}";
  }

  public name(): String {
    return "NotCharCode";
  }
}

export class EpsilonMatcher extends Matcher {
  public matches(str: List<Int>, index: Int): Int {
    return 0;
  }

  public toString(): String {
    return "ε";
  }

  public name(): String {
    return "Epsilon";
  }
}

interface GroupStack {
  public key: String;
  public start: Int;
  public stop: Int;

  public get next(): GroupStack;
}

class GroupStackStart extends GroupStack {
  public key: String;
  public start: Int;
  public stop: Int;

  constructor() {
    key = "";
    start = -1;
    stop = -1;
  }
  
  public get next(): GroupStack {
    return this;
  }
}

class GroupStackSlot extends GroupStack {
  public key: String;
  public start: Int;
  public stop: Int;
  public nextRaw: GroupStack;
  
  public get next(): GroupStack {
    return nextRaw;
  }

  public finish(i: Int): Void {
    stop = i;
  }
}

class MatchedRange {
  public start: Int;
  public stop: Int;
}

interface FindStack {
  public index: Int;
  public state: State;
  public groups: GroupStack;

  public get next(): FindStack;
}

class FindStackStart extends FindStack {
  public index: Int;
  public state: State;
  public groups: GroupStack;

  public constructor(): Void {
    index = -1;
    state = new State(-1);
  }
  
  public get next(): FindStack {
    return this;
  }
}

class FindStackSlot extends FindStack {
  public index: Int;
  public state: State;
  public groups: GroupStack;
  public slot: FindStack;

  public get next(): FindStack {
    return slot;
  }
}

class Done {
  public name: String;
  public pos: Int;
}

export class Engine {
  public states: ListBuilder<State>;
  public startState: State;
  public endState: State;
  public epsilon: EpsilonMatcher;

  public constructor() {
    states = new ListBuilder<State>();
    startState = newState();
    endState = newState();
    epsilon = new EpsilonMatcher();
  }

  public opt(): Engine {
    var cur = this;
    cur = cur.optEpsilonEllison();
    cur = cur.optDeadCode();
    return cur;
  }

  public optDeadCode(): Engine {
    var unopt = this;
    var opt = new Engine();
    var map = new MapBuilder<Int, Int>();

    let visit(state: State): State {
      var optId = map[state.id] orelse -1;
      if (optId >= 0) {
        return opt.states[optId];
      }
      var outState: State = if (state == unopt.startState) {
        opt.startState
      } else if (state == unopt.endState) {
        opt.endState
      } else {
        opt.newState()
      };

      map[state.id] = outState.id;

      for (var i = 0; i < state.next.length; i++) {
        var next = state.next[i];
        outState.addNext(next.matcher, visit(next.toState));
      }
      return outState;
    }

    visit(startState);

    return opt;
  }

  public optEpsilonEllison(): Engine {
    var unopt = this;
    var opt = new Engine();
    var map = new MapBuilder<Int, Int>();

    let visit(state: State): State {
      var optId = map[state.id] orelse -1;
      if (optId >= 0) {
        return opt.states[optId];
      }
      var outState: State = if (state == unopt.startState) {
        opt.startState
      } else if (state == unopt.endState) {
        opt.endState
      } else {
        opt.newState()
      };

      map[state.id] = outState.id;

      var added = new DenseBitVector(0);
      var count = 0;

      var isFinal = false;

      let add(matcher: Matcher, toState: State): Void {
        if (matcher == unopt.epsilon) {
          if (added[toState.id]) {
            return;
          }
          added[toState.id] = true;
          if (toState.id == 1) {
            isFinal = true;
            return;
          }
          for (var i = 0; i < toState.next.length; i++) {
            var next = toState.next[i];
            add(next.matcher, next.toState);
          }
        } else {
          count += 1;
          outState.addNext(matcher, visit(toState));
        }
      }

      for (var i = 0; i < state.next.length; i++) {
        var next = state.next[i];
        add(next.matcher, next.toState);
      }

      if (count == 0 || isFinal) {
        return opt.endState;
      }

      return outState;
    }

    visit(startState);

    return opt;
  }

  public newState(): State {
    var ret = new State(states.length);
    states.add(ret);
    return ret;
  }

  public findCode(str: String, codePoints: List<Int>, start: Int, stop: Int, failRecurseOn: ListBuilder<Done>): Map<String, TemperGroup> {
    var stackStart = new FindStackStart();
    var badNext = new Next(endState, epsilon);
    var groupStackStart = new GroupStackStart();
    for (var i = start; i < stop; i += 1) {
      var groupStackFull = new GroupStackSlot("full", i, -1, groupStackStart);
      var stack: FindStack = new FindStackSlot(i, startState, groupStackFull, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        var groupStack = stack.groups;
        stack = stack.next;
        if (state.id == endState.id) {
          var ret = new MapBuilder<String, TemperGroup>();
          for (var i = groupStack; i != groupStackStart; i = i.next) {
            var cur = i.as<GroupStackSlot>();
            var stop = if (cur.key == "full") {
              index
            } else {
              cur.stop
            };
            var max = codePoints.length;
            if (stop > codePoints.length) {
              stop = max;
            }
            ret[cur.key] = new TemperGroup(cur.key, cur.start, stop, str);
          }
          return ret.toMap();
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          var type = matcher.name();
          var k = matcher.matches(codePoints, index);
          if (k >= 0) {
            stack = new FindStackSlot(index + k, toState, groupStack, stack);
          } else if (k == -2) {
            if (type == "CaptureBegin") {
              var gss = new GroupStackSlot(matcher.as<CaptureBeginMatcher>().group, index, -1, groupStack);
              stack = new FindStackSlot(index, toState, gss, stack);
            } else if (type == "CaptureEnd") {
              var ce = matcher.as<CaptureEndMatcher>();
              for (var i = groupStack; i != groupStackStart; i = i.next) {
                var cur = i.as<GroupStackSlot>();
                if (cur.key == ce.group && cur.stop == -1) {
                  cur.finish(index);
                  i = groupStackFull;
                }
              }
              stack = new FindStackSlot(index, toState, groupStack, stack);
            } else if (type == "LookAhead") {
              var la = matcher.as<LookAheadMatcher>();
              var found = do {
                var found = la.engine.findCode(str, codePoints, index, index + 1, failRecurseOn);
                true
              } orelse false;
              if (found == la.positive) {
                stack = new FindStackSlot(index, toState, groupStack, stack);
              }
            } else if (type == "Promise") {
              var pm = matcher.as<PromiseMatcher>();
              stack = do {
                for (var i = 0; i < failRecurseOn.length; i++) {
                  if (failRecurseOn[i].name == pm.text && index == failRecurseOn[i].pos) {
                    bubble();
                  }
                }
                var found = pm.engine.findCode(str, codePoints, index, index + 1, failRecurseOn);
                new FindStackSlot(found["full"].stop, toState, groupStack, stack)
              } orelse stack;
            } else if (type == "BackReference") {
              var br = matcher.as<BackReferenceMatcher>();
              for (var i = groupStack; i != groupStackStart; i = i.next) {
                var cur = i.as<GroupStackSlot>();
                if (cur.key == br.group) {
                  var stop = if (cur.stop == -1) {
                    index
                  } else {
                    cur.stop
                  };
                  var max = codePoints.length;
                  if (stop > codePoints.length) {
                    stop = max;
                  }
                  var head = index;
                  var ok = true;
                  for (var i = cur.start; i < stop; i++) {
                    if (codePoints.getOr(head, -1) != codePoints.getOr(i, -2)) {
                      ok = false;
                      i = stop;
                    }
                    head += 1;
                  }
                  if (ok) {
                    stack = new FindStackSlot(head, toState, groupStack, stack);
                  }
                }
              }
            } else if (type == "Recurse") {
              stack = do {
                for (var i = 0; i < failRecurseOn.length; i++) {
                  if (failRecurseOn[i].name == "\\R" && index == failRecurseOn[i].pos) {
                    bubble();
                  }
                }
                failRecurseOn.add(new Done("\\R", index));
                var found = findCode(str, codePoints, index, index + 1, failRecurseOn);
                failRecurseOn.removeLast();
                new FindStackSlot(found["full"].stop, toState, groupStack, stack)
              } orelse stack;
            } else {
              console.log("bad matcher type: ${type}");
              bubble();
            }
          }
        }
      }
    }
    return bubble();
  }

  public find(str: String): Map<String, TemperGroup> {
    var codes = str.split("").map(ord);
    return findCode(str, codes, 0, codes.length, new ListBuilder<Done>());
  }

  public found(str: String): Boolean {
    return do {
      find(str);
      true
    } orelse false;
  }

  public toString(): String {
    var count = 0;
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        return "\n  ${name} -> q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    })
    return "digraph {\n  rankdir=\"LR\";${inner}\n}";
  }

  public toDotSub(gname: String, color: String): String {
    var count = 0;
    var used = new MapBuilder<Int, Boolean>();
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      used[state.id] = true;
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        used[next.toState.id] = true;
        return "\n    ${gname}_${name} -> ${gname}_q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    });
    var decls = states.join("", fn(state: State): String {
      if (used[state.id] orelse false) {
        var name = "q${state.id.toString()}";
        var label = if (state.id == 0) {
          "start"
        } else if (state.id == 1) {
          "stop"
        } else {
          name
        };
        var shape = "ellipse";
        return "\n    ${gname}_${name} [shape=\"${shape}\"] [label=\"${label}\"];";
      } else {
        return "";
      }
    });
    return "subgraph ${gname} {\n    node [style=filled color=\"${color}\"];\n    color=\"#E7E7E7\";\n    label=\"NFA\";\n    rankdir=\"LR\";${decls}${inner}\n  }";
  }
}