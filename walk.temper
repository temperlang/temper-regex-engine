
let { ... } = import("std/regex");
let { TemperRegex } = import("./regex");

let isCodePointWordChar(code: Int): Boolean {
  (char'0' <= code && code <= char'9')
  || (char'A' <= code && code <= char'Z')
  || code == char'_'
  || (char'a' <= code && code <= char'z')
}

class Matcher {
  public str: String;
  public head: StringIndex;
  public groupMatched: MapBuilder<String, Boolean>;
  public groups: MapBuilder<String, Group>;

  constructor(src: String): Void {
    str = src;
    head = String.start;
    groupMatched = new MapBuilder<String, Boolean>();
    groups = new MapBuilder<String, Group>();
  }

  public advance(): Void {
    // console.log("${head.toString()} next");
    head = str.next(head);
  }

  public setHead(val: StringIndex): Void {
    // console.log("${head.toString()} to ${val.toString()}");
    head = val;
  }

  public matchCapture(regex: Capture): Boolean {
    var begin = head;
    if (matchRegex(regex.item)) {
      var text = str.substring(begin, head);
      groupMatched[regex.name] = true;
      groups[regex.name] = new Group(regex.name, text, begin);
      return true;
    } else {
      setHead(begin);
      return false;
    }
  }

  public matchCodePoints(regex: CodePoints): Boolean {
    let wanted = regex.value;
    var strIndex = head;
    for (var i = String.start; i < wanted.end; i = wanted.next(i)) {
      if (strIndex >= str.end || str.codeAt(strIndex) != wanted.codeAt(i)) {
        return false;
      }
      strIndex = str.next(strIndex);
    }
    setHead(strIndex);
    true
  }

  public matchCodePartPoints(regex: CodePoints): Boolean {
    let c = str.codeAt(head);
    let wanted = regex.value;
    for (var i = String.start; i < wanted.end; i = wanted.next(i)) {
      if (c == wanted.codeAt(i)) {
        advance();
        return true;
      }
    }
    false
  }

  public matchDot(): Boolean {
    return if (head < str.end) {
      advance();
      true
    } else {
      false
    }
  }

  public matchDigit(): Boolean {
    if (head >= str.end) {
      return false;
    }
    var code = str.codeAt(head);
    return if (char'0' <= code && code <= char'9') {
      advance();
      true
    } else {
      false
    }
  }

  public matchWord(): Boolean {
    if (isCodePointWordChar(str.codeAt(head) orelse 0)) {
      advance();
      return true;
    } else {
      return false;
    }
  }

  public matchWordBoundary(): Boolean {
    return isCodePointWordChar(str.codeAt(str.prev(head)))
        != isCodePointWordChar(str.codeAt(head));
  }

  public matchSpecial(regex: Special): Boolean {
    if (regex == Begin) {
      return head == String.start;
    } else if (regex == Dot) { 
      return matchDot();
    } else if (regex == End) {
      return head >= str.end;
    } else if (regex == WordBoundary) { 
      return matchWordBoundary();
    } else if (regex == Digit) {
      return matchDigit();
    } else if(regex == Space) {
      return head < str.end && do {
        let c = str.codeAt(head);
        c == char' '
        || c == char'\t'
        || c == char'\r'
        || c == char'\n'
      };
    } else if (regex == Word) {
      return matchWord();
    } else {
      return false;
    }
  }

  public matchCodeRange(regex: CodeRange): Boolean {
    if (head >= str.end) {
      return false;
    }
    var n = str.codeAt(head);
    if (regex.min <= n && n <= regex.max) {
      advance();
      return true;
    } else {
      return false;
    }
  }

  public matchCodePart(regex: CodePart): Boolean {
    match (regex) {
      is CodePoints -> matchCodePartPoints(regex);
      else -> matchRegex(regex);
    }
  }

  public matchCodeSet(regex: CodeSet): Boolean {
    var begin = head;
    if (regex.negated) {
      for (var i = 0; i < regex.items.length; i++) {
        var res = matchCodePart(regex.items[i]);
        if (res) {
          return false
        }
        setHead(begin);
      }
      advance();
      return true;
    } else {
      for (var i = 0; i < regex.items.length; i++) {
        var res = matchCodePart(regex.items[i]);
        if (res) {
          return true;
        }
        setHead(begin);
      }
      return false;
    }
  }

  public matchOr(regex: Or): Boolean {
    var start = head;
    for (var i = 0; i < regex.items.length; i++) {
      if (matchRegex(regex.items[i])) {
        return true;
      }
    }
    setHead(start);
    return false;
  }

  public matchRepeat(regex: Repeat): Boolean {
    var start = head;
    for (var i = 0; i < regex.min; i++) {
      if (!matchRegex(regex.item)) {
        setHead(start);
        return false;
      }
    }
    if (regex.max == null) {
      while (true) {
        var mid = head;
        if (!matchRegex(regex.item)) {
          setHead(mid);
          return true;
        }
      }
    } else {
      var maxNoNull = regex.max.as<Int>();
      for (var i = regex.min; i < maxNoNull; i++) {
        var mid = head;
        if (!matchRegex(regex.item)) {
          setHead(mid);
          return true;
        }
      }
      return true;
    }
  }

  public matchSequence(regex: Sequence): Boolean {
    var start = head;
    for (var i = 0; i < regex.items.length; i++) {
      if (!matchRegex(regex.items[i])) {
        setHead(start);
        return false;
      }
    }
    return true;
  }

  public matchRegex(regex: RegexNode): Boolean {
    match (regex) {
      is Capture -> matchCapture(regex);
      is CodePoints -> matchCodePoints(regex);
      is CodeRange -> matchCodeRange(regex);
      is CodeSet -> matchCodeSet(regex);
      is Or -> matchOr(regex);
      is Repeat -> matchRepeat(regex);
      is Sequence -> matchSequence(regex);
      is Special -> matchSpecial(regex);
      else -> false;
    }
  }

  public resetGroups(regex: RegexNode): Void {
    match (regex) {
      is Capture -> do {
        groupMatched[regex.name] = false;
        groups[regex.name] = new Group(regex.name, "", String.start);
        resetGroups(regex.item);
      }
      is Repeat -> resetGroups(regex.item);
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          resetGroups(regex.items[i]);
        }
      }
      is Sequence -> do {
        for (var i = 0; i < regex.items.length; i++) {
          resetGroups(regex.items[i]);
        }
      }
      else -> do {}
    }
  };
}

export class TemperRegexWalker extends TemperRegex {
  public data: RegexNode;

  public constructor(re: RegexNode) {
    data = re;
  }

  public found(text: String): Boolean {
    let m = new Matcher(text);
    for (var i = String.start; i < text.end; i = text.next(i)) {
      m.setHead(i);
      m.resetGroups(data);
      if (m.matchRegex(data)) {
        return true;
      }
    }
    return false;
  }

  public find(text: String): Map<String, Group> | Bubble {
    findEx(text, String.start).groups
  }

  public findEx(
    text: String,
    start: StringIndex = String.start,
  ): FindExResult {
    let m = new Matcher(text);
    for (var i = start; i < text.end; i = text.next(i)) {
      m.setHead(i);
      m.resetGroups(data);
      if (!m.matchRegex(data)) {
        continue;
      }
      // Make a copy, with default full first if needed.
      let groups = new MapBuilder<String, Group>();
      if (!m.groups.has("full")) {
        groups["full"] = new Group("full", text.substring(i, m.head), i);
      };
      m.groups.forEach { (name, group);;
        if (m.groupMatched[name]) {
          groups[name] = group;
        }
      }
      return new FindExResult(
        groups = groups.toMap(),
        // These are *sometimes* available from default "full".
        start = i,
        stop = m.head,
      );
    }
    bubble()
  }

  public split(text: String): List<String> {
    let parts = new ListBuilder<String>();
    let m = new Matcher(text);
    let end = text.end;
    while (true) {
      let original = m.head;
      var i = original;
      var found = false;
      for (; i < end; i = text.next(i)) {
        m.setHead(i);
        found = m.matchRegex(data);
        if (found) {
          break;
        }
      }
      parts.add(text.substring(original, i));
      if (!found) {
        break;
      }
    }
    parts.toList()
  }
}

export class FindExResult {
  public groups: Map<String, Group>;
  public start: StringIndex;
  public stop: StringIndex;
}
