
let {...} = import("./regex.temper");

class Slot {
  public name: String;
  public regex: TemperRegex;
}

let idString(x: String): String {
  return x;
}

class Parser {
  public chars: List<String>;
  public var pos: Int;
  public slots: ListBuilder<Slot>;
  public errors: ListBuilder<String>;

  public constructor(str: String) {
    chars = str.split("");
    pos = 0;
    slots = new ListBuilder<Slot>();
    errors = new ListBuilder<String>();
  }

  public addString(name: String, text: String): Void {
    slots.add(new Slot(name, new TemperCodePoints(text)));
  }

  public addTemperRegex(name: String, regex: TemperRegex): Void {
    slots.add(new Slot(name, regex));
  }

  public error(e: String): Void {
    errors.add("${e}");
  }

  public isDone(): Boolean {
    chars.length <= pos
  }

  public peek(): String {
    if (isDone()) {
      error("done");
      return "";
    }
    chars[pos]
  }

  public advance(): Void {
    pos += 1;
  }

  public read(): String {
    let ret = peek();
    advance();
    ret
  }

  public matchChar(s: String): Boolean {
    if (peek() == s) {
      advance();
      true
    } else {
      false
    }
  }

  public charClassBody(): TemperRegex | Bubble {
    let invert = matchChar("^");
    let opts = new ListBuilder<TemperCodePart>();
    while (!matchChar("]")) {
      if (isDone()) {
        bubble()
      }
      if (matchChar("[")) {
        if (!matchChar(":")) {
          error("in code [:expr:], first colon missing");
          bubble();
        }
        var inList = new ListBuilder<String>();
        while (!matchChar(":")) {
          if (isDone()) {
            error("in code [:expr:], second colon missing");
            bubble();
          }
          inList.add(read());
        }
        var str = inList.join("", idString);
        let add(start: String, end: String): Void {
          opts.add(new TemperCodeRange(start.codePoints.read(), end.codePoints.read()));
        }
        if (str == "alnum") {
          add("a", "z");
          add("A", "Z");
          add("0", "9");
        } else if (str == "alnum") {
          add("a", "z");
          add("A", "Z");
        } else if (str == "ascii") {
          opts.add(new TemperCodeRange(0, 127));
        } else if (str == "blank") {
          opts.add(new TemperCodePoints(" \t"));
        } else if (str == "cntrl") {
          opts.add(new TemperCodeRange(0, 31));
          opts.add(new TemperCodePoints("\x7F"));
        } else if (str == "digit") {
          add("0", "9");
        } else if (str == "graph") {
          opts.add(new TemperCodeRange(31, 126));
        } else if (str == "lower") {
          add("a", "z");
        } else if (str == "print") {
          opts.add(new TemperCodeRange(30, 127));
        } else if (str == "punct") {
          opts.add(new TemperCodePoints("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"));
        } else if (str == "space") {
          opts.add(new TemperCodePoints(" \t\r\n\x0B\x0C"));
        } else if (str == "upper") {
          add("A", "Z");
        } else if (str == "word") {
          add("a", "z");
          add("A", "Z");
          add("0", "9");
          opts.add(new TemperCodePoints("_"));
        } else if (str == "xdigit") {
          add("0", "9");
          add("a", "f");
          add("A", "F");
        } else if (str == "<") {
          opts.add(TemperWordBoundaryBegin);
        } else if (str == ">") {
          opts.add(TemperWordBoundaryEnd);
        } else {
          error("unknown [:${str}:]");
          bubble();
        }
        if (!matchChar("]")) {
          error("in code [:${str}:], closing square brace missing");
          bubble();
        }
      } else {
        let firstChar = read();
        if (matchChar("\\")) {
          var escapeCode = peek();
          if (matchChar("b")) {
            opts.add(TemperWordBoundary);
          } else if (matchChar("d")) {
            opts.add(TemperDigit);
          } else if (matchChar("w")) {
            opts.add(TemperWord);
          } else if (matchChar("s")) {
            opts.add(TemperSpace);
          } else if (
            matchChar("(") || matchChar(")")
            || matchChar("[") || matchChar("]")
            || matchChar("{") || matchChar("}")
            || matchChar(".") || matchChar("\\")
          ) {
            opts.add(new TemperCodePoints(escapeCode))
          } else {
            error("unknown escape code: \\${peek()}");
            bubble()
          }
        } else if (matchChar("-")) {
          let secondChar = read();
          opts.add(new TemperCodeRange(firstChar.codePoints.read(), secondChar.codePoints.read()));
        } else {
          opts.add(new TemperCodePoints(firstChar));
        }
      }
    }
    new TemperCodeSet(opts.toList(), invert)
  }

  public matchNum(): Int {
    var n = 0;
    while (48 <= peek().codePoints.read() && peek().codePoints.read() <= 57) {
      n *= 10;
      n += read().codePoints.read() - 48;
    }
    return n;
  }

  public readPostfix(exist: TemperRegex): TemperRegex | Bubble {
    if (matchChar("+")) {
      return new TemperRepeat(exist, 1, null, matchChar("?"));
    } else if (matchChar("*")) {
      return new TemperRepeat(exist, 0, null, matchChar("?"));
    } else if (matchChar("?")) {
      return new TemperRepeat(exist, 0, 1, matchChar("?"));
    } else if (matchChar("{")) {
      var min = matchNum();
      if (matchChar("}")) {
        return new TemperRepeat(exist, min, min, matchChar("?"));
      } else if (matchChar(",")) {
        if (matchChar("}")) {
          return new TemperRepeat(exist, min, null, matchChar("?"));
        } else {
          var max = matchNum();
          if (matchChar("}")) {
            return new TemperRepeat(exist, min, max, matchChar("?"));
          } else {
            error("expecting closing curly brace in repititon");
            return bubble();
          }
        }
      } else {
        error("expecting comma or closing curly brace in repition");
        return bubble();
      }
    } else {
      return exist;
    }
  }

  public readSingle(): TemperRegex | Bubble {
    if (matchChar("[")) {
      return charClassBody();
    } 
    return if (matchChar("(")) {
      if (matchChar("?")) {
        // non capturing group
        if (matchChar(":")) {
          let regex = readTemperOr();
          if (!matchChar(")")) {
            error("closing paren");
            bubble();
          }
          regex
        } else if (matchChar("$")) {
          let parts = new ListBuilder<String>();
          while (!matchChar(")")) {
            if (isDone()) {
              error("missing closing paren in (?$...)");
              bubble();
            }
            parts.add(read());
          }
          let str = parts.join("", fn(s: String): String{s});
          for (var i = 0; i < slots.length; i++) {
            let slot = slots[i];
            if (slot.name == str) {
              return slot.regex;
            }
          }
          error("no such slot: ${str}");
          bubble()
        } else if (matchChar("=")) {
          error("positive lookhead is not supported");
          bubble()
        } else if (matchChar("<")) {
          if (matchChar("=")) {
            error("positive lookbehind is not supported");
            bubble()
          } else if (matchChar("!")) {
            error("negative lookbehind is not supported");
            bubble()
          } else {
            error("unknown sequence (<${peek()}");
            bubble()
          }
        } else if (matchChar("!")) {
          error("negative lookahead is not supported");
          bubble()
        } else {
          let str = new ListBuilder<String>();
          while (matchChar(" ")) {}
          while (!matchChar("=")) {
            if (isDone()) {
              error("missing = in (?${str.join("", fn(s: String): String{s})}=...)");
              return bubble()
            }
            str.add(read());
            while (matchChar(" ")) {}
          }
          let regex = readTemperOr();
          if (!matchChar(")")) {
            error("closing paren");
            bubble();
          }
          let name = str.join("", fn(s: String): String{s});
          new TemperCapture(name, regex)
        }
      } else {
        let regex = readTemperOr();
        if (!matchChar(")")) {
          error("closing paren");
          bubble();
        }
        regex
      }
    } else if (matchChar("^")) {
      TemperBegin
    } else if (matchChar("$")) {
      TemperEnd
    } else if (matchChar(".")) {
      TemperDot
    } else if (matchChar("\\")) {
      var escapeCode = peek();
      if (matchChar("b")) {
        TemperWordBoundary
      } else if (matchChar("d")) {
        TemperDigit
      } else if (matchChar("w")) {
        TemperWord
      } else if (matchChar("s")) {
        TemperSpace
      } else if (
        matchChar("(") || matchChar(")")
        || matchChar("[") || matchChar("]")
        || matchChar("{") || matchChar("}")
        || matchChar(".") || matchChar("\\")
      ) {
        new TemperCodePoints(escapeCode)
      } else {
        error("unknown escape code: \\${peek()}");
        bubble()
      }
    } else {
      new TemperCodePoints(read())
    };
  }

  public readSeq(): TemperRegex | Bubble {
    let seq = new ListBuilder<TemperRegex>();
    while (!isDone() && peek() != "|" && peek() != ")") {
      let regex = readSingle();
      seq.add(readPostfix(regex));
    }
    new TemperSequence(seq.toList())
  }

  public readTemperOr(): TemperRegex | Bubble {
    let ors = new ListBuilder<TemperRegex>();
    while (!isDone() && peek() != ")") {
      if (ors.length != 0 && !matchChar("|")) {
        console.log(pos.toString());
        error("or");
        bubble();
      }
      let regex = readSeq();
      ors.add(regex);
    }
    new TemperOr(ors.toList())
  }
}

export let subWith(src: String, keys: List<String>, values: List<TemperRegex>): TemperRegex | Bubble {
  let parser = new Parser(src);
  for (var i = 0; i < keys.length && i < values.length; i++) {
    let val = values[i];
    parser.addTemperRegex(keys[i], val);
  }
  parser.readTemperOr()
}

export let sub(src: String): TemperRegex | Bubble {
  let parser = new Parser(src);
  parser.readTemperOr()
}