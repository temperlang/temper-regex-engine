
let {...} = import("std/regex");

export let regexToString(base: RegexNode): String | Bubble {
  when (base) {
    is Capture -> do {
      return "(?${base.name}=${regexToString(base.item)})";
    }
    is CodePoints -> do {
      return base.value;
    }
    is CodeSet -> do {
      let ret = new ListBuilder<String>();
      for (var j = 0; j < base.items.length; j++) {
        let subBase = base.items[j];
        when (subBase) {
          is CodeRange -> do {
            ret.add("${String.fromCodePoint(subBase.min)}-${String.fromCodePoint(subBase.max)}");
          }
          is CodePoints -> do {
            ret.add(subBase.value);
          }
        }
      }
      let inv = if (base.negated) { "^" } else { "" };
      return "[${inv}${ret.join("", fn(s: String): String{s})}]";
    }
    is Or -> do {
      let ret = new MapBuilder<String, Boolean>();
      let add(ent: RegexNode): Void | Bubble {
        when (ent) {
          is Or -> do {
            for (var i = 0; i < ent.items.length; i++) {
              add(ent.items[i]);
            }
          }
          else -> do {
            ret[regexToString(ent)] = true;
          }
        }
      }
      for (var i = 0; i < base.items.length; i++) {
        add(base.items[i]);
      }
      let mid = ret.toList().join("|", fn(p: Pair<String, Boolean>): String {
        return p.key;
      });
      return "(${mid})";
    }
    is Repeat -> do {
      let mod = if (base.min == 0 && base.max == 1) {
        "?"
      } else if (base.min == 0 && base.max == null) {
        "*"
      } else if (base.min == 1 && base.max == null) {
        "+"
      } else if (base.min == base.max) {
        "{${base.min.toString()}}"
      } else if (base.max == null) {
        "{${base.min.toString()},}"
      } else {
        "{${base.min.toString()},${base.max.as<Int>().toString()}}"
      };
      let q = if (base.reluctant) {
        "?"
      } else {
        ""
      };
      let str = regexToString(base.item);
      var pat = "%";
      when (base.item) {
        is CodeSet -> do {
          pat = str;
        }
        is CodePoints -> do {
          let points = base.item.as<CodePoints>();
          if (points.value.hasIndex(String.begin) && !points.value.hasIndex(points.value.next(String.begin))) {
            pat = str;
          } else {
            pat = "${str}";
          }
        }
        else -> do {
          pat = "(${str})";
        }
      }
      return "${pat}${mod}${q}";
    }
    is Sequence -> do {
      if (base.items.length == 0) {
        return "";
      } else if (base.items.length == 1) {
        return regexToString(base.items[0]);
      } else {
        // Can't use join directly if regexToString is bubbly.
        let strings = new ListBuilder<String>();
        for (var i = 0; i < base.items.length; i += 1) {
          strings.add(regexToString(base.items[i]));
        }
        let inner = strings.join("") { (x);; x };
        return "(${inner})";
      }
    }
    is Special -> do {
      if (base == Begin) {
        return "^";
      } else if (base == Dot) { 
        return ".";
      } else if (base == End) {
        return "$";
      } else if (base == WordBoundary) { 
        return "\\b";
      } else if (base == Digit) {
        return "\\d";
      } else if(base == Space) {
        return "\\s";
      } else if (base == Word) {
        return "\\w";
      } else {
        return bubble();
      }
    }
    else -> return bubble();
  }
}

export let bogusMatch(): Match {
  let bogusEnd = String.begin;
  {
    full: { name: "", value: "", begin: bogusEnd, end: bogusEnd },
    groups: new Map<String, Group>([]),
  }
}

export let chr(i: Int): String | Bubble {
  return String.fromCodePoint(i);
}
