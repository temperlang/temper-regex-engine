
let {...} = import("./regex");

export let chr(i: Int): String {
  return "#${i.toString()}";
}

export let regexToString(base: TemperRegex, chr: fn(Int): String): String {
  match (base) {
    is TemperCapture -> do {
      var regex = base.as<TemperCapture>();
      return "(?${regex.name}=${regexToString(regex.item, chr)})";
    }
    is TemperCodePoints -> do {
      var regex = base.as<TemperCodePoints>();
      return regex.value;
    }
    is TemperCodeSet -> do {
      var regex = base.as<TemperCodeSet>();
      var ret = new ListBuilder<String>();
      for (var j = 0; j < regex.items.length; j++) {
        var subBase = regex.items[j];
        match (subBase) {
          is TemperCodeRange -> do {
            var subTemperRegex = subBase.as<TemperCodeRange>();
            ret.add("${chr(subTemperRegex.min)}-${chr(subTemperRegex.max)}");
          }
          is TemperCodePoints -> do {
            var subTemperRegex = subBase.as<TemperCodePoints>();
            ret.add(subTemperRegex.value);
          }
        }
      }
      return "[${ret.join("", fn(s: String): String{s})}]";
    }
    is TemperOr -> do {
      var regex = base.as<TemperOr>();
      var ret = new MapBuilder<String, Boolean>();
      let add(ent: TemperRegex): Void {
        match (ent) {
          is TemperOr -> do {
            for (var i = 0; i < ent.items.length; i++) {
              add(ent.items[i]);
            }
          }
          else -> do {
            ret[regexToString(ent, chr)] = true;
          }
        }
      }
      for (var i = 0; i < regex.items.length; i++) {
        add(regex.items[i]);
      }
      return ret.toList().join("|", fn(p: Pair<String, Boolean>): String {
        return p.key;
      });
    }
    is TemperRepeat -> do {
      var regex = base.as<TemperRepeat>();
      var mod = if (regex.min == 0 && regex.max == 1) {
        "?"
      } else if (regex.min == 0 && regex.max == null) {
        "*"
      } else if (regex.min == 1 && regex.max == null) {
        "+"
      } else if (regex.min == regex.max) {
        "{${regex.min.toString()}}"
      } else if (regex.max == null) {
        "{${regex.min.toString()},}"
      } else {
        "{${regex.min.toString()},${regex.max.as<Int>().toString()}}"
      };
      var q = if (regex.reluctant) {
        "?"
      } else {
        ""
      };
      var str = regexToString(regex.item, chr);
      var pat = "%";
      match (regex.item) {
        is TemperCodeSet -> do {
          pat = str;
        }
        is TemperCodePoints -> do {
          var points = regex.item.as<TemperCodePoints>();
          if (points.value.split("").length == 1) {
            pat = str;
          } else {
            pat = "(${str})";
          }
        }
        else -> do {
          pat = "(${str})";
        }
      }
      return "${pat}${mod}${q}";
    }
    is TemperSequence -> do {
      var regex = base.as<TemperSequence>();
      if (regex.items.length == 0) {
        return "";
      } else if (regex.items.length == 1) {
        return regexToString(regex.items[0], chr);
      } else {
        let rec(r: TemperRegex): String {
          return regexToString(r, chr);
        }
        var inner = regex.items.join("", rec);
        for (var i = 0; i < regex.items.length; i++) {
          match (regex.items[i]) {
            is TemperOr -> return "(${inner})";
          }
        }
        return inner;
      }
    }
    is TemperSpecial -> do {
      var regex = base.as<TemperSpecial>();
      if (regex == TemperBegin) {
        return "^";
      } else if (regex == TemperDot) { 
        return ".";
      } else if (regex == TemperEnd) {
        return "$";
      } else if (regex == TemperWordBoundary) { 
        return "\\b";
      } else if (regex == TemperDigit) {
        return "\\d";
      } else if(regex == TemperSpace) {
        return "\\s";
      } else if (regex == TemperWord) {
        return "\\w";
      } else {
        return bubble();
      }
    }
    else -> return bubble();
  }
}
