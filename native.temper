
let { ... } = import("std/regex");
let { ... } = import("./regex");
let { ... } = import("./util");

export class TemperRegexNative(@noProperty re: RegexNode) extends TemperRegex {
  public data: Regex = new Regex(re);

  public split(text: String): Listed<String> {
    return data.split(text);
  }

  public replace(text: String, format: fn(Match): String): String {
    return data.replace(text, format);
  }

  public found(text: String): Boolean {
    return data.found(text);
  }

  public find(text: String, begin: StringIndex = String.begin): Match {
    return data.find(text, begin) orelse bogusMatch();
  }
}
