
let {...} = import("std/regex");
let { TemperRegex } = import("./regex");

let CodePoint = Int;
let Id = Int;

let ord(s: String): CodePoint {
  return s.codePoints.read();
}

class Next {
  public toState: State;
  public matcher: Matcher;
}

class State {
  public id: Id;
  public next: ListBuilder<Next>;
  
  public constructor(identify: Id): Void {
    id = identify; 
    next = new ListBuilder<Next>();
  }

  public addNext(matcher: Matcher, toState: State): Void {
    next.add(new Next(toState, matcher));
  }

  public addNextFirst(matcher: Matcher, toState: State): Void {
    var oldNext = next;
    next = new ListBuilder<Next>();
    next.add(new Next(toState, matcher));
    for (var i = 0; i < oldNext.length; i++) {
      next.add(oldNext[i]);
    }
  }
}

interface Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean;

  public toString(): String;
}

class BeginMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index == 0;
  }

  public toString(): String {
    return "BeginMatcher()";
  }
}

class WordBoundaryMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code1 = str.getOr(index-1, -1);
    var code2 = str.getOr(index, -1);
    var isWord1 = (48 <= code1 && code1 <= 57) || (65 <= code1 && code1 <= 90) || (97 <= code1 && code1 <= 122);
    var isWord2 = (48 <= code2 && code2 <= 57) || (65 <= code2 && code2 <= 90) || (97 <= code2 && code2 <= 122);
    return isWord1 != isWord2;
  }
}

class WordClassMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return (48 <= code && code <= 57) // this range is 0 to 9, like above
      || (65 <= code && code <= 90)   // this range is A to Z (uppercase)
      || (97 <= code && code <= 122)  // this range is a to z (lowercase)
  }

  public toString(): String {
    return "BeginMatcher()";
  }
}

class SpaceClassMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return code == 9 || code == 10 || code == 11 || code == 13 || code == 32;
  }

  public toString(): String {
    return "SpaceClassMatcher()";
  }
}

class EndMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index == str.length;
  }

  public toString(): String {
    return "EndMatcher()";
  }
}

class AnyMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index != str.length;
  }

  public toString(): String {
    return "AnyMatcher()";
  }
}

class RangeMatcher extends Matcher {
  public low: CodePoint;
  public high: CodePoint;

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return low <= c && c <= high;
  }

  public toString(): String {
    return "RangeMatcher(low = ${low.toString()}, high = ${high.toString()})";
  }
}

class CharMatcher extends Matcher {
  public code: CodePoint;
  
  public constructor(str: String): Void {
    code = ord(str);
  }

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return c == code;
  }

  public toString(): String {
    return "CharMatcher(code = ${code.toString()})";
  }
}

class EpsilonMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return true;
  }

  public toString(): String {
    return "Epsilon()";
  }
}

interface Stack {
  public index: Int;
  public state: State;
  public get next(): Stack;
}

class StackStart extends Stack {
  public index: Int;
  public state: State;

  public constructor(): Void {
    index = -1;
    state = new State(-1);
  }
  
  public get next(): Stack {
    return this;
  }
}

class StackSlot extends Stack {
  public index: Int;
  public state: State;
  public slot: Stack;

  public get next(): Stack {
    return slot;
  }
}

class Engine {
  public states: ListBuilder<State>;
  public startState: State;
  public endState: State;
  public epsilon: EpsilonMatcher;

  public constructor() {
    states = new ListBuilder<State>();
    startState = newState();
    endState = newState();
    epsilon = new EpsilonMatcher();
  }

  public newState(): State {
    var ret = new State(states.length);
    states.add(ret);
    return ret;
  }

  public matches(str: String): Boolean {
    var codePoints = str.split("").map(ord);
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = 0; i < codePoints.length; i += 1) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          return true;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          if (matcher == epsilon) {
            stack = new StackSlot(index, toState, stack);
          } else if (matcher.matches(codePoints, index)) {
            stack = new StackSlot(index + 1, toState, stack);
          }
        }
      }
    }
    return false;
  }
}

export class TemperRegexGraphs extends TemperRegex {
  public engine: Engine;
  
  public constructor(regex: Regex): Void {
    engine = new Engine();
    buildRegex(regex, engine.startState, engine.endState);
  }

  public buildRegex(regex: Regex, input: State, output: State): Void | Bubble {
    match (regex) {
      is Capture -> do {
        console.log("Capture");
        bubble();
      }
      is CodePoints -> do {
        var split = regex.value.split("");
        var lastState = input;
        for (var i = 0; i < split.length ; i++) {
          var curState = engine.newState();
          lastState.addNext(new CharMatcher(split[i]), curState);
          lastState = curState;
        }
        lastState.addNext(engine.epsilon, output);
      }
      is CodeSet -> do {
        for (var j = 0; j < regex.items.length; j++) {
          var subRegex = regex.items[j];
          match (subRegex) {
            is CodeRange -> do {
              input.addNext(new RangeMatcher(subRegex.min, subRegex.max), output);
            }
            is CodePoints -> do {
              var split = subRegex.value.split("");
              for (var i = 0; i < split.length ; i++) {
                var nextState = engine.newState();
                input.addNext(new CharMatcher(split[i]), nextState);
                nextState.addNext(engine.epsilon, output);
              }
            }
          }
        }
      }
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          var nextTryState = engine.newState();
          input.addNext(engine.epsilon, nextTryState);
          buildRegex(regex.items[i], nextTryState, output)
        }
      }
      is Repeat -> do {
        var lastState = input;
        for (var i = 0; i < regex.min; i++) {
          var curState = engine.newState();
          buildRegex(regex.item, lastState, curState);
          lastState = curState;
        }
        var max = regex.max;
        if (max != null) {
          var maxNoNull = max.as<Int>();
          for (var i = regex.min; i < maxNoNull; i++) {
            var curState = engine.newState();
            if (regex.reluctant) {
              curState.addNext(engine.epsilon, output);
              buildRegex(regex.item, lastState, curState);
            } else {
              buildRegex(regex.item, lastState, curState);
              curState.addNext(engine.epsilon, output);
            }
            lastState = curState;
          }
        } else {
          buildRegex(regex.item, input, output);
          if (regex.reluctant) {
            output.addNextFirst(engine.epsilon, input);
          } else {
            output.addNext(engine.epsilon, input);
          }
        }
      }
      is Sequence -> do {
        var lastState = input;
        for (var j = 0; j < regex.items.length; j++) {
          var curState = engine.newState();
          buildRegex(regex.items[j], lastState, curState);
          lastState = curState;
        }
        lastState.addNext(engine.epsilon, output);
      }
      is Special -> do {
        if (regex == Begin) {
          input.addNext(new BeginMatcher(), output);
        } else if (regex == Dot) { 
          input.addNext(new AnyMatcher(), output);
        } else if (regex == End) {
          input.addNext(new EndMatcher(), output);
        } else if (regex == WordBoundary) { 
          input.addNext(new WordBoundaryMatcher(), output);
        } else if (regex == Digit) {
          input.addNext(new RangeMatcher(48, 57), output);
        } else if(regex == Space) {
          input.addNext(new SpaceClassMatcher(), output);
        } else if (regex == Word) {
          input.addNext(new WordClassMatcher(), output);
        } else {
          bubble();
        }
      }
    }
  }

  public found(str: String): Boolean {
    return engine.matches(str);
  }
}
