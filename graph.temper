
let {...} = import("std/regex");
let { TemperRegex } = import("./regex");

let CodePoint = Int;
let Id = Int;

let ord(s: String): CodePoint {
  return s.codePoints.read();
}

class Next {
  public toState: State;
  public matcher: Matcher;
}

class State {
  public id: Id;
  public next: ListBuilder<Next>;
  
  public constructor(identify: Id): Void {
    id = identify; 
    next = new ListBuilder<Next>();
  }

  public addNext(matcher: Matcher, toState: State): Void {
    next.add(new Next(toState, matcher));
  }

  public addNextFirst(matcher: Matcher, toState: State): Void {
    var oldNext = next;
    next = new ListBuilder<Next>();
    next.add(new Next(toState, matcher));
    for (var i = 0; i < oldNext.length; i++) {
      next.add(oldNext[i]);
    }
  }
}

interface Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean;

  public toString(): String;
}

class BeginMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index == 0;
  }

  public toString(): String {
    return "^";
  }
}

class WordBoundaryMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code1 = str.getOr(index-1, -1);
    var code2 = str.getOr(index, -1);
    var isWord1 = (48 <= code1 && code1 <= 57) || (65 <= code1 && code1 <= 90) || (97 <= code1 && code1 <= 122);
    var isWord2 = (48 <= code2 && code2 <= 57) || (65 <= code2 && code2 <= 90) || (97 <= code2 && code2 <= 122);
    return isWord1 != isWord2;
  }
}

class WordClassMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return (48 <= code && code <= 57) // this range is 0 to 9, like above
      || (65 <= code && code <= 90)   // this range is A to Z (uppercase)
      || (97 <= code && code <= 122)  // this range is a to z (lowercase)
  }

  public toString(): String {
    return "\\w";
  }
}

class SpaceClassMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return code == 9 || code == 10 || code == 11 || code == 13 || code == 32;
  }

  public toString(): String {
    return "\\s";
  }
}

class EndMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index == str.length;
  }

  public toString(): String {
    return "$";
  }
}

class AnyMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index != str.length;
  }

  public toString(): String {
    return ".";
  }
}

class RangeMatcher extends Matcher {
  public low: CodePoint;
  public high: CodePoint;

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return low <= c && c <= high;
  }

  public toString(): String {
    return "[\\x${low.toString()}-\\x${high.toString()}]";
  }
}

class CharMatcher extends Matcher {
  public char: String;
  public code: CodePoint;
  
  public constructor(str: String): Void {
    char = str;
    code = ord(str);
  }

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return c == code;
  }

  public toString(): String {
    return char;
  }
}

class EpsilonMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return true;
  }

  public toString(): String {
    return "ε";
  }
}

interface Stack {
  public index: Int;
  public state: State;
  public get next(): Stack;
}

class StackStart extends Stack {
  public index: Int;
  public state: State;

  public constructor(): Void {
    index = -1;
    state = new State(-1);
  }
  
  public get next(): Stack {
    return this;
  }
}

class StackSlot extends Stack {
  public index: Int;
  public state: State;
  public slot: Stack;

  public get next(): Stack {
    return slot;
  }
}

class Engine {
  public states: ListBuilder<State>;
  public startState: State;
  public endState: State;
  public epsilon: EpsilonMatcher;

  public constructor() {
    states = new ListBuilder<State>();
    startState = newState();
    endState = newState();
    epsilon = new EpsilonMatcher();
  }

  public opt(): Engine {
    return optEpsilonEllison();
  }

  public optEpsilonEllison(): Engine {
    var unopt = this;
    var opt = new Engine();
    var map = new MapBuilder<Id, Id>();

    let visit(state: State): State {
      var optId = map[state.id] orelse -1;
      if (optId >= 0) {
        return opt.states[optId];
      }
      var outState: State = if (state == unopt.startState) {
        opt.startState
      } else if (state == unopt.endState) {
        opt.endState
      } else {
        opt.newState()
      }
      map[state.id] = outState.id;

      var added = new DenseBitVector(0);

      let add(matcher: Matcher, toState: State): Void {
        if (added[toState.id]) {
          return;
        }
        added[toState.id] = true;
        if (matcher == unopt.epsilon) {
          for (var i = 0; i < toState.next.length; i++) {
            var next = toState.next[i];
            add(next.matcher, next.toState);
          }
        } else {
          outState.addNext(matcher, visit(toState));
        }
      }

      for (var i = 0; i < state.next.length; i++) {
        var next = state.next[i];
        add(next.matcher, next.toState);
      }
      return outState;
    }

    visit(startState);

    return opt;
  }

  public newState(): State {
    var ret = new State(states.length);
    states.add(ret);
    return ret;
  }

  public matches(str: String): Boolean {
    var codePoints = str.split("").map(ord);
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = 0; i < codePoints.length; i += 1) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          return true;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          if (matcher == epsilon) {
            stack = new StackSlot(index, toState, stack);
          } else if (matcher.matches(codePoints, index)) {
            stack = new StackSlot(index + 1, toState, stack);
          }
        }
      }
    }
    return false;
  }

  public toString(): String {
    var count = 0;
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        return "\n  ${name} -> q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    })
    return "digraph {\n  rankdir=\"LR\";${inner}\n}";
  }
}

export class TemperRegexNFA extends TemperRegex {
  public engine: Engine;
  
  public constructor(regex: Regex): Void {
    engine = new Engine();
    buildRegex(regex, engine.startState, engine.endState);
    engine = engine.opt();
  }

  public buildRegex(regex: Regex, input: State, output: State): Void | Bubble {
    match (regex) {
      is Capture -> do {
        console.log("Capture");
        bubble();
      }
      is CodePoints -> do {
        var split = regex.value.split("");
        var lastState = input;
        for (var i = 0; i < split.length ; i++) {
          if (i == split.length - 1) {
            lastState.addNext(new CharMatcher(split[i]), output);
          } else {
            var curState = engine.newState();
            lastState.addNext(new CharMatcher(split[i]), curState);
            lastState = curState;
          }
        }
      }
      is CodeSet -> do {
        for (var j = 0; j < regex.items.length; j++) {
          var subRegex = regex.items[j];
          match (subRegex) {
            is CodeRange -> do {
              input.addNext(new RangeMatcher(subRegex.min, subRegex.max), output);
            }
            is CodePoints -> do {
              var split = subRegex.value.split("");
              for (var i = 0; i < split.length ; i++) {
                input.addNext(new CharMatcher(split[i]), output);
              }
            }
          }
        }
      }
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          buildRegex(regex.items[i], input, output)
        }
      }
      is Repeat -> do {
        var lastState = input;
        for (var i = 0; i < regex.min; i++) {
          var curState = engine.newState();
          buildRegex(regex.item, lastState, curState);
          lastState = curState;
        }
        var max = regex.max;
        if (max != null) {
          var maxNoNull = max.as<Int>();
          for (var i = regex.min; i < maxNoNull; i++) {
            var curState = if (i == maxNoNull - 1) {
              engine.newState()
            } else {
              output
            };
            if (regex.reluctant) {
              curState.addNext(engine.epsilon, output);
              buildRegex(regex.item, lastState, output);
            } else {
              buildRegex(regex.item, lastState, output);
              curState.addNext(engine.epsilon, output);
            }
            lastState = curState;
          }
        } else {
          buildRegex(regex.item, input, input);
          if (regex.reluctant) {
            input.addNextFirst(engine.epsilon, output);
          } else {
            input.addNext(engine.epsilon, output);
          }
        }
      }
      is Sequence -> do {
        var lastState = input; 
        for (var j = 0; j < regex.items.length; j++) {
          if (j == regex.items.length - 1) {
            buildRegex(regex.items[j], lastState, output);
          } else {
            var curState = engine.newState();
            buildRegex(regex.items[j], lastState, curState);
            lastState = curState;
          }
        }
      }
      is Special -> do {
        if (regex == Begin) {
          input.addNext(new BeginMatcher(), output);
        } else if (regex == Dot) { 
          input.addNext(new AnyMatcher(), output);
        } else if (regex == End) {
          input.addNext(new EndMatcher(), output);
        } else if (regex == WordBoundary) { 
          input.addNext(new WordBoundaryMatcher(), output);
        } else if (regex == Digit) {
          input.addNext(new RangeMatcher(48, 57), output);
        } else if(regex == Space) {
          input.addNext(new SpaceClassMatcher(), output);
        } else if (regex == Word) {
          input.addNext(new WordClassMatcher(), output);
        } else {
          bubble();
        }
      }
    }
  }

  public found(str: String): Boolean {
    return engine.matches(str);
  }

  public toString(): String {
    return engine.toString();
  }
}

let toVec(ls: List<Int>, size: Int): DenseBitVector {
  var vec = new DenseBitVector(size);
  for (var i = 0; i < ls.length; i++) {
    vec.set(ls[i], true);
  }
  return vec;
}

class TableEntry {
  public key: DenseBitVector;
  public val: List<DenseBitVector>;
}

class Table {
  public nsyms: Int;
  public table: ListBuilder<TableEntry>;

  public constructor(size: Int) {
    nsyms = size;
    table = new ListBuilder<TableEntry>();
  }

  public get(key: DenseBitVector): TableEntry | Bubble {
    outer: for (var i = 0; i < table.length; i++) {
      var cur = table[i];
      var ret = true;
      for (var j = 0; j < nsyms; j++) {
        if (key[j] != cur.key[j]) {
          ret = false;
          break;
        }
      }
      if (ret) {
        return cur;
      }
    }
    return bubble();
  }

  public add(keyList: List<Int>, valList: List<List<Int>>): Void {
    var key = toVec(keyList, nsyms);
    var val = valList.map(fn(val: List<Int>): DenseBitVector {
      return toVec(val, nsyms);
    });
    var ent: TableEntry = this[key] orelse do {
      var newKey = new TableEntry(key, val);
      table.add(newKey);
      return;
    };
    for (var i = 0; i < val.length; i++) {
      var entn = ent.val[i];
      var valn = val[i];
      for (var j = 0; j < nsyms; j++) {
        if (valn[j]) {
          entn[j] = true;
        }
      }
    }
  }
}

export class TemperRegexDFA extends TemperRegex {
  public nsyms: Int;
  public symbols: MapBuilder<CodePoint, Int>;
  public table: Table;

  public addCodePoint(c: CodePoint): Void {
    symbols[c] = symbols[c] orelse nsyms++;
  }

  public addCodePointRange(min: CodePoint, max: CodePoint): Void {
    for (var i = min; i <= max; i++) {
      addCodePoint(i);
    }
  }

  public constructor(regex: Regex): Void {
    nsyms = 0;
    symbols = new MapBuilder<CodePoint, Int>()

    var nfa = new TemperRegexNFA(regex);
    var engine = nfa.engine;

    for (var i = 0; i < engine.states.length; i++) {
      var state = engine.states[i];
      for (var j = 0; j < state.next.length; j++) {
        addSymbolsFrom(state.next[j]);
      }
    }

    table = new Table(nsyms);
  }

  public addSymbolsFrom(next: Next): Void {
    match (next) {
      is WordClassMatcher -> do {
        addCodePointRange(48, 57);
        addCodePointRange(65, 90);
        addCodePointRange(97, 122);
      }
      is SpaceClassMatcher -> do {
        addCodePoint(9);
        addCodePoint(10);
        addCodePoint(11);
        addCodePoint(13);
        addCodePoint(32);
      }
      is RangeMatcher -> do {
        addCodePointRange(next.low, next.high);
      }
      is CharMatcher -> do {
        addCodePoint(next.code);
      }
      is AnyMatcher -> do {}
      is EpsilonMatcher -> do {}
      is WordBoundaryMatcher -> do {
        console.log("WordBoundaryMatcher");
        bubble();
      }
      is EndMatcher -> do {
        console.log("EndMatcher");
        bubble();
      }
      is BeginMatcher -> do {
        console.log("BeginMatcher");
        bubble();
      }
    }
  }

  public found(str: String): Boolean {
    return false;
  }
}
