
let {...} = import("std/regex");
let { TemperRegex } = import("./regex");

let CodePoint = Int;
let Id = Int;

let ord(s: String): CodePoint {
  return s.codePoints.read();
}

class Next {
  public toState: State;
  public matcher: Matcher;
}

class State {
  public id: Id;
  public next: ListBuilder<Next>;
  
  public constructor(identify: Id): Void {
    id = identify; 
    next = new ListBuilder<Next>();
  }

  public addNext(matcher: Matcher, toState: State): Void {
    next.add(new Next(toState, matcher));
  }

  public addNextFirst(matcher: Matcher, toState: State): Void {
    var oldNext = next;
    next = new ListBuilder<Next>();
    next.add(new Next(toState, matcher));
    for (var i = 0; i < oldNext.length; i++) {
      next.add(oldNext[i]);
    }
  }
}

interface Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean;

  public toString(): String;
}

class BeginMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index == 0;
  }

  public toString(): String {
    return "^";
  }
}

class WordBoundaryMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code1 = str.getOr(index-1, -1);
    var code2 = str.getOr(index, -1);
    var isWord1 = (48 <= code1 && code1 <= 57) || (65 <= code1 && code1 <= 90) || (97 <= code1 && code1 <= 122);
    var isWord2 = (48 <= code2 && code2 <= 57) || (65 <= code2 && code2 <= 90) || (97 <= code2 && code2 <= 122);
    return isWord1 != isWord2;
  }
}

class WordClassMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return (48 <= code && code <= 57) // this range is 0 to 9, like above
      || (65 <= code && code <= 90)   // this range is A to Z (uppercase)
      || (97 <= code && code <= 122)  // this range is a to z (lowercase)
  }

  public toString(): String {
    return "\\w";
  }
}

class SpaceClassMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    var code = str.getOr(index, -1);
    return code == 9 || code == 10 || code == 11 || code == 13 || code == 32;
  }

  public toString(): String {
    return "\\s";
  }
}

class EndMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index == str.length;
  }

  public toString(): String {
    return "$";
  }
}

class AnyMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return index != str.length;
  }

  public toString(): String {
    return ".";
  }
}

class RangeMatcher extends Matcher {
  public low: CodePoint;
  public high: CodePoint;

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return low <= c && c <= high;
  }

  public toString(): String {
    return "[\\x${low.toString()}-\\x${high.toString()}]";
  }
}

class CharCodeMatcher extends Matcher {
  public code: CodePoint;

  public constructor(point: CodePoint): Void {
    code = point;
  }

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return c == code;
  }

  public toString(): String {
    return "#${code.toString()}";
  }
}

class CharMatcher extends Matcher {
  public char: String;
  public code: CodePoint;
  
  public constructor(str: String): Void {
    char = str;
    code = ord(str);
  }

  public matches(str: List<CodePoint>, index: Int): Boolean {
    var c = str.getOr(index, -1);
    return c == code;
  }

  public toString(): String {
    return char;
  }
}

class EpsilonMatcher extends Matcher {
  public matches(str: List<CodePoint>, index: Int): Boolean {
    return true;
  }

  public toString(): String {
    return "ε";
  }
}

interface Stack {
  public index: Int;
  public state: State;
  public get next(): Stack;
}

class StackStart extends Stack {
  public index: Int;
  public state: State;

  public constructor(): Void {
    index = -1;
    state = new State(-1);
  }
  
  public get next(): Stack {
    return this;
  }
}

class StackSlot extends Stack {
  public index: Int;
  public state: State;
  public slot: Stack;

  public get next(): Stack {
    return slot;
  }
}

class Engine {
  public states: ListBuilder<State>;
  public startState: State;
  public endState: State;
  public epsilon: EpsilonMatcher;

  public constructor() {
    states = new ListBuilder<State>();
    startState = newState();
    endState = newState();
    epsilon = new EpsilonMatcher();
  }

  public opt(): Engine {
    return optEpsilonEllison();
  }

  public optEpsilonEllison(): Engine {
    var unopt = this;
    var opt = new Engine();
    var map = new MapBuilder<Id, Id>();

    let visit(state: State): State {
      var optId = map[state.id] orelse -1;
      if (optId >= 0) {
        return opt.states[optId];
      }
      var outState: State = if (state == unopt.startState) {
        opt.startState
      } else if (state == unopt.endState) {
        opt.endState
      } else {
        opt.newState()
      }
      map[state.id] = outState.id;

      var complete = new DenseBitVector(0);

      let add(matcher: Matcher, toState: State): Void {
        if (matcher == unopt.epsilon) {
          if (complete[toState.id]) {
            return;
          }
          complete[toState.id] = true;
          for (var i = 0; i < toState.next.length; i++) {
            var next = toState.next[i];
            add(next.matcher, next.toState);
          }
        } else {
          outState.addNext(matcher, visit(toState));
        }
      }

      for (var i = 0; i < state.next.length; i++) {
        var next = state.next[i];
        add(next.matcher, next.toState);
      }
      return outState;
    }

    visit(startState);

    return opt;
  }

  public newState(): State {
    var ret = new State(states.length);
    states.add(ret);
    return ret;
  }

  public matches(str: String): Boolean {
    var codePoints = str.split("").map(ord);
    var stackStart = new StackStart();
    var badNext = new Next(endState, epsilon);
    for (var i = 0; i < codePoints.length; i += 1) {
      var stack: Stack = new StackSlot(i, startState, stackStart);
      while (stack != stackStart) {
        var index = stack.index;
        var state = stack.state;
        stack = stack.next;
        if (state.id == endState.id) {
          return true;
        }
        var next = state.next;
        var len =  next.length;
        out: for (var c = 0; c < len; c += 1) {
          let {matcher, toState} = next.getOr(c, badNext);
          if (matcher == epsilon) {
            stack = new StackSlot(index, toState, stack);
          } else if (matcher.matches(codePoints, index)) {
            stack = new StackSlot(index + 1, toState, stack);
          }
        }
      }
    }
    return false;
  }

  public toString(): String {
    var count = 0;
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        return "\n  ${name} -> q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    })
    return "digraph {\n  rankdir=\"LR\";${inner}\n}";
  }

  public toDotSub(gname: String, color: String): String {
    var count = 0;
    var used = new MapBuilder<Int, Boolean>();
    var inner = states.join("", fn(state: State): String {
      var name = "q${state.id.toString()}";
      used[state.id] = true;
      return state.next.join("", fn(next: Next): String {
        var line = count.toString();
        count++;
        var nexts = next.toState.id.toString();
        used[next.toState.id] = true;
        return "\n    ${gname}_${name} -> ${gname}_q${nexts} [label=\"${next.matcher.toString()}\"];";
      });
    });
    var decls = states.join("", fn(state: State): String {
      if (used[state.id] orelse false) {
        var name = "q${state.id.toString()}";
        return "\n    ${gname}_${name} [label=\"${name}\"];";
      } else {
        return "";
      }
    });
    return "subgraph ${gname} {\n    node [style=filled color=\"${color}\"];\n    color=\"#E7E7E7\";\n    label=\"NFA\";\n    rankdir=\"LR\";${decls}${inner}\n  }";
  }
}

export class TemperRegexNFA extends TemperRegex {
  public engine: Engine;
  
  public constructor(regex: Regex): Void {
    engine = new Engine();
    buildRegex(regex, engine.startState, engine.endState);
    engine = engine.opt();
  }

  public buildRegex(regex: Regex, input: State, output: State): Void | Bubble {
    // console.log("${input.id.toString()} -> /${regexToString(regex)}/ -> ${output.id.toString()}");
    match (regex) {
      is Capture -> do {
        console.log("Capture");
        bubble();
      }
      is CodePoints -> do {
        var split = regex.value.split("");
        var lastState = input;
        for (var i = 0; i < split.length ; i++) {
          if (i == split.length - 1) {
            lastState.addNext(new CharMatcher(split[i]), output);
          } else {
            var curState = engine.newState();
            lastState.addNext(new CharMatcher(split[i]), curState);
            lastState = curState;
          }
        }
      }
      is CodeSet -> do {
        for (var j = 0; j < regex.items.length; j++) {
          var subRegex = regex.items[j];
          match (subRegex) {
            is CodeRange -> do {
              input.addNext(new RangeMatcher(subRegex.min, subRegex.max), output);
            }
            is CodePoints -> do {
              var split = subRegex.value.split("");
              for (var i = 0; i < split.length ; i++) {
                input.addNext(new CharMatcher(split[i]), output);
              }
            }
          }
        }
      }
      is Or -> do {
        for (var i = 0; i < regex.items.length; i++) {
          buildRegex(regex.items[i], input, output)
        }
      }
      is Repeat -> do {
        var nextState = output;
        for (var j = regex.min - 1; j >= 0; j--) {
          var curState = engine.newState();
          buildRegex(regex.item, curState, nextState);
          nextState = curState;
        }
        if (regex.max != null) {
          for (var j = regex.max.as<Int>() - 1; j >= regex.min; j--) {
            var curState = engine.newState();
            curState.addNext(engine.epsilon, nextState);
            buildRegex(regex.item, curState, nextState);
            nextState = curState;
          }
        } else {
          var curState = engine.newState();
          curState.addNext(engine.epsilon, nextState);
          buildRegex(regex.item, curState, curState);
          nextState = curState;
        }
        input.addNext(engine.epsilon, nextState);
      }
      is Sequence -> do {
        var nextState = output; 
        for (var j = regex.items.length - 1; j >= 0; j--) {
          var curState = engine.newState();
          buildRegex(regex.items[j], curState, nextState);
          nextState = curState;
        }
        input.addNext(engine.epsilon, nextState);
      }
      is Special -> do {
        if (regex == Begin) {
          input.addNext(new BeginMatcher(), output);
        } else if (regex == Dot) { 
          input.addNext(new AnyMatcher(), output);
        } else if (regex == End) {
          input.addNext(new EndMatcher(), output);
        } else if (regex == WordBoundary) { 
          input.addNext(new WordBoundaryMatcher(), output);
        } else if (regex == Digit) {
          input.addNext(new RangeMatcher(48, 57), output);
        } else if(regex == Space) {
          input.addNext(new SpaceClassMatcher(), output);
        } else if (regex == Word) {
          input.addNext(new WordClassMatcher(), output);
        } else {
          bubble();
        }
      }
    }
  }

  public found(str: String): Boolean {
    return engine.matches(str);
  }

  public toString(): String {
    return engine.toString();
  }
}

let toVec(ls: List<Int>, size: Int): DenseBitVector {
  var vec = new DenseBitVector(0);
  for (var i = 0; i < ls.length; i++) {
    vec.set(ls[i], true);
  }
  return vec;
}

let fromVec(vec: DenseBitVector, size: Int): List<Int> {
  var key = new ListBuilder<Int>();
  for (var i = 0; i < size; i++) {
    if (vec[i]) {
      key.add(i);
    }
  }
  return key.toList();
}

class TransitionTableEntry {
  public key: DenseBitVector;
  public val: List<DenseBitVector>;

  public toMarkdownWith(nsyms: Int): String {
    var keyStr = fromVec(key, nsyms).join(",", fn(id: Int): String {
      return "q${id.toString()}";
    });
    var valStrs = val.join(" | ", fn(vec: DenseBitVector): String {
      var vec = fromVec(vec, nsyms);
      if (vec.length == 0) {
        return "-";
      } else {
        return vec.join(",", fn(id: Int): String {
          return "q${id.toString()}";
        });
      }
    });
    return "| ${keyStr} | ${valStrs} |"
  }

  public toDotWith(nsyms: Int): String {
    var keyStr = fromVec(key, nsyms).join("", fn(id: Int): String {
      return "q${id.toString()}";
    });
    var valStrs = val.join("", fn(vec: DenseBitVector): String {
      var vec = fromVec(vec, nsyms);
      if (vec.length == 0) {
        return "<TD>-</TD>";
      } else {
        return "<TD>${vec.join(",", fn(id: Int): String {
          return "q${id.toString()}";
        })}</TD>";
      }
    });
    return "<TR><TD>${keyStr}</TD>${valStrs}</TR>"
  }
}

class TransitionTable {
  public nsyms: Int;
  public table: ListBuilder<TransitionTableEntry>;

  public constructor(size: Int) {
    nsyms = size;
    table = new ListBuilder<TransitionTableEntry>();
  }

  public has(key: DenseBitVector): Boolean {
    return do { get(key); true } orelse false;
  }

  public get(key: DenseBitVector): TransitionTableEntry | Bubble {
    outer: for (var i = 0; i < table.length; i++) {
      var cur = table[i];
      var ret = true;
      for (var j = 0; j < nsyms; j++) {
        if (key[j] != cur.key[j]) {
          ret = false;
          break;
        }
      }
      if (ret) {
        return cur;
      }
    }
    return bubble();
  }

  public toMarkdownWith(map: MapBuilder<CodePoint, Int>): String {
    var l = map.toList();
    var size = nsyms;
    var inner = table.join("\n", fn(ent: TransitionTableEntry): String {
      return ent.toMarkdownWith(size);
    });
    var header = new ListBuilder<String>();
    header.add("state");
    for (var i = 0; i < nsyms; i++) {
      header.add("");
    }
    var ls = map.toList();
    for (var i = 0; i < ls.length; i++) {
      var ent = ls[i];
      header[ent.value + 1] = "#${ent.key.toString()}";
    }
    var noop = fn(s: String): String{s}
    var dash = fn(s: String): String{ "---" }
    return "\n|${header.join("|", noop)}|\n|${header.join("|", dash)}|\n${inner}\n"
  }

  public toDotWith(map: MapBuilder<CodePoint, Int>, color: String): String {
    var l = map.toList();
    var size = nsyms;
    var inner = table.join("", fn(ent: TransitionTableEntry): String {
      return ent.toDotWith(size);
    });
    var header = new ListBuilder<String>();
    header.add("<TD>state</TD>");
    for (var i = 0; i < nsyms; i++) {
      header.add("");
    }
    var ls = map.toList();
    for (var i = 0; i < ls.length; i++) {
      var ent = ls[i];
      header[ent.value + 1] = "<TD>#${ent.key.toString()}</TD>";
    }
    var noop = fn(s: String): String{s}
    var dash = fn(s: String): String{ "---" }
    return "<TABLE border=\"0\" cellspacing=\"5\" bgcolor=\"${color}\"><TR>${header.join("", noop)}</TR>${inner}</TABLE>"
  }
}

let isValidFor(next: Matcher, sym: Int): Boolean {
  return validFor(next)[sym];
}

let validFor(next: Matcher): DenseBitVector {
  var valid = new DenseBitVector(0);

  let validPoint(c: CodePoint): Void {
    valid[c] = true;
  }

  let validRange(min: CodePoint, max: CodePoint): Void {
    for (var i = min; i <= max; i++) {
      validPoint(i);
    }
  }

  match (next) {
    is WordClassMatcher -> do {
      validRange(48, 57);
      validRange(65, 90);
      validRange(97, 122);
    }
    is SpaceClassMatcher -> do {
      validPoint(9);
      validPoint(10);
      validPoint(11);
      validPoint(13);
      validPoint(32);
    }
    is RangeMatcher -> do {
      validRange(next.low, next.high);
    }
    is CharMatcher -> do {
      validPoint(next.code);
    }
    is CharCodeMatcher -> do {
      validPoint(next.code);
    }
    is AnyMatcher -> do {}
    is EpsilonMatcher -> do {}
    is WordBoundaryMatcher -> do {
      console.log("WordBoundaryMatcher");
      bubble();
    }
    is EndMatcher -> do {
      console.log("EndMatcher");
      bubble();
    }
    is BeginMatcher -> do {
      console.log("BeginMatcher");
      bubble();
    }
  }
  return valid;
}

var emptyList = [];

let mapToList<T>(map: Map<Int, T>, defaultValue: T): List<T> {
  var ls = map.toList();
  var max = 0;
  for (var i = 0; i < ls.length; i++) {
    var key = ls[i].key;
    if (key > max) {
      max = key;
    }
  }
  var ret = new ListBuilder<T>();
  for (var i = 0; i <= max; i++) {
    ret.add(map[i] orelse defaultValue);
  }
  return ret.toList();
}

export class TemperRegexDFA extends TemperRegex {
  public nsyms: Int;
  public symbols: MapBuilder<CodePoint, Int>;
  public table: TransitionTable;
  public map: List<List<Int>>;
  public final: List<Boolean>;
  public nfa: Engine;

  public get nstates(): Int {
    return nfa.states.length;
  }

  public constructor(regex: Regex): Void {
    nsyms = 0;
    symbols = new MapBuilder<CodePoint, Int>();
    nfa = new TemperRegexNFA(regex).engine;
    table = new TransitionTable(nstates);

    for (var i = 0; i < nstates; i++) {
      var state = nfa.states[i];
      for (var j = 0; j < state.next.length; j++) {
        addSymbolsFrom(state.next[j].matcher);
      }
    }

    var pairs = symbols.toList();

    for (var i = 0; i < nstates; i++) {
      var state = nfa.states[i];
      var val = new ListBuilder<DenseBitVector>();
      for (var j = 0; j < nsyms; j++) {
        var cur = new ListBuilder<Int>();
        for (var k = 0; k < state.next.length; k++) {
          var next = state.next[k];
          if (isValidFor(next.matcher, pairs[j].key)) {
            cur.add(next.toState.id);
          }
        }
        val.add(toVec(cur.toList(), nstates));
      }
      var ent = new TransitionTableEntry(toVec([state.id], nstates), val.toList());
      table.table.add(ent);
    }

    for (var i = 0; i < nstates; i++) {
      buildTable(table.table[i], nstates);
    }

    var index = new MapBuilder<String, Int>();
    index[""] = 0;
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var name = nameFor(tent.key);
      if (name == "") {
        continue;
      }
      index[nameFor(tent.key)] = i + 1;
    }

    var finalBuilder = new MapBuilder<Int, Boolean>();
    for (var i = 0; i < table.table.length + 1; i++) {
      finalBuilder[i] = true;
    }
    var mapBuilder = new MapBuilder<Int, List<Int>>();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var subBuilder = new MapBuilder<CodePoint, Int>();
      for (var j = 0; j < nsyms; j++) {
        var value = index[nameFor(tent.val[j])];
        subBuilder[pairs[j].key] = value;
      }
      var ci = index[nameFor(tent.key)];
      finalBuilder[ci] = tent.key[1];
      mapBuilder[ci] = mapToList(subBuilder.toMap(), 0);
    }
    var finalBuilderList = new ListBuilder<Boolean>();
    for (var i = 0; i < table.table.length + 1; i++) {
      finalBuilderList.add(finalBuilder[i]);
    }
    final = finalBuilderList.toList();
    map = mapToList(mapBuilder.toMap(), []);
  }

  public addCodePoint(c: CodePoint): Void {
    symbols[c] orelse do {
      var newSym = nsyms;
      nsyms += 1;
      symbols[c] = newSym;
    };
  }

  public addCodePointRange(min: CodePoint, max: CodePoint): Void {
    for (var i = min; i <= max; i++) {
      addCodePoint(i);
    }
  }

  public nameFor(vec: DenseBitVector): String {
    return fromVec(vec, nstates).join("|", fn(s: Int): String {
      return s.toString();
    })
  }

  public buildEngine(): Engine {
    var nstates = nfa.states.length;

    var index = new MapBuilder<String, Int>();
    index[""] = -1;
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var name = nameFor(tent.key);
      if (name == "") {
        continue;
      }
      index[nameFor(tent.key)] = i;
    }

    var dfa = new Engine();
    var dfaStates = new ListBuilder<State>();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var isFinal = true;
      for (var j = 0; j < nsyms; j++) {
        var value = index[nameFor(tent.val[j])];
        if (value != -1) {
          isFinal = false;
        }
      }
      if (i == 0) {
        dfaStates.add(dfa.startState);
      } else if (isFinal) {
        dfaStates.add(dfa.endState);
      } else {
        dfaStates.add(dfa.newState());
      }
    }

    var pairs = symbols.toList();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var state = dfaStates[i];
      var isFinal = true;
      for (var j = 0; j < nsyms; j++) {
        var value = index[nameFor(tent.val[j])];
        if (value != -1) {
          state.addNext(new CharCodeMatcher(pairs[j].key), dfaStates[value]);
          isFinal = false;
        }
      }
    }
    return dfa.opt();
  }

  let buildTable(tent: TransitionTableEntry, nstates: Int): Void {
    for (var i = 0; i < nsyms; i++) {
      var newKey = tent.val[i];
      if (fromVec(newKey, nstates).length >= 1 && !table.has(newKey)) {
        var allVals = new ListBuilder<DenseBitVector>();
        for (var j = 0; j < nsyms; j++) {
          var newVal = new DenseBitVector(0);
          for (var k = 0; k < nstates; k++) {
            if (newKey[k]) {
              var bv = table[toVec([k], nstates)].val[j];
              for (var l = 0; l < nstates; l++) {
                if (bv[l]) {
                  newVal[l] = true;
                }
              }
            }
          }
          allVals.add(newVal);
        }
        var ent = new TransitionTableEntry(newKey, allVals.toList());
        table.table.add(ent);
        buildTable(ent, nstates);
      }
    }
  }

  public addSymbolsFrom(next: Matcher): Void {
    match (next) {
      is WordClassMatcher -> do {
        addCodePointRange(48, 57);
        addCodePointRange(65, 90);
        addCodePointRange(97, 122);
      }
      is SpaceClassMatcher -> do {
        addCodePoint(9);
        addCodePoint(10);
        addCodePoint(11);
        addCodePoint(13);
        addCodePoint(32);
      }
      is RangeMatcher -> do {
        addCodePointRange(next.low, next.high);
      }
      is CharCodeMatcher -> do {
        addCodePoint(next.code);
      }
      is CharMatcher -> do {
        addCodePoint(next.code);
      }
      is AnyMatcher -> do {
        addCodePoint(9);
        addCodePoint(10);
        addCodePoint(11);
        addCodePoint(13);
        addCodePoint(32);
        addCodePointRange(32, 126);
      }
      is EpsilonMatcher -> do {}
      is WordBoundaryMatcher -> do {
        console.log("WordBoundaryMatcher");
        bubble();
      }
      is EndMatcher -> do {
        console.log("EndMatcher");
        bubble();
      }
      is BeginMatcher -> do {
        console.log("BeginMatcher");
        bubble();
      }
    }
  }

  public foundAfter(slice: CodePointStringSlice): Boolean {
    var state = 1;
    while (true) {
      if (final.getOr(state, true)) {
        return state != 0;
      }
      if (slice.isEmpty) {
        return false;
      }
      state = map.getOr(state, emptyList).getOr(slice.read(), 0);
      slice = slice.advance(1);
    }
  }

  public found(str: String): Boolean {
    var slice = str.codePoints;
    while (true) {
      if (foundAfter(slice)) {
        return true;
      }
      if (slice.isEmpty) {
        return false;
      }
      slice = slice.advance(1);
    }
  }

  public toMarkdownTable(): String {
    return table.toMarkdownWith(symbols);
  }

  public toDot(): String {
    var nfaDot = nfa.toDotSub("nfa", "#E0E0FF");
    var tableDot = table.toDotWith(symbols, "#E0FFFF");
    var dfaDot = buildEngine().toDotSub("dfa", "#E0FFE0");
    return "digraph {\n  ${nfaDot}\n  table[shape=none label=<${tableDot}>];\n  ${dfaDot}\n}\n";
  }

  public toLua(chr: fn(Int): String, isMatch: fn(String, String): Boolean): TemperRegexLua {
    return new TemperRegexLua(toRegexList(chr).map(regexToString), isMatch);
  }

  public toRegex(chr: fn(Int): String): Regex {
    return new Or(toRegexList(chr));
  }

  public toRegexList(chr: fn(Int): String): List<Regex> {
    var builder = new RegexBuilder();
    var syms = symbols.toList();
    for (var i = 0; i < table.table.length; i++) {
      var tent = table.table[i];
      var kname = nameFor(tent.key);
      if (kname == "") {
        continue;
      }
      var tmap = new MapBuilder<String, ListBuilder<Int>>();
      for (var j = 0; j < nsyms; j++) {
        var val = nameFor(tent.val[j]);
        var got = tmap[val] orelse new ListBuilder<Int>();
        if (val != "") {
          got.add(syms[j].key);
          tmap[val] = got;
        }
      }
      var ls = tmap.toList();
      if (i == 0) {
        builder.add("#begin", kname, new Sequence([]));
      } else if (tent.key[1]) {
        builder.add(kname, "#end", new Sequence([]));
      }
      for (var j = 0; j < ls.length; j++) {
        var points = new CodePoints(ls[j].value.join("", chr));
        if (ls[j].value.length == 1) {
          builder.add(kname, ls[j].key, points);
        } else {
          builder.add(kname, ls[j].key, new CodeSet([points]));
        }
      }
    }
    return builder.toRegexList();
  } 

  public toRegexString(chr: fn(Int): String): String {
    return regexToString(toRegex(chr));
  }
}

class TemperRegexLua extends TemperRegex {
  public tries: List<String>;
  public check: fn(String, String): Boolean;

  public constructor(strs: List<String>, isMatch: fn(String, String): Boolean): Void {
    tries = strs;
    check = isMatch;
  }

  public found(str: String): Boolean {
    for (var i = 0; i < tries.length; i++) {
      if (check(str, tries[i])) {
        return true;
      }
    }
    return false;
  }
}

let {regexToString} = import("./tostring.temper");

class RegexBuilderEdge {
  public from: String;
  public to: String;
  public regex: Regex;
}

class RegexBuilder {
  public list: ListBuilder<RegexBuilderEdge>;

  constructor(): Void {
    list = new ListBuilder<RegexBuilderEdge>();
  }

  public has(from: String, to: String): Boolean {
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.to == to && edge.from == from) {
        return true;
      }
    }
    return false;
  }

  public find(from: String, to: String): Regex | Bubble {
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.to == to && edge.from == from) {
        return edge.regex;
      }
    }
    return bubble();
  }

  public forEachWentFrom(to: String, cb: fn(RegexBuilderEdge): Void): Void {
    var ls = new ListBuilder<RegexBuilderEdge>();
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.to == to) {
        ls.add(edge);
      }
    }
    for (var i = 0; i < ls.length; i++) {
      cb(ls[i]);
    }
  }

  public forEachGoesTo(from: String, cb: fn(RegexBuilderEdge): Void): Void {
    var ls = new ListBuilder<RegexBuilderEdge>();
    for (var i = 0; i < list.length; i++) {
      var edge = list[i];
      if (edge.from == from) {
        ls.add(edge);
      }
    }
    for (var i = 0; i < ls.length; i++) {
      cb(ls[i]);
    }
  }

  public simplify(node: String): Void {
    var me = this;
    if (has(node, node)) {
      var self = find(node, node);
      me.forEachWentFrom(node, fn(wentFrom: RegexBuilderEdge): Void {
        me.forEachGoesTo(node, fn(goesTo: RegexBuilderEdge): Void {
          me.add(wentFrom.from, goesTo.to, new Sequence([wentFrom.regex, new Repeat(self, 0, null, false), goesTo.regex]));
        });
      });
    } else {
      me.forEachWentFrom(node, fn(wentFrom: RegexBuilderEdge): Void {
        me.forEachGoesTo(node, fn(goesTo: RegexBuilderEdge): Void {
          me.add(wentFrom.from, goesTo.to, new Sequence([wentFrom.regex, goesTo.regex]));
        });
      });
    }
  }

  public add(from: String, to: String, regex: Regex): Void {
    list.add(new RegexBuilderEdge(from, to, regex));
  }

  public toRegexList(): List<Regex> {
    var done = new MapBuilder<String, Boolean>();
    done["#begin"] = true;
    for (var j = 0; j < list.length; j++) {
      var cur = list[j];
      if (!(done[cur.from] orelse false)) {
        done[cur.from] = true;
        simplify(cur.from);
      }
    }
    // for (var j = 0; j < list.length; j++) {
    //   var cur = list[j];
    //   console.log("${cur.from} -> /${regexToString(cur.regex)}/ -> ${cur.to}");
    // }
    var ret = new ListBuilder<Regex>();
    for (var j = 0; j < list.length; j++) {
      var cur = list[j];
      if (cur.from == "#begin" && cur.to == "#end") {
        ret.add(cur.regex);
      }
    }
    return ret.toList();
  }
}
