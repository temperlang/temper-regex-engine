
let {...} = import("std/regex");

export let regexToString(base: RegexNode): String {
  match (base) {
    is Capture -> do {
      return "(?${base.name}=${regexToString(base.item)})";
    }
    is CodePoints -> do {
      return base.value;
    }
    is CodeSet -> do {
      var ret = new ListBuilder<String>();
      for (var j = 0; j < base.items.length; j++) {
        var subBase = base.items[j];
        match (subBase) {
          is CodeRange -> do {
            ret.add("${String.fromCodePoint(subBase.min)}-${String.fromCodePoint(subBase.max)}");
          }
          is CodePoints -> do {
            ret.add(subBase.value);
          }
        }
      }
      return "[${ret.join("", fn(s: String): String{s})}]";
    }
    is Or -> do {
      var ret = new MapBuilder<String, Boolean>();
      let add(ent: RegexNode): Void {
        match (ent) {
          is Or -> do {
            for (var i = 0; i < ent.items.length; i++) {
              add(ent.items[i]);
            }
          }
          else -> do {
            ret[regexToString(ent)] = true;
          }
        }
      }
      for (var i = 0; i < base.items.length; i++) {
        add(base.items[i]);
      }
      return ret.toList().join("|", fn(p: Pair<String, Boolean>): String {
        return p.key;
      });
    }
    is Repeat -> do {
      var mod = if (base.min == 0 && base.max == 1) {
        "?"
      } else if (base.min == 0 && base.max == null) {
        "*"
      } else if (base.min == 1 && base.max == null) {
        "+"
      } else if (base.min == base.max) {
        "{${base.min.toString()}}"
      } else if (base.max == null) {
        "{${base.min.toString()},}"
      } else {
        "{${base.min.toString()},${base.max.as<Int>().toString()}}"
      };
      var q = if (base.reluctant) {
        "?"
      } else {
        ""
      };
      var str = regexToString(base.item);
      var pat = "%";
      match (base.item) {
        is CodeSet -> do {
          pat = str;
        }
        is CodePoints -> do {
          var points = base.item.as<CodePoints>();
          if (points.value.split("").length == 1) {
            pat = str;
          } else {
            pat = "(${str})";
          }
        }
        else -> do {
          pat = "(${str})";
        }
      }
      return "${pat}${mod}${q}";
    }
    is Sequence -> do {
      if (base.items.length == 0) {
        return "";
      } else if (base.items.length == 1) {
        return regexToString(base.items[0]);
      } else {
        let rec(r: RegexNode): String {
          return regexToString(r);
        }
        var inner = base.items.join("", rec);
        return "(${inner})";
      }
    }
    is Special -> do {
      if (base == Begin) {
        return "^";
      } else if (base == Dot) { 
        return ".";
      } else if (base == End) {
        return "$";
      } else if (base == WordBoundary) { 
        return "\\b";
      } else if (base == Digit) {
        return "\\d";
      } else if(base == Space) {
        return "\\s";
      } else if (base == Word) {
        return "\\w";
      } else {
        return bubble();
      }
    }
    else -> return bubble();
  }
}

export let ord(s: String): Int {
  return s.codeAt(String.start);
}

export let chr(i: Int): String {
  return String.fromCodePoint(i);
}

export let slice(s: String, start: Int, end: Int): String {
  var p = String.start;
  for (var i = 0; i < start; i++) {
    p = s.next(p);
  }
  let r = new ListBuilder<Int>();
  for (var i = start; i < end; i++) {
    r.add(s.codeAt(p));
    p = s.next(p);
  }
  return r.join("", chr);
}
